//@version=6
indicator("SVP+ICT+VWAP+CVD", overlay=true,
     dynamic_requests=true,
     max_bars_back=3500, max_lines_count=500, max_labels_count=500, max_polylines_count=100,
     max_boxes_count=120)
const string MARKET_PRESET_GROUP = "00 市场 - 自适应"
const string RANGE_GROUP        = "01 SVP - 周期"
const string PRECISION_GROUP    = "01 SVP - 精度/性能"
const string APPEARANCE_GROUP   = "01 SVP - 分布图外观"
const string VP_ELEMENTS_GROUP  = "01 SVP - POC/VA/nPOC"
const string ICT_STYLE_GROUP    = "02 ICT - 会话/扫线"
const string SESSIONS_GROUP     = "02 ICT - 时间/日周池"
const string KILLZONE_GROUP     = "02 ICT - KillZone开盘窗口"
const string VWAP_GROUP         = "03 VWAP - 会话均价"
const string MTF_VWAP_GROUP     = "03 VWAP - 周/月均价"
const string DO_GROUP           = "03 VWAP - 日线开盘价"
const string EMA_GROUP          = "04 EMA - 趋势过滤"
const string CVD_GROUP          = "05 CVD - 主动买卖确认"
const string SMT_GROUP          = "05 CVD - SMT跨品种背离"
const string DMI_GROUP          = "06 执行 - 计划门槛"
const string ACTION_PANEL_GROUP  = "06 执行 - 行动格外观"
const string PRO_GROUP          = "07 风控/提醒/性能"

const string SUB_INDICATOR_GROUP = "08 副指标 - OI/协同"
const string ADR_GROUP          = "09 ADR - 日内幅度"
string MARKET_PRESET = input.string("自动", "市场预设", options=["自动", "贵金属", "外汇", "加密", "股票", "期权标的", "期货", "指数", "通用"], tooltip="自动会根据 syminfo.type...", group=MARKET_PRESET_GROUP)
bool AUTO_WEIGHT_BY_MARKET = input.bool(true, "按市场自动调整评分权重", group=MARKET_PRESET_GROUP)
// 20260809 增强：高级参数灰化开关——勾选后显示 DMI/风控等微调参数，默认隐藏减负
bool SHOW_ADVANCED = input.bool(false, "显示高级微调参数", group=DMI_GROUP, tooltip="开启后显示 DMI 自定义参数、风控阈值等高级微调项。默认关闭让输入面板更清爽。")
bool   AUTO_PROFILE_TF       = input.bool(true, "自动匹配分布图周期", group=RANGE_GROUP)
string MANUAL_PROFILE_TF     = input.timeframe("D", "手动设置分布图周期", group=RANGE_GROUP)
bool   USE_PRECISION         = input.bool(true, "启用高精度计算 (lower TF)", group=PRECISION_GROUP)
bool   AUTO_PRECISION        = input.bool(true, "自动精度模式", group=PRECISION_GROUP)
string MANUAL_PRECISION_TF   = input.timeframe("5", "手动精度周期", group=PRECISION_GROUP)
bool   AUTO_DEGRADE_PRECISION = input.bool(true, "自动降级以防卡顿", group=PRECISION_GROUP)
int    DEGRADE_THRESHOLD      = input.int(220000, "降级阈值 (估算计算量)", minval=50000, maxval=2000000, group=PRECISION_GROUP)
int    NUM_ROWS                 = input.int(50, "分布图行数", minval=10, maxval=300, group=APPEARANCE_GROUP)
int    MAX_WIDTH                = input.int(30, "分布图宽度 %", maxval=100, minval=5, step=5, group=APPEARANCE_GROUP)
int    HEIGHT_PERCENTAGE_PER_ROW = input.int(68, "行高填充 %", minval=1, maxval=100, group=APPEARANCE_GROUP)
int    VALUE_AREA_THRESHOLD      = input.int(70, "价值区域 (VA) %", minval=1, maxval=100, group=APPEARANCE_GROUP)
int VP_MIN_TICK_MULT = input.int(20, "SVP 最小桶宽 (mintick倍数)", minval=1, maxval=500, group=APPEARANCE_GROUP)
color VP_LABEL_BG_COLOR = input.color(#FFFFFF, "VP 标签背景色", group=APPEARANCE_GROUP)
int    VP_LABEL_BG_TRANS = input.int(50, "VP 标签透明度", minval=0, maxval=100, group=APPEARANCE_GROUP)
string VP_LABEL_SIZE = input.string(size.normal, "VP 左侧标签字体大小",
     options=[size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group=APPEARANCE_GROUP)
color PROFILE_COLOR_LOWER    = input.color(color.new(#787B86, 75), "分布图 (非VA)", group=APPEARANCE_GROUP)
color PROFILE_COLOR_UPPER    = input.color(color.new(#787B86, 75), "", group=APPEARANCE_GROUP)
color VALUE_AREA_COLOR_LOWER = input.color(color.new(#2962FF, 75), "价值区域 (VA)", group=APPEARANCE_GROUP)
color VALUE_AREA_COLOR_UPPER = input.color(color.new(#2962FF, 75), "", group=APPEARANCE_GROUP)
bool SHOW_PROFILE_HIST   = input.bool(true,  "显示分布图直方图", group=VP_ELEMENTS_GROUP)
bool SHOW_POC            = input.bool(true,  "显示 POC", group=VP_ELEMENTS_GROUP)
bool SHOW_NPOC           = input.bool(true,  "显示限时未测试POC (nPOC)", tooltip="从已完成SVP的POC原点向右延伸；触碰后立即停止，H1+可隐藏。", group=VP_ELEMENTS_GROUP)
int  NPOC_LIMIT          = input.int(3, "nPOC最多保留数", minval=1, maxval=20, group=VP_ELEMENTS_GROUP)
int  NPOC_EXPIRE_BARS    = input.int(200, "nPOC过期K数", minval=1, maxval=2000, group=VP_ELEMENTS_GROUP, tooltip="超过指定K数后自动删除，不无限延长。")
bool SHOW_VAH_VAL        = input.bool(true,  "显示 VAH/VAL (标签)", group=VP_ELEMENTS_GROUP)
bool SHOW_VAH_VAL_LINES  = input.bool(false, "显示 VAH/VAL 线条", tooltip="关闭后不显示VAH/VAL线条；右侧价格轴仍...", group=VP_ELEMENTS_GROUP)
bool EXTEND_POC          = input.bool(true,  "延长活跃 POC 线", group=VP_ELEMENTS_GROUP)
bool SHOW_PRICE_LABELS   = input.bool(true,  "标签显示价格数值", group=VP_ELEMENTS_GROUP)
bool SHOW_ACTIVE_VP_LABELS = input.bool(false, "显示当前SVP左侧POC/VAH/VAL标签", tooltip="关闭后只隐藏当前活跃SVP左侧标签；右侧价格...", group=VP_ELEMENTS_GROUP)
bool SHOW_RIGHT_PRICE_AXIS = input.bool(true, "右侧价格轴显示结构线价格", group=VP_ELEMENTS_GROUP)
bool SHOW_AXIS_VP_LEVELS  = input.bool(true, "轴标: POC/VAH/VAL/nPOC", group=VP_ELEMENTS_GROUP)
bool SHOW_AXIS_DO_LEVEL   = input.bool(true, "轴标: 日线开盘价", group=VP_ELEMENTS_GROUP)
bool SHOW_AXIS_VWAP_LEVELS = input.bool(true, "轴标: 周/月 VWAP", group=VP_ELEMENTS_GROUP)
bool SHOW_BACKGROUND     = input.bool(true,  "显示 VA 背景色", group=VP_ELEMENTS_GROUP)
bool RENDER_COMPLETED_PROFILE = input.bool(true, "显示最近已完成 SVP", tooltip="开启后保留最近几个已完成周期的 SVP...", group=VP_ELEMENTS_GROUP)
int  COMPLETED_PROFILE_LIMIT = input.int(1, "最近已完成 SVP 数量", minval=1, maxval=5, group=VP_ELEMENTS_GROUP)
color POC_COLOR        = input.color(#0F0F0F, "POC 颜色", inline="poc_col", group=VP_ELEMENTS_GROUP)
string POC_STYLE_IN    = input.string("Solid", "线型", options=["Solid", "Dashed", "Dotted"], inline="poc_col", group=VP_ELEMENTS_GROUP)
int    POC_WIDTH       = input.int(2, "线宽", minval=1, maxval=5, inline="poc_col", group=VP_ELEMENTS_GROUP)
color NPOC_COLOR       = input.color(#787B86, "nPOC 颜色", inline="npoc_col", group=VP_ELEMENTS_GROUP)
string NPOC_STYLE_IN   = input.string("Dashed", "nPOC线型", options=["Solid", "Dashed", "Dotted"], inline="npoc_col", group=VP_ELEMENTS_GROUP)
int    NPOC_WIDTH      = input.int(2, "线宽", minval=1, maxval=5, inline="npoc_col", group=VP_ELEMENTS_GROUP)
color VAH_COLOR        = input.color(#2962FF, "VAH 颜色", inline="vah_col", group=VP_ELEMENTS_GROUP)
color VAL_COLOR        = input.color(#2962FF, "VAL 颜色", inline="val_col", group=VP_ELEMENTS_GROUP)
string VAHVAL_STYLE_IN = input.string("Solid", "VAH/VAL 线型", options=["Solid", "Dashed", "Dotted"], group=VP_ELEMENTS_GROUP)
int    VAHVAL_WIDTH    = input.int(1, "VAH/VAL 线宽", minval=1, maxval=5, group=VP_ELEMENTS_GROUP)
color BACKGROUND_COLOR = input.color(#2962FF0D, "VA 背景填充色", group=VP_ELEMENTS_GROUP)
bool   SHOW_ICT_LEVELS         = input.bool(true, "显示 ICT 关键位", group=ICT_STYLE_GROUP)
bool   SHOW_OPEN_ONLY_ACTIVE   = input.bool(true, "活跃会话仅显示开盘价", group=ICT_STYLE_GROUP)
bool   HIDE_SWEEPS_ON_HTF      = input.bool(true, "H1+周期隐藏已扫掠线", group=ICT_STYLE_GROUP)
string SWEEP_MARK_MODE         = input.string("收盘即扫", "扫线变虚时机", options=["触碰即扫", "收盘即扫", "收回确认"], tooltip="控制线条何时由实线转虚线(=已扫)。触碰即扫...", group=ICT_STYLE_GROUP)
int    ICT_LINE_WIDTH          = input.int(1, "线条宽度", minval=1, maxval=5, group=ICT_STYLE_GROUP)
string ICT_UNSWEPT_LABEL_SIZE  = input.string(size.small, "未扫标签大小",
     options=[size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group=ICT_STYLE_GROUP)
string ICT_SWEPT_LABEL_SIZE    = input.string(size.small, "已扫标签大小",
     options=[size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group=ICT_STYLE_GROUP)
int    ICT_BG_TRANSPARENCY     = input.int(80, "会话背景透明度(更淡)", minval=0, maxval=100, group=ICT_STYLE_GROUP)
bool   SHOW_FVG          = input.bool(true, "FVG缺口(确认汇合)", group=ICT_STYLE_GROUP, tooltip="ICT三K失衡区。价格回踩进未填补的同向FV...")
bool   FVG_DRAW_BOXES    = input.bool(true, "在图上画FVG框", group=ICT_STYLE_GROUP, tooltip="只想要确认行的FVG✓信号、不想图上有框，就...")
bool   FVG_HTF_ALIGN     = input.bool(true, "只留顺高周期偏向的FVG", group=ICT_STYLE_GROUP, tooltip="只保留与HTF趋势同向的缺口(看涨FVG须H...")
bool   FVG_SHOW_CE       = input.bool(true, "画FVG中线(CE 50%)", group=ICT_STYLE_GROUP, tooltip="ICT公允价值缺口的50%中点(Conseq...")
float  FVG_NEAR_ATR      = input.float(4.0, "只画离价N倍ATR内的FVG", minval=0, step=0.5, group=ICT_STYLE_GROUP, tooltip="远离现价的旧缺口自动隐藏，只留价格可能回踩到...")
bool   FVG_REQUIRE_DISP  = input.bool(true, "FVG须由位移K形成", group=ICT_STYLE_GROUP, tooltip="只保留中间K为带量大实体(机构脚印/位移)的...")
int    FVG_MAX_COUNT     = input.int(5,  "FVG最多显示个数", minval=1, maxval=20, group=ICT_STYLE_GROUP, tooltip="按动态质量分保留最高质量区域，默认最多5个。")
bool   FVG_NEAREST_ONLY  = input.bool(false, "只显示最近有效FVG", group=ICT_STYLE_GROUP, tooltip="默认关闭：显示质量排名保留下来的FVG；开启后每个方向只显示离现价最近的一处。")
int    FVG_EXPIRE_BARS   = input.int(80, "FVG过期K数(0=不过期)", minval=0, maxval=500, group=ICT_STYLE_GROUP, tooltip="超过指定K数仍未回补的旧FVG自动清理。社区...")
int    FVG_EXTEND        = input.int(1, "FVG向右延伸K数", minval=0, maxval=100, group=ICT_STYLE_GROUP)
color  FVG_BULL_COL      = input.color(#26C281, "FVG看涨色", group=ICT_STYLE_GROUP)
color  FVG_BEAR_COL      = input.color(#F23645, "FVG看跌色", group=ICT_STYLE_GROUP)
int    FVG_FILL_TRANSP   = input.int(88, "FVG填充透明度", minval=0, maxval=100, group=ICT_STYLE_GROUP)
string ZONE_LABEL_SIZE    = input.string(size.small, "区域标签字号（FVG/OB/BRK/LV）", options=[size.tiny, size.small, size.normal, size.large, size.huge], group=ICT_STYLE_GROUP, tooltip="FVG/OB标签固定在框内右下角。")
bool   SHOW_HTF_FVG      = input.bool(true, "高周期FVG确认本级", group=ICT_STYLE_GROUP, tooltip="不在低周期图上画高周期框，而是用高周期FVG...")
string FVG_HTF           = input.string("自动", "高周期确认周期", options=["自动","60","240","D","W"], group=ICT_STYLE_GROUP, tooltip="用哪一级周期的FVG来确认本级。自动=跟随指...")
color ICT_LABEL_BG_COLOR = input.color(#FFFFFF, "标签背景颜色", group=ICT_STYLE_GROUP)
const string OB_GROUP         = "02 ICT - OrderBlock/结构"
bool   SHOW_OB            = input.bool(true,  "显示 Order Block", group=OB_GROUP)
bool   SHOW_HTF_OB        = input.bool(true,  "高周期OB确认本级", group=OB_GROUP, tooltip="同FVG高周期确认:本级OB与同向HTF...")
bool   SHOW_BREAKER       = input.bool(true,  "显示 Breaker Block", group=OB_GROUP)
bool   ENABLE_STRUCTURE_ENGINE = input.bool(true, "启用BOS/CHoCH与OB结构引擎", group=OB_GROUP, tooltip="关闭会停用BOS/CHoCH计算及OB生成，不只是隐藏文字。")
bool   SHOW_BOS_CHOCH_TEXT = input.bool(true, "行动格显示BOS/CHoCH", group=OB_GROUP)
bool   SHOW_LIQ_VOID      = input.bool(false, "Show Liquidity Void (LV)", group=OB_GROUP, tooltip="默认关：LV对快进快出噪声大、决策增益低。需...")
int    OB_LOOKBACK        = input.int(20,  "OB/BOS swing回看K数", minval=5, maxval=200, group=OB_GROUP)
int    OB_MAX_COUNT       = input.int(5,   "OB最多显示个数", minval=1, maxval=20, group=OB_GROUP, tooltip="按动态质量分保留最高质量区域，默认最多5个。")
int    OB_EXTEND          = input.int(1,   "OB向右延伸K数", minval=0, maxval=100, group=OB_GROUP, tooltip="与FVG一致，默认向右延伸1根K。")
int    OB_EXPIRE_BARS     = input.int(200, "OB过期K数(0=不过期)", minval=0, maxval=1000, group=OB_GROUP)
color  OB_BULL_COL        = input.color(#009688, "看涨OB色", group=OB_GROUP)
color  OB_BEAR_COL        = input.color(#E91E63, "看跌OB色", group=OB_GROUP)
color  BRK_BULL_COL       = input.color(#00BCD4, "看涨Breaker色", group=OB_GROUP)
color  BRK_BEAR_COL       = input.color(#FF5722, "看跌Breaker色", group=OB_GROUP)
color  LV_COL             = input.color(#FFC107, "Liquidity Void色", group=OB_GROUP)
int    OB_FILL_TRANSP     = input.int(85, "OB填充透明度", minval=0, maxval=100, group=OB_GROUP)
bool   SHOW_ZONE_LABELS   = input.bool(true,  "Show zone text labels", group=OB_GROUP, tooltip="总开关：FVG/OB 框角文字。关掉只留色块。")
bool   SHOW_FVG_LABELS    = input.bool(true,  "FVG labels", group=OB_GROUP, tooltip="建议保留：进场CE/回踩最有用。")
bool   SHOW_OB_LABELS     = input.bool(true,  "OB labels", group=OB_GROUP, tooltip="建议保留未扫OB；已扫自动隐藏文字。")
bool   LABEL_BREAKER_AS_OB = input.bool(true, "Breaker still show as OB text", group=OB_GROUP, tooltip="默认开：Breaker只变色，文字仍写OB，...")
bool   REMOVE_MITIGATED_OB = input.bool(true, "删除已扫/已缓解 OB 框", group=OB_GROUP, tooltip="默认开：OB被触碰缓解后直接删框+字，图上只...")
int    ICT_LABEL_BG_TRANS = input.int(50, "标签背景透明度", minval=0, maxval=100, group=ICT_STYLE_GROUP)
color COLOR_ASIA   = input.color(#FFC107, "亚洲盘颜色", group=ICT_STYLE_GROUP)
color COLOR_LONDON = input.color(#089981,  "伦敦盘颜色", group=ICT_STYLE_GROUP)
color COLOR_NY     = input.color(#F23645,    "纽约盘颜色", group=ICT_STYLE_GROUP)
color COLOR_LONDON_NY_OVERLAP = input.color(#9C27B0, "伦敦纽约重叠颜色", group=ICT_STYLE_GROUP)
color COLOR_ASIA_LONDON_OVERLAP = input.color(#00ff6a, "亚洲伦敦重叠颜色", group=ICT_STYLE_GROUP)
bool  SHOW_VWAP             = input.bool(true, "显示 S VWAP", group=VWAP_GROUP)
string S_VWAP_ANCHOR        = input.string("自动", "S VWAP 锚定规则", options=["自动", "日", "周", "月"], tooltip="使用参考版 SVWAP 效果：1小时以下=日...", group=VWAP_GROUP)
color VWAP_COLOR            = input.color(#1E88E5, "S VWAP 颜色", group=VWAP_GROUP)
bool  SHOW_VWAP_BANDS       = input.bool(true, "显示 S VWAP ±1σ 带", group=VWAP_GROUP, tooltip="默认只画±1σ价值区边界。趋势回踩±1σ；震...")
float VWAP_SD_MULT_1        = input.float(1.0, "Band 1 (内) 倍数", step=0.1, group=VWAP_GROUP)

bool  SHOW_WEEKLY_VWAP   = input.bool(true, "显示周 VWAP", group=MTF_VWAP_GROUP)
bool  SHOW_MONTHLY_VWAP  = input.bool(true, "显示月 VWAP", group=MTF_VWAP_GROUP)
bool  SMART_HIDE_VWAP    = input.bool(true, "🔥 智能隐藏图表连线", tooltip="如果周/月 VWAP 距离当前价格超过 N ...", group=MTF_VWAP_GROUP)
// 20260810 按用户要求：周/月 VWAP 过滤阈值 8→5 ATR（更早隐藏远离价格的周/月线，图上更干净）
float VWAP_ATR_MULT      = input.float(5.0, "过滤阈值 (ATR倍数)", minval=1.0, step=0.5, group=MTF_VWAP_GROUP)
color WEEKLY_VWAP_COLOR  = input.color(#FF00FF, "周 VWAP 颜色", group=MTF_VWAP_GROUP)
color MONTHLY_VWAP_COLOR = input.color(#FF9800, "月 VWAP 颜色", group=MTF_VWAP_GROUP)
bool   SHOW_DO_LINE        = input.bool(true, "显示日线开盘价线条 (DO)", group=DO_GROUP)
color  DO_COLOR            = input.color(#673AB7, "DO 颜色", group=DO_GROUP)
int    DO_WIDTH            = input.int(1, "DO 线宽", minval=1, maxval=5, group=DO_GROUP)
string DO_STYLE_IN         = input.string("Dashed", "DO 线型", options=["Solid", "Dashed", "Dotted"], group=DO_GROUP)
bool  SHOW_EMA_FILTER = input.bool(true, "启用 EMA 趋势过滤", group=EMA_GROUP)
int   EMA_LEN_1 = input.int(9,  "EMA周期1（快速）", minval=1, maxval=500, inline="emalen12", group=EMA_GROUP, tooltip="建议四个周期保持从小到大。修改后主图云、趋势判断与高周期过滤同步更新。")
int   EMA_LEN_2 = input.int(21, "EMA周期2（确认）", minval=1, maxval=500, inline="emalen12", group=EMA_GROUP)
int   EMA_LEN_3 = input.int(34, "EMA周期3（结构）", minval=1, maxval=500, inline="emalen34", group=EMA_GROUP)
int   EMA_LEN_4 = input.int(55, "EMA周期4（慢速）", minval=1, maxval=500, inline="emalen34", group=EMA_GROUP)
bool  SHOW_EMA_12_CLOUD = input.bool(true, "显示快速趋势云（周期1/2）", group=EMA_GROUP)
bool  SHOW_EMA_34_CLOUD = input.bool(true, "显示慢速趋势云（周期3/4）", group=EMA_GROUP)
color EMA_12_CLOUD_BULL = input.color(color.new(#00FF6A, 60), "快速云多头填充", inline="ema12cloud", group=EMA_GROUP)
color EMA_12_CLOUD_BEAR = input.color(color.new(#E91E63, 60), "快速云空头填充", inline="ema12cloud", group=EMA_GROUP)
color EMA_34_CLOUD_BULL = input.color(color.new(#2962FF, 75), "慢速云多头填充", inline="ema34cloud", group=EMA_GROUP)
color EMA_34_CLOUD_BEAR = input.color(color.new(#B71C1C, 75), "慢速云空头填充", inline="ema34cloud", group=EMA_GROUP)
string MARKET_MODE       = input.string("自动", "会话周末模式", options=["自动", "Crypto (7x24)", "Forex/Stock (No Weekend)"], tooltip="通常保持自动。加密7x24不过滤周末；外汇/...", group=SESSIONS_GROUP)
int    ICT_LOOKBACK_DAYS = input.int(1, "回溯天数", minval=1, maxval=5, group=SESSIONS_GROUP)
bool   SHOW_ASIA   = input.bool(true, "亚洲盘", inline="asia", group=SESSIONS_GROUP)
string TIME_ASIA   = input.session("0800-1600", "亚洲时段", inline="asia", tooltip="上海时间08:00-16:00=UTC...", group=SESSIONS_GROUP)
string TZ_ASIA     = input.string("Asia/Shanghai", "亚洲时区", options=["Asia/Shanghai", "Asia/Tokyo", "UTC"], group=SESSIONS_GROUP)
bool   SHOW_LONDON = input.bool(true, "伦敦盘", inline="london", group=SESSIONS_GROUP)
