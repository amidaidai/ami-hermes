            if fvgHtfValid and array.size(htfFvgList) > 0
                for gj = 0 to array.size(htfFvgList) - 1
                    FVG hz = array.get(htfFvgList, gj)
                    if lvlC.price <= hz.top and lvlC.price >= hz.bot
                        mHtfConf := true
                        break
            if mHtfConf
                totalScore += 20
            if d < minDist
                minDist := d
                magnetNearestName := lvlC.name
                magnetNearestPrice := lvlC.price
                magnetScore := int(math.round(math.min(totalScore, 100)))
            if lvlC.price > magnetReferencePrice and totalScore > bestAboveScore
                bestAboveScore := totalScore
                magnetAboveScore := int(math.round(math.min(totalScore, 100)))
                magnetAboveName := lvlC.name
                magnetAbovePrice := lvlC.price
                magnetAboveHtf := mHtfConf
            if lvlC.price < magnetReferencePrice and totalScore > bestBelowScore
                bestBelowScore := totalScore
                magnetBelowScore := int(math.round(math.min(totalScore, 100)))
                magnetBelowName := lvlC.name
                magnetBelowPrice := lvlC.price
                magnetBelowHtf := mHtfConf
if array.size(npocList) > 0 and currATR > 0
    for ni = 0 to array.size(npocList) - 1
        NakedPOC npMag = array.get(npocList, ni)
        if not npMag.swept and not npMag.hidden and bar_index - npMag.createdBar <= NPOC_EXPIRE_BARS
            float npDist = math.abs(magnetReferencePrice - npMag.price)
            float npScore = math.max(0.0, 85.0 - npDist / currATR * 15.0)
            if npMag.price > magnetReferencePrice and npScore > bestAboveScore
                bestAboveScore := npScore
                magnetAboveScore := int(math.round(npScore))
                magnetAboveName := "nPOC"
                magnetAbovePrice := npMag.price
                magnetAboveHtf := timeframe.in_seconds() >= 3600
            if npMag.price < magnetReferencePrice and npScore > bestBelowScore
                bestBelowScore := npScore
                magnetBelowScore := int(math.round(npScore))
                magnetBelowName := "nPOC"
                magnetBelowPrice := npMag.price
                magnetBelowHtf := timeframe.in_seconds() >= 3600
float magnetTargetPrice = planSideLong ? magnetAbovePrice : planSideShort ? magnetBelowPrice : magnetNearestPrice
string magnetTargetName = planSideLong ? magnetAboveName : planSideShort ? magnetBelowName : magnetNearestName
int magnetTargetScore = planSideLong ? magnetAboveScore : planSideShort ? magnetBelowScore : magnetScore
string magnetDir = not na(magnetTargetPrice) ? (magnetTargetPrice > magnetAnchorPrice ? "↑" : "↓") : ""
string magnetTargetText = not na(magnetTargetPrice) ? magnetDir + magnetTargetName + " " + str.tostring(magnetTargetPrice, format.mintick) : ""
bool mssLongEvent = mssLongOk and not mssLongOk[1]
bool mssShortEvent = mssShortOk and not mssShortOk[1]
bool bullFvgEntryEvent = bullFvgTradeOk and not bullFvgTradeOk[1]
bool bearFvgEntryEvent = bearFvgTradeOk and not bearFvgTradeOk[1]
bool bullObEntryEvent = bullObTradeOk and not bullObTradeOk[1]
bool bearObEntryEvent = bearObTradeOk and not bearObTradeOk[1]
bool cvdLongEvent = (cvdAbsorbBuyQualified or cvdBullDivQualified) and not (cvdAbsorbBuyQualified[1] or cvdBullDivQualified[1])
bool cvdShortEvent = (cvdDistributeSellQualified or cvdBearDivQualified) and not (cvdDistributeSellQualified[1] or cvdBearDivQualified[1])
bool acceptLongEvent = acceptanceBullOk and not acceptanceBullOk[1]
bool acceptShortEvent = acceptanceBearOk and not acceptanceBearOk[1]
int mssLongAge = ta.barssince(mssLongEvent)
int mssShortAge = ta.barssince(mssShortEvent)
int bullFvgAge = ta.barssince(bullFvgEntryEvent)
int bearFvgAge = ta.barssince(bearFvgEntryEvent)
int bullObAge = ta.barssince(bullObEntryEvent)
int bearObAge = ta.barssince(bearObEntryEvent)
int cvdLongAge = ta.barssince(cvdLongEvent)
int cvdShortAge = ta.barssince(cvdShortEvent)
int acceptLongAge = ta.barssince(acceptLongEvent)
int acceptShortAge = ta.barssince(acceptShortEvent)
int triggerCode = planSideLong ? (sweptLowReclaimed ? 1 : mssLongOk ? 2 : bullFvgTradeOk ? 3 : bullObTradeOk ? 4 : cvdAbsorbBuyQualified or cvdBullDivQualified ? 5 : acceptanceBullOk ? 6 : dispLongOk ? 7 : 0) : planSideShort ? (sweptHighRejected ? -1 : mssShortOk ? -2 : bearFvgTradeOk ? -3 : bearObTradeOk ? -4 : cvdDistributeSellQualified or cvdBearDivQualified ? -5 : acceptanceBearOk ? -6 : dispShortOk ? -7 : 0) : 0
int triggerAge = triggerCode == 1 or triggerCode == -1 ? 0 : triggerCode == 2 ? nz(mssLongAge, 999) : triggerCode == -2 ? nz(mssShortAge, 999) : triggerCode == 3 ? nz(bullFvgAge, 999) : triggerCode == -3 ? nz(bearFvgAge, 999) : triggerCode == 4 ? nz(bullObAge, 999) : triggerCode == -4 ? nz(bearObAge, 999) : triggerCode == 5 ? nz(cvdLongAge, 999) : triggerCode == -5 ? nz(cvdShortAge, 999) : triggerCode == 6 ? nz(acceptLongAge, 999) : triggerCode == -6 ? nz(acceptShortAge, 999) : triggerCode == 7 ? nz(barsSinceDispUp, 999) : triggerCode == -7 ? nz(barsSinceDispDn, 999) : 999
int triggerMaxAge = curTfSec <= 300 ? 6 : curTfSec <= 900 ? 4 : 3
bool triggerFresh = triggerCode != 0 and triggerAge <= triggerMaxAge
string activeTriggerText = triggerCode == 1 ? "扫低收回" : triggerCode == -1 ? "扫高拒绝" : triggerCode == 2 ? "MSS↑" : triggerCode == -2 ? "MSS↓" : triggerCode == 3 ? "FVG承接" : triggerCode == -3 ? "FVG承压" : triggerCode == 4 ? "OB承接" : triggerCode == -4 ? "OB承压" : triggerCode == 5 ? "CVD吸收" : triggerCode == -5 ? "CVD派发" : triggerCode == 6 ? "站回价值区" : triggerCode == -6 ? "跌回价值区" : triggerCode == 7 ? "位移↑" : triggerCode == -7 ? "位移↓" : ""
string expectedTriggerPath = "观望 等方向明确"
if planSideLong
    expectedTriggerPath := sweptLowReclaimed ? "已扫低→等MSS↑" : inBullFvg ? "FVG承接→位移↑" : inBullOB or inBullBreaker ? "OB承接→MSS↑" : cvdAbsorbBuyQualified or cvdBullDivQualified ? "CVD吸收→MSS↑" : nearS or f_near_level(curVal, effAKeyLevelAtr) ? "站回VWAP/VAL→MSS↑" : nearAKeyLiquidity ? "扫低收回→MSS↑" : "位移↑→FVG回踩"
else if planSideShort
    expectedTriggerPath := sweptHighRejected ? "已扫高→等MSS↓" : inBearFvg ? "FVG承压→位移↓" : inBearOB or inBearBreaker ? "OB承压→MSS↓" : cvdDistributeSellQualified or cvdBearDivQualified ? "CVD派发→MSS↓" : nearS or f_near_level(curVah, effAKeyLevelAtr) ? "跌回VWAP/VAH→MSS↓" : nearAKeyLiquidity ? "扫高拒绝→MSS↓" : "位移↓→FVG反抽"
// 20260810 路径与结构+高周一致：无计划时按结构方向×高周方向给路径——同向给顺势路径、逆向给"等高周转同"路径（原只按趋势分，
// 高周偏空时仍显示"趋势偏多 等回踩"，与 htfAllowLong 闸门矛盾）；结构/高周均待时退回趋势分分支
else if structureBias > 0 and htfBullConfirmed
    expectedTriggerPath := "结构高周同多 等回踩→MSS↑"
else if structureBias < 0 and htfBearConfirmed
    expectedTriggerPath := "结构高周同空 等反抽→MSS↓"
else if structureBias > 0 and htfBearConfirmed
    expectedTriggerPath := "结构多·高周空 等高周转多再回踩"
else if structureBias < 0 and htfBullConfirmed
    expectedTriggerPath := "结构空·高周多 等高周转空再反抽"
else if structureBias > 0
    expectedTriggerPath := "结构多·高周待 等高周确认→回踩"
else if structureBias < 0
    expectedTriggerPath := "结构空·高周待 等高周确认→反抽"
else if htfBullConfirmed
    expectedTriggerPath := "高周多·结构待 等结构转多→回踩"
else if htfBearConfirmed
    expectedTriggerPath := "高周空·结构待 等结构转空→反抽"
else if trendLongScore >= trendShortScore + 2
    expectedTriggerPath := adrExhausted ? "趋势偏多·ADR耗尽 等回踩" : "趋势偏多 等回踩→MSS↑"
else if trendShortScore >= trendLongScore + 2
    expectedTriggerPath := adrExhausted ? "趋势偏空·ADR耗尽 等反抽" : "趋势偏空 等反抽→MSS↓"
else if priceInVA
    expectedTriggerPath := "价在价值区 等出区→扫位/位移"
else if dmiTrendWeak
    expectedTriggerPath := "DMI走弱 等趋势重启"
else
    expectedTriggerPath := "观望 等扫位/关键位反应"
float finalStopCandidate = planSideLong ? (na(longInvalidRaw) or currATR <= 0 or na(finalEntryCandidate) ? longInvalidRaw : math.min(longInvalidRaw, finalEntryCandidate - currATR * effAtrStopMult)) : planSideShort ? (na(shortInvalidRaw) or currATR <= 0 or na(finalEntryCandidate) ? shortInvalidRaw : math.max(shortInvalidRaw, finalEntryCandidate + currATR * effAtrStopMult)) : na
bool priceGeometryOk = planSideLong ? (not na(finalEntryCandidate) and not na(finalStopCandidate) and not na(magnetTargetPrice) and finalStopCandidate < finalEntryCandidate and magnetTargetPrice > finalEntryCandidate) : planSideShort ? (not na(finalEntryCandidate) and not na(finalStopCandidate) and not na(magnetTargetPrice) and finalStopCandidate > finalEntryCandidate and magnetTargetPrice < finalEntryCandidate) : false
float rrRatio = na
if priceGeometryOk and currATR > 0
    float riskDist = planSideLong ? finalEntryCandidate - finalStopCandidate : finalStopCandidate - finalEntryCandidate
    float rewardDist = planSideLong ? magnetTargetPrice - finalEntryCandidate : finalEntryCandidate - magnetTargetPrice
    rrRatio := riskDist > 0 and rewardDist > 0 ? rewardDist / riskDist : na
string rrText = not na(rrRatio) ? str.tostring(rrRatio, "#.1") + "R" : ""
bool rrHardOk = not na(rrRatio) and rrRatio >= 2.0
bool bcDirectOk = bcDirectRaw and not na(rrRatio) and rrRatio >= 1.5
bool manualBcCandidate = bcDirectRaw and priceGeometryOk and not setupX
bool executablePlanBase = ((displayLongA or displayShortA) and rrHardOk) or bcDirectOk
bool executablePlan = not setupX and executablePlanBase and triggerFresh and barstate.isconfirmed
bool visiblePlan = executablePlan or manualBcCandidate
float replayPlanPrice = visiblePlan ? finalEntryCandidate : na
float replayInvalidPrice = visiblePlan ? finalStopCandidate : na
float replayTargetPrice = visiblePlan ? magnetTargetPrice : na
float replayStopDistance = visiblePlan ? math.abs(replayPlanPrice - replayInvalidPrice) : na
float replayStopAtr = not na(replayStopDistance) and currATR > 0 ? replayStopDistance / currATR : na
float candidateStopAtr = not na(finalEntryCandidate) and not na(finalStopCandidate) and currATR > 0 ? math.abs(finalEntryCandidate - finalStopCandidate) / currATR : na
bool rrHardBlock = (displayLongA or displayShortA) and not rrHardOk
int entryValidCode = setupX ? -3 : not (planSideLong or planSideShort) ? 0 : not priceGeometryOk ? -2 : not rrHardOk and not bcDirectOk and not manualBcCandidate ? -1 : not barstate.isconfirmed or not triggerFresh ? 1 : executablePlan and (displayLongA or displayShortA) ? 3 : executablePlan ? 2 : 1
int signalStateCode = setupX ? -2 : not (planSideLong or planSideShort) ? 0 : not priceGeometryOk ? -1 : not triggerFresh ? 4 : not barstate.isconfirmed ? 1 : executablePlan ? 3 : 2
int noTradeReasonCode = (xHtfConflict ? 1 : 0) + (xHotExtended ? 2 : 0) + ((lowLiquiditySession or lowLiquidityAsset) ? 4 : 0) + ((planSideLong or planSideShort) and not priceGeometryOk ? 8 : 0) + ((planSideLong or planSideShort) and not rrHardOk and not bcDirectOk ? 16 : 0) + (SHOW_CVD_CONFIRM and not cvdQualityOk ? 32 : 0) + (adrChaseBlock ? 64 : 0) + ((planSideLong and not pdAllowLong) or (planSideShort and not pdAllowShort) ? 128 : 0) + ((planSideLong or planSideShort) and not barstate.isconfirmed ? 256 : 0) + ((planSideLong or planSideShort) and not triggerFresh ? 512 : 0)
string stopPriceText = not na(replayInvalidPrice) ? str.tostring(replayInvalidPrice, format.mintick) : ""
string entryPriceText = not na(replayPlanPrice) ? str.tostring(replayPlanPrice, format.mintick) : ""
string finalInvalidSpecificText = setupX ? "不进场" : planSideLong ? "多失效 " + f_fmt_price(finalStopCandidate) : planSideShort ? "空失效 " + f_fmt_price(finalStopCandidate) : "等触发后设失效"
int rrScore = na(rrRatio) ? 0 : rrRatio >= 2.0 ? 2 : rrRatio >= 1.5 ? 1 : 0
// 20260809 主副协同：AggVol State Pack(1=支持多 2=支持空 3=冲突 4=降权) 影响确认分
// 20260809 修复：追加 aggStateSource != close 守卫——默认源为 close，低价币(如$3)可能被误判为"冲突/降权"
int aggSyncScore = 0
if SHOW_AGG_SYNC and not na(aggStateSource) and aggStateSource != close
    if (activeLongPlan and aggStateSource == 1) or (activeShortPlan and aggStateSource == 2)
        aggSyncScore := 1
    else if (activeLongPlan and aggStateSource == 2) or (activeShortPlan and aggStateSource == 1)
        aggSyncScore := -2
    else if aggStateSource == 3 or aggStateSource == 4
        aggSyncScore := -1
int setupTotalScore = math.min(math.max(locationScore + confirmScore + rrScore - extensionRiskScore + aggSyncScore, 0), 10)
bool cvdConflictLong = activeLongPlan and (cvdBearDivQualified or cvdDistributeSellQualified)
bool cvdConflictShort = activeShortPlan and (cvdBullDivQualified or cvdAbsorbBuyQualified)
bool smtConflictLong = SHOW_SMT and activeLongPlan and smtBearDiv
bool smtConflictShort = SHOW_SMT and activeShortPlan and smtBullDiv
bool actionWeakened = cvdConflictLong or cvdConflictShort or smtConflictLong or smtConflictShort
string cvdAnchorLabel = cvdAnchorTf == "D" ? "日" : cvdAnchorTf == "W" ? "周" : cvdAnchorTf == "M" ? "月" : cvdAnchorTf
// 20260808 审计修复（P2）：删除会话主导死链（cvdLeadSession/cvdLeadSlope/cvdSessionSuffix）——
// 20260807 已删展示但忘了删计算，每根 K 白算 6 个变量。
// 贵金属现货无逐笔成交数据：CVD估算权重已归零，流向行不得再输出买/卖/背离等误导文本
if metalSpot and SHOW_CVD_CONFIRM
    cvdStateText := "现货无逐笔"
string actionCvdText = cvdAnchorLabel + cvdStateText
if cvdAbsorbBuyQualified
    actionCvdText := cvdAnchorLabel + "吸收"
else if cvdDistributeSellQualified
    actionCvdText := cvdAnchorLabel + "派发"
else if cvdBullConfirmQualified
    actionCvdText := cvdAnchorLabel + "买盘"
else if cvdBearConfirmQualified
    actionCvdText := cvdAnchorLabel + "卖盘"
else if cvdBullDivQualified
    actionCvdText := cvdAnchorLabel + "底背离" + (cvdBullStars > 0 ? str.tostring(cvdBullStars) + "★" : "")
else if cvdBearDivQualified
    actionCvdText := cvdAnchorLabel + "顶背离" + (cvdBearStars > 0 ? str.tostring(cvdBearStars) + "★" : "")
// 20260810 审计修复（P1-1 互标）：主指标低周期聚合时标注"·低周期"——副指标流向行恒为 K 线影线估算（文本已带"估"字），两行动格口径一目了然
actionCvdText := actionCvdText + (cvdUseLowerTf ? "·低周期" : "") + cvdRefTag
// 20260807 精简：保留锚定周期+状态+行动词，删会话主导/基差（避免撑宽表格）
// 20260810 审计修复（P1-5）：metalSpot 无逐笔，行动词不输出"买力回升"等误导文本
string cvdActionWord = metalSpot ? "" : cvdBearDivQualified or cvdDistributeSellQualified ? "别追多" : cvdBullDivQualified or cvdAbsorbBuyQualified ? "别追空" : cvdBullConfirmQualified ? "顺多" : cvdBearConfirmQualified ? "顺空" : cvdRising ? "买力回升" : cvdFalling ? "卖力回落" : "中性"
actionCvdText := actionCvdText + (cvdActionWord != "" ? "·" + cvdActionWord : "")
string actionStateText = "观望"
if lowLiquiditySession
    actionStateText := "X 低流动"
else if (activeLongPlan or activeShortPlan) and not barstate.isconfirmed
    actionStateText := "○ 盘中候选 等收线"
else if (activeLongPlan or activeShortPlan) and not triggerFresh
    actionStateText := "○ 触发过期 等新确认"
else if rrHardBlock
    actionStateText := "X R:R不足"
else if setupX
    actionStateText := "X · " + xReasonText
else if adrChaseBlock
    actionStateText := adrChaseBlockLong ? "ADR耗尽 慎追多" : "ADR耗尽 慎追空"
else if cvdConflictLong
    actionStateText := "CVD不配多"
else if cvdConflictShort
    actionStateText := "CVD不配空"
else if displayLongA
    actionStateText := "A多 回踩"
else if displayShortA
    actionStateText := "A空 反抽"
else if setupLongB
    actionStateText := bcDirectOk and bcLongDirectRaw ? "B多 可挂" : "B多 等确认"
else if setupShortB
    actionStateText := bcDirectOk and bcShortDirectRaw ? "B空 可挂" : "B空 等确认"
else if setupLongC
    actionStateText := bcDirectOk and cLongDirectRaw ? "C多 小仓" : "C多 等站回"
else if setupShortC
    actionStateText := bcDirectOk and cShortDirectRaw ? "C空 小仓" : "C空 等跌回"
else if trendLongScore >= trendShortScore + 2
    actionStateText := "等多 回踩"
else if trendShortScore >= trendLongScore + 2
    actionStateText := "等空 反抽"
if xConflict and not CONFLICT_HARD_BLOCK and not (lowLiquiditySession or rrHardBlock or setupX or adrChaseBlock or cvdConflictLong or cvdConflictShort)
    actionStateText := actionStateText + " ⚠冲突"
string lineAction = "不做，等触发"
if lowLiquiditySession
    lineAction := "低流动，等伦敦/纽约"
else if rrHardBlock
    lineAction := "不做，R:R不足2，等更好价"
else if setupX
    lineAction := "不追，等" + watchText
else if adrChaseBlock
    lineAction := "ADR当日空间不足(余" + (adrChaseBlockLong ? str.tostring(adrUpRoomAtr, "#.1") : str.tostring(adrDnRoomAtr, "#.1")) + "ATR)，不追等回踩/反抽"
else if cvdConflictLong or cvdConflictShort
    lineAction := "不追，等CVD配合"
else if displayLongA
    string pricePart = entryPriceText != "" ? "多 " + entryPriceText : "多 " + pullbackLevelText + "等承接"
    string stopPart = stopPriceText != "" ? " · 止" + stopPriceText : ""
    string targetPart = magnetTargetText != "" ? " · 标" + magnetTargetText : ""
    string rrPart = rrText != "" ? "(" + rrText + ")" : ""
    lineAction := pricePart + (entryPriceText != "" ? stopPart + targetPart + rrPart : "") + " · " + longInvalidText
else if displayShortA
    string pricePart = entryPriceText != "" ? "空 " + entryPriceText : "空 " + reboundLevelText + "等承压"
    string stopPart = stopPriceText != "" ? " · 止" + stopPriceText : ""
    string targetPart = magnetTargetText != "" ? " · 标" + magnetTargetText : ""
    string rrPart = rrText != "" ? "(" + rrText + ")" : ""
    lineAction := pricePart + (entryPriceText != "" ? stopPart + targetPart + rrPart : "") + " · " + shortInvalidText
else if setupLongB
    lineAction := bcDirectOk and bcLongDirectRaw ? "B多挂 " + entryPriceText + " · 止" + stopPriceText + " · 标" + magnetTargetText + (rrText != "" ? "(" + rrText + ")" : "") + " · " + longInvalidText : "等回踩" + pullbackLevelText + "确认"
else if setupShortB
    lineAction := bcDirectOk and bcShortDirectRaw ? "B空挂 " + entryPriceText + " · 止" + stopPriceText + " · 标" + magnetTargetText + (rrText != "" ? "(" + rrText + ")" : "") + " · " + shortInvalidText : "等反抽" + reboundLevelText + "确认"
else if setupLongC
    lineAction := bcDirectOk and cLongDirectRaw ? "C多小仓 " + entryPriceText + " · 止" + stopPriceText + " · 标" + magnetTargetText + (rrText != "" ? "(" + rrText + ")" : "") + " · " + longInvalidText : "等站回" + longBreakName + "确认"
else if setupShortC
    lineAction := bcDirectOk and cShortDirectRaw ? "C空小仓 " + entryPriceText + " · 止" + stopPriceText + " · 标" + magnetTargetText + (rrText != "" ? "(" + rrText + ")" : "") + " · " + shortInvalidText : "等跌回" + shortBreakName + "确认"
var string[] pnlLabels = array.new_string()
var string[] pnlValues = array.new_string()
var color[]  pnlValCols = array.new_color()
// 20260808 审计修复（P2）：f_pnl_row 的数组 clear/push 原在每根 K 执行而只在 islast 渲染，
// 加 barstate.islast 门控后数组操作只在最后一根 K 执行（渲染前 clear→push 顺序不变）。
if barstate.islast
    array.clear(pnlLabels)
    array.clear(pnlValues)
    array.clear(pnlValCols)
f_pnl_row(string lab, string val, color vcol) =>
    if barstate.islast
        array.push(pnlLabels, lab)
        array.push(pnlValues, val)
        array.push(pnlValCols, vcol)
// —— 行动格渲染（20260809 封装函数，缓解 CE10295 主脚本体过长）——
// 全部行文本拼装 + f_pnl_row 入列 + table 渲染，独立于主流程，只读全局变量。
// 20260808 审计修复（P2）：regime 状态与行动格区共用同一组全局变量（rAtrBaseA/rExhaustA 等），
// 原两处各算一份 ta.sma(currATR,50)+四组判断，合并为引用同一组（无前向引用）。
float rAtrBaseA = ta.sma(currATR, 50)
float rAtrRatioA = not na(rAtrBaseA) and rAtrBaseA > 0 ? currATR / rAtrBaseA : 1.0
bool  rExhaustA = adrExhausted or (dmiHot and (vwapExtendedUp or vwapExtendedDn))
bool  rExpandA = rAtrRatioA >= 1.25 and volHigh
bool  rContrA = rAtrRatioA <= 0.75 or (not na(sVwapSD) and currATR > 0 and sVwapSD / currATR < 0.45)
bool  rTrendA = dmiAdx >= effDmiAdxTrend and not priceInVA and emaOrderOk
string regimeShort = rExhaustA ? "·耗尽" : rExpandA ? "·扩张" : rContrA ? "·收缩" : rTrendA ? "·趋势" : "·平衡"
f_render_action_panel() =>
    bool sweepHtfConf = false
    if fvgHtfValid and (sweptHighNow or sweptLowNow) and not na(ictEventPrice) and array.size(htfFvgList) > 0
        for sj = 0 to array.size(htfFvgList) - 1
            FVG hz = array.get(htfFvgList, sj)
            if ictEventPrice <= hz.top and ictEventPrice >= hz.bot
                sweepHtfConf := true
    string panelCheckText = "—"
    string panelStructText = "—"
    string panelRiskText = ""
    string panelFvgGrade = "—"
    if activeLongPlan or activeShortPlan
        bool badHtf = (activeLongPlan and not htfAllowLong) or (activeShortPlan and not htfAllowShort)
        bool badEma = (activeLongPlan and not emaBull) or (activeShortPlan and not emaBear)
        bool badCvd = cvdConflictLong or cvdConflictShort
        bool badDisp = REQUIRE_DISPLACEMENT_FOR_A and not ((activeLongPlan and dispLongOk) or (activeShortPlan and dispShortOk))
        bool badPd = USE_PD_FILTER and ((activeLongPlan and not pdAllowLong) or (activeShortPlan and not pdAllowShort))
        bool badAdr = ADR_AS_FILTER and not na(adrUsedPct) and (((activeLongPlan and adrLowRoomLong) or (activeShortPlan and adrLowRoomShort)) or adrExhausted)
        bool badSmt = SHOW_SMT and (smtConflictLong or smtConflictShort)

        string ckHtf = activeLongPlan ? (htfAllowLong ? "HTF✓" : "HTF✗") : activeShortPlan ? (htfAllowShort ? "HTF✓" : "HTF✗") : "HTF-"
        string ckCvd = (activeLongPlan and cvdBullConfirmQualified) or (activeShortPlan and cvdBearConfirmQualified) ? "CVD✓" : (cvdConflictLong or cvdConflictShort) ? "CVD✗" : "CVD-"
        string ckLoc = nearAKeyLevel ? "位置✓" : nearCvdKeyLevel ? "位置~" : "位置✗"
        string ckMss = (activeLongPlan and mssLongOk) or (activeShortPlan and mssShortOk) ? "MSS✓" : ""
        string ckFvg = not SHOW_FVG ? "" : (activeLongPlan and inBullFvgHtf) or (activeShortPlan and inBearFvgHtf) ? "FVG✓HTF" : (activeLongPlan and inBullFvg) or (activeShortPlan and inBearFvg) ? "FVG✓" : ""
        string ckSweep = not sweepHtfConf ? "" : (activeLongPlan and sweptLowNow) or (activeShortPlan and sweptHighNow) ? "扫★HTF" : ""
        float activeObScore = activeLongPlan ? inBullObScore : activeShortPlan ? inBearObScore : 0.0
        string ckOb = (activeLongPlan and (inBullOB or inBullBreaker)) or (activeShortPlan and (inBearOB or inBearBreaker)) ? "OB" + f_zone_grade(activeObScore) + str.tostring(math.round(activeObScore)) : (inBullOB or inBearOB or inBullBreaker or inBearBreaker) ? "OB~" : ""
        // 20260807 拆两行：确认行只留核心(HTF/CVD/位置/MSS)，结构行放FVG/OB/BOS/扫——避免单行撑宽表格
        panelCheckText := ckHtf + " " + ckCvd + " " + ckLoc + (ckMss != "" ? " " + ckMss : "")
        panelStructText := (ckFvg != "" ? ckFvg : "") + (ckSweep != "" ? " " + ckSweep : "") + (ckOb != "" ? " " + ckOb : "") + (bosChochText != "" ? " " + bosChochText : "")
        string riskText = ""
        riskText := riskText + (badHtf ? "HTF逆 " : "")
        riskText := riskText + (badCvd ? "CVD冲突 " : "")
        riskText := riskText + (badEma ? "EMA逆 " : "")
        riskText := riskText + (badDisp ? "位移缺 " : "")
        riskText := riskText + (badPd ? (activeLongPlan ? "深溢价 " : "深折价 ") : "")
        riskText := riskText + (badAdr ? (adrExhausted ? "ADR耗尽 " : "ADR空间少 ") : "")
        riskText := riskText + (badSmt ? "SMT逆 " : "")

        riskText := riskText + (lowLiquidityAsset ? "薄量 " : "")
        panelRiskText := riskText
        bool longFvgActive = activeLongPlan and inBullFvg
        bool shortFvgActive = activeShortPlan and inBearFvg
        bool longFvgHtf = activeLongPlan and inBullFvgHtf
        bool shortFvgHtf = activeShortPlan and inBearFvgHtf
        float activeFvgScore = activeLongPlan ? inBullFvgScore : activeShortPlan ? inBearFvgScore : 0.0
        if longFvgActive or shortFvgActive
            panelFvgGrade := f_zone_grade(activeFvgScore) + "级 质量" + str.tostring(math.round(activeFvgScore)) + (longFvgHtf or shortFvgHtf ? " HTF" : "")
    color actionBgColor = setupX ? color.new(color.red, 5) : actionWeakened ? color.new(color.orange, 5) : displayLongA ? color.new(color.green, 0) : setupLongB ? color.new(color.green, 30) : setupLongC ? color.new(color.green, 50) : displayShortA ? color.new(color.maroon, 0) : setupShortB ? color.new(color.maroon, 30) : setupShortC ? color.new(color.maroon, 50) : color.new(color.gray, 10)
    int pnlBgT = ACTION_PANEL_TRANSP
    bool pnlLight = ACTION_PANEL_THEME == "浅色"
    color PNL_LABEL_COL = pnlLight ? #5B6470 : #9AA0AA
    color PNL_VAL_COL   = pnlLight ? #1A1D23 : #ECEFF4
    color PNL_LONG_COL  = #26C281
    color PNL_SHORT_COL = #F23645
    color PNL_WARN_COL  = pnlLight ? #C97A00 : #FFB300
    color PNL_ROW_BG    = color.new(pnlLight ? #F4F5F7 : #0E1116, pnlBgT)
    color PNL_ALT_BG    = color.new(pnlLight ? #E7EAEF : #161A21, pnlBgT)
    color PNL_CONC_BG   = color.new(actionBgColor, math.max(pnlBgT - 18, 0))
    var string _posSel = ACTION_PANEL_POS == "右上" ? position.top_right : ACTION_PANEL_POS == "右中" ? position.middle_right : ACTION_PANEL_POS == "右下" ? position.bottom_right : ACTION_PANEL_POS == "左上" ? position.top_left : ACTION_PANEL_POS == "左中" ? position.middle_left : position.bottom_left
    string sweepCntText = ictSweptCount + ictActiveCount > 0 ? "已扫" + str.tostring(ictSweptCount) + "/剩" + str.tostring(ictActiveCount) : ""
    // 20260810 看位行带方向+行动：多/空计划明确"准备做哪边+到位后等什么触发"，无计划时磁吸位=盯扫位观察
    string guideLookText = planSideLong ? (na(pullbackLevelPrice) ? "多·回踩位待定" : "多·回踩" + str.replace(pullbackLevelText, " ", "")) : planSideShort ? (na(reboundLevelPrice) ? "空·反抽位待定" : "空·反抽" + str.replace(reboundLevelText, " ", "")) : (magnetNearestName != "" ? "待·磁吸" + magnetNearestName + f_fmt_price(magnetNearestPrice) : "看位待定")
    string guideActionWord = planSideLong ? "到位等MSS↑" : planSideShort ? "到位等MSS↓" : "盯扫位/位移"
    string kzShort = inKillZoneAsia ? "⚡亚" : inKillZoneLondon ? "⚡伦" : inKillZoneNY ? "⚡纽" : ""
    // 20260810 行动格瘦身：guideStructText 去"·结构"前缀（移入结构行，表头即"结构"）；bosChochText 由 panelStructText 提供，此处不再重复
    string guideStructText = planSideLong ? (structureBias > 0 ? "多" : structureBias < 0 ? "逆空" : "待") : planSideShort ? (structureBias < 0 ? "空" : structureBias > 0 ? "逆多" : "待") : (structureBias > 0 ? "多" : structureBias < 0 ? "空" : "待")
    // 20260810 行动格瘦身：guideHtfText 移入确认行（保留"·高周X"前缀作分隔）
    string guideHtfText = "·高周" + (htfBullConfirmed ? "多" : htfBearConfirmed ? "空" : "待") + ((planSideLong and htfBearConfirmed) or (planSideShort and htfBullConfirmed) ? "⚠" : "")
    string vwapAnchorTag = "·VWAP" + (sVwapBasis == "D" ? "日" : sVwapBasis == "W" ? "周" : "月")
    bool panelLongSide  = activeLongPlan
    bool panelShortSide = activeShortPlan
    bool panelRisk = setupX or lowLiquiditySession or lowLiquidityAsset or rrHardBlock or ((panelLongSide or panelShortSide) and (not priceGeometryOk or not barstate.isconfirmed or not triggerFresh)) or actionWeakened or adrChaseBlock
    color concTextCol = panelRisk ? PNL_WARN_COL : panelLongSide ? PNL_LONG_COL : panelShortSide ? PNL_SHORT_COL : PNL_VAL_COL
    string panelEntryVal = triggerCode == 0 ? "等触发" : not triggerFresh ? "触发过期" : not barstate.isconfirmed ? "盘中候选·等收线" : not priceGeometryOk ? "不做·结构无效" : rrHardBlock ? "不做·R:R不足" : manualBcCandidate and not executablePlan ? "B/C人工 " + entryPriceText : not executablePlan ? "等确认·" + activeTriggerText : "挂单 " + entryPriceText + "·" + activeTriggerText
    string panelStopVal  = not visiblePlan ? "—" : stopPriceText != "" ? stopPriceText + (not na(replayStopAtr) ? " (" + str.tostring(replayStopAtr, "#.1") + "ATR)" : "") : "—"
    string panelTgtVal   = not visiblePlan ? "—" : not na(replayTargetPrice) ? magnetTargetText + (rrText != "" ? "  " + rrText : "") : "—"
    string pdShort = pdPos >= PD_LONG_MAX ? "深溢价" : pdPos <= PD_SHORT_MIN ? "深折价" : pdPos >= 60 ? "溢价" : pdPos <= 40 ? "折价" : ""
    string dmiCompact = dmiHot ? " · 过热" : dmiTrendWeak ? " · 走弱" : dmiBullConfirm or dmiBearConfirm ? "" : " · 待定"
    // 20260810 行动格瘦身：scoreShort 尾部类型文字压缩（趋势偏多→趋势等），方向细节由行动词承载
    string scoreShort = (activeLongPlan or activeShortPlan) ? " 分" + str.tostring(trendLongScore) + "/" + str.tostring(trendShortScore) + "/" + str.tostring(reversalLongScore) + "/" + str.tostring(reversalShortScore) + "·" + (trendLongScore >= trendShortScore + 2 ? "趋势" : trendShortScore >= trendLongScore + 2 ? "趋势" : (reversalLongScore >= reversalShortScore + 2 ? "反转" : reversalShortScore >= reversalLongScore + 2 ? "反转" : "均衡")) : ""
    string panelDirVal   = actionBiasWord + dmiCompact + (pdShort != "" ? " · " + pdShort : "") + regimeShort + scoreShort
    string panelRiskOne = not barstate.isconfirmed and (activeLongPlan or activeShortPlan) ? "未收线" : not triggerFresh and (activeLongPlan or activeShortPlan) ? "触发过期" : rrHardBlock ? "R:R不足" : str.contains(panelRiskText, "HTF逆") ? "HTF逆" : str.contains(panelRiskText, "CVD冲突") ? "CVD冲突" : str.contains(panelRiskText, "ADR耗尽") ? "ADR耗尽" : str.contains(panelRiskText, "ADR空间少") ? "ADR空间少" : str.contains(panelRiskText, "SMT逆") ? "SMT逆" : str.contains(panelRiskText, "薄量") ? "薄量" : ""
    string panelUnlockText = visiblePlan ? finalInvalidSpecificText : not barstate.isconfirmed and (activeLongPlan or activeShortPlan) ? "等本周期收线" : not triggerFresh and (activeLongPlan or activeShortPlan) ? "等新扫位/MSS/回踩" : rrHardBlock ? "等更好价，R:R≥2R" : lowLiquiditySession ? "等伦敦/纽约" : cvdConflictLong or cvdConflictShort ? "等CVD配合" : adrChaseBlock ? "等回踩/反抽重置" : setupX ? "等" + watchText : actionWeakened ? "等冲突解除" : lineAction
    bool panelNeedUnlock = panelRisk or not executablePlan
    string panelConclusionVal = (panelRiskOne != "" and not str.contains(actionStateText, panelRiskOne) ? actionStateText + " ⚠" + panelRiskOne : actionStateText) + (panelNeedUnlock ? " · " + panelUnlockText : "")
    bool rdySweep  = sweptLowReclaimed or sweptHighRejected
    bool rdyMss    = mssLongOk or mssShortOk
    bool rdyAccept = acceptanceBullOk or acceptanceBearOk
    bool rdyFvg    = (activeLongPlan and bullFvgTradeOk) or (activeShortPlan and bearFvgTradeOk)
    bool rdyOb     = (activeLongPlan and bullObTradeOk) or (activeShortPlan and bearObTradeOk)
    bool rdyCvd    = cvdBullConfirmQualified or cvdBearConfirmQualified
    bool rdyHtf    = (activeLongPlan and htfAllowLong) or (activeShortPlan and htfAllowShort)
    int  rdyCount  = (rdySweep ? 1 : 0) + (rdyMss ? 1 : 0) + (rdyAccept ? 1 : 0) + (rdyFvg ? 1 : 0) + (rdyOb ? 1 : 0) + (rdyCvd ? 1 : 0) + (rdyHtf ? 1 : 0)
    float rdyPct   = setupX ? 0.0 : executablePlan ? 100.0 : rdyCount >= 5 ? 85.0 : rdyCount == 4 ? 70.0 : rdyCount == 3 ? 55.0 : rdyCount == 2 ? 40.0 : rdyCount == 1 ? 25.0 : 10.0
    string rdyWord = setupX ? "禁做" : executablePlan ? "可做" : rdyPct >= 70 ? "就绪" : rdyPct >= 40 ? "接近" : "等待"
    string rdyGauge = rdyWord + " " + str.tostring(int(rdyPct)) + "%"
    color rdyCol = setupX ? PNL_WARN_COL : executablePlan ? PNL_LONG_COL : rdyPct >= 70 ? PNL_LONG_COL : rdyPct >= 40 ? PNL_WARN_COL : PNL_VAL_COL
    string confPct = activeLongPlan or activeShortPlan ? " 置信" + str.tostring(setupTotalScore * 10) + "%" : ""
    string posText = priceAboveVah ? "价在VA上" : priceBelowVal ? "价在VA下" : priceInVA ? "价在VA内" : "价在VA边"
    // 20260810 看位瘦身：KillZone 标记移入位置行（位置行最短，价态+就绪+锚定+窗口=空间+时机）
    f_pnl_row("位置", posText + "·" + rdyGauge + vwapAnchorTag + (kzShort != "" ? " " + kzShort : ""), priceAboveVah or priceBelowVal ? PNL_WARN_COL : rdyCol)
    f_pnl_row("结论", panelConclusionVal, concTextCol)
    f_pnl_row("方向", panelDirVal + confPct, concTextCol)
    f_pnl_row("进场", panelEntryVal + "·" + expectedTriggerPath, panelShortSide ? PNL_SHORT_COL : PNL_LONG_COL)
    f_pnl_row("风控", "止" + panelStopVal + " 标" + panelTgtVal, PNL_VAL_COL)
    // 20260810 按用户要求：CVD 与 OI 恢复独立行（12行布局），保留各自配色
    f_pnl_row("CVD", actionCvdText, str.contains(actionCvdText, "顶背离") or str.contains(actionCvdText, "卖盘") or str.contains(actionCvdText, "派发") ? PNL_WARN_COL : str.contains(actionCvdText, "底背离") or str.contains(actionCvdText, "买盘") or str.contains(actionCvdText, "吸收") ? PNL_LONG_COL : PNL_VAL_COL)
    bool oiWired = SHOW_OI_ROW and not na(oiSource) and oiSource != close and math.abs(oiSource) <= 100
    string oiRowText = (oiWired
        ? (oiSource > 0 ? "▲" : oiSource < 0 ? "▼" : "·") + 
          (oiSource > 0 and close > close[1] ? "新多" : 
           oiSource < 0 and close > close[1] ? "空回补" : 
           oiSource > 0 and close < close[1] ? "新空" : 
           oiSource < 0 and close < close[1] ? "多平仓" : "持平") + 
          " " + str.tostring(math.abs(oiSource), "#.2") + "%" + 
          (oiSource > 0 and close > close[1] or oiSource < 0 and close < close[1] ? " ✓一致" : oiSource != 0 ? " ⚠分歧" : "")
        : (SHOW_OI_ROW ? "未接副指标·选OI%" : ""))
    color oiRowCol = oiWired ? (oiSource > 0 and close > close[1] or oiSource < 0 and close < close[1] ? PNL_LONG_COL : oiSource != 0 ? PNL_WARN_COL : PNL_VAL_COL) : PNL_VAL_COL
    f_pnl_row("OI", oiRowText, oiRowCol)
    string panelConfirmText = panelCheckText
    bool panelConfirmWarn = str.contains(panelConfirmText, "✗") or str.contains(panelFvgGrade, "C级")
    bool panelConfirmGood = panelCheckText != "—" and not panelConfirmWarn
    // 20260810 行动格瘦身：高周方向从看位行移入确认行
    f_pnl_row("确认", panelConfirmText + guideHtfText, panelConfirmGood ? PNL_LONG_COL : panelConfirmWarn ? PNL_WARN_COL : PNL_VAL_COL)
    // 20260810 行动格瘦身：结构方向从看位行移入结构行（panelStructText="—"时不显示占位）
    f_pnl_row("结构", (panelStructText != "—" ? panelStructText + " " : "") + guideStructText + (sweepCntText != "" ? " · " + sweepCntText : ""), PNL_VAL_COL)
    // 20260810 按用户要求：磁吸行恢复原格式（名称 价格 分NN ★HTF 距离A）
    string pnlMagUp = not na(magnetAbovePrice) ? "↑" + magnetAboveName + " " + str.tostring(magnetAbovePrice, format.mintick) + " 分" + str.tostring(magnetAboveScore) + (magnetAboveHtf ? "★HTF" : "") + " " + str.tostring(math.abs(magnetAbovePrice - close) / math.max(currATR, syminfo.mintick), "#.1") + "A" : "--"
    string pnlMagDn = not na(magnetBelowPrice) ? "↓" + magnetBelowName + " " + str.tostring(magnetBelowPrice, format.mintick) + " 分" + str.tostring(magnetBelowScore) + (magnetBelowHtf ? "★HTF" : "") + " " + str.tostring(math.abs(magnetBelowPrice - close) / math.max(currATR, syminfo.mintick), "#.1") + "A" : "--"
    f_pnl_row("磁吸↑", pnlMagUp, PNL_LONG_COL)
    f_pnl_row("磁吸↓", pnlMagDn, PNL_SHORT_COL)
    // 20260810 看位行 = 方向·位类型·位名价格·到位行动（KillZone 已移位置行）
    f_pnl_row("看位", guideLookText + "·" + guideActionWord, PNL_VAL_COL)
    int pnlRowCount = array.size(pnlLabels)
    var table actionPanel = table.new(_posSel, 2, 18, border_width=1, border_color=color.new(#000000, 70), frame_width=1, frame_color=color.new(#000000, 50))
    if barstate.islast
        table.clear(actionPanel, 0, 0, 1, 17)
        if SHOW_ACTION_PANEL and pnlRowCount > 0
            for r = 0 to pnlRowCount - 1
                string lab = array.get(pnlLabels, r)
                string val = array.get(pnlValues, r)
                color vcol = array.get(pnlValCols, r)
                bool isConc = r == 1
                color rowBg = isConc ? PNL_CONC_BG : (r % 2 == 0 ? PNL_ROW_BG : PNL_ALT_BG)
                color labCol = isConc ? color.white : PNL_LABEL_COL
                color valCol = isConc ? color.white : vcol
                table.cell(actionPanel, 0, r, lab, text_color=labCol, bgcolor=rowBg, text_size=ACTION_PANEL_SIZE, text_halign=text.align_left)
                table.cell(actionPanel, 1, r, val, text_color=valCol, bgcolor=rowBg, text_size=ACTION_PANEL_SIZE, text_halign=text.align_left)
// 20260810 审计修复（P2）：行动格整函数只在最后一根 K 渲染，省历史 K 每根 20+ 字符串拼接计算量
if barstate.islast
    f_render_action_panel()
int mcpQualityCode = (xHtfConflict ? 1 : 0) + ((not cvdQualityOk or cvdLowSample) ? 2 : 0) + ((lowLiquiditySession or lowLiquidityAsset) ? 4 : 0) + ((adrExhausted or adrChaseBlock) ? 8 : 0) + (((activeLongPlan and inBullFvgHtf) or (activeShortPlan and inBearFvgHtf)) ? 16 : 0) + ((mssLongOk or mssShortOk) ? 32 : 0) + (not emaOrderOk ? 64 : 0)
float mcpFvgScore = activeLongPlan ? inBullFvgScore : activeShortPlan ? inBearFvgScore : math.max(mcpBullFvgScore, mcpBearFvgScore)
float mcpObScore = activeLongPlan ? inBullObScore : activeShortPlan ? inBearObScore : math.max(bestBullObScore, bestBearObScore)
// 20260808 审计修复（P2）：regime 状态与行动格区共用同一组全局变量（rAtrBaseA/rExhaustA 等），
bool regimeBalance = priceInVA and dmiAdx < effDmiAdxTrend
int regimeCode = rExhaustA ? 5 : rExpandA ? 4 : rContrA ? 3 : rTrendA ? 1 : regimeBalance ? 2 : 2
int preferredModelCode = regimeCode == 1 ? 1 : regimeCode == 2 ? 2 : regimeCode == 3 ? 3 : regimeCode == 4 ? 4 : 5
int regimeConfidence = int(math.round(math.min(95.0, math.max(50.0, regimeCode == 1 ? dmiAdx * 2 : regimeCode == 2 ? 100 - dmiAdx * 2 : math.abs(rAtrRatioA - 1.0) * 100 + 55))))
int marketCode = marketCrypto ? 1 : marketMetal ? 2 : marketForex ? 3 : marketStock ? 4 : marketIndex ? 5 : marketFutures ? 6 : marketOption ? 7 : 0
int executionPack = (priceGeometryOk ? 1 : 0) * 1000000 + (barstate.isconfirmed ? 1 : 0) * 100000 + int(math.round(math.min(nz(candidateStopAtr, 0), 9.99) * 100)) * 10 + (entryValidCode + 3)
int triggerPack = (triggerCode + 10) * 100000 + math.min(triggerAge, 999) * 100 + (triggerFresh ? 10 : 0) + (signalStateCode + 1)
int regimePack = regimeCode * 10000 + preferredModelCode * 100 + regimeConfidence
int contractPack = 171000 + marketCode * 10 + 1
// 20260808 审计修复（P1）：X 优先于方向——setupX 成立时（如 dmiHot+远离/HTF冲突）Side 必须输出 9，
// 原顺序 activeLongPlan 在前，而 setupLongB 不含 not setupX，导致 X 时输出 1/-1 与 entryValidCode=-3 自相矛盾。
plot(setupX ? 9 : activeLongPlan ? 1 : activeShortPlan ? -1 : 0, "MCP Side Code", display=display.data_window)
plot(replayGradeCode, "MCP Grade Code", display=display.data_window)
plot(setupTotalScore, "MCP Setup Score", display=display.data_window)
plot(replayPlanPrice, "MCP Entry Price", display=display.data_window)
plot(replayInvalidPrice, "MCP Stop Price", display=display.data_window)
plot(replayTargetPrice, "MCP Target Price", display=display.data_window)
plot(lastSignalDir, "MCP Last Signal Dir", display=display.data_window)
plot(math.min(lastSignalBars, 999), "MCP Last Signal Age", display=display.data_window)
plot(cvdValue, "MCP CVD Value", display=display.data_window)
plot(cvdUseLowerTf ? 2 : 1, "MCP CVD Method Code (2=lower-TF estimate,1=bar estimate)", display=display.data_window)
plot(na(perpSpotBasisPct) ? 0 : perpSpotBasisPct * 10000, "MCP Spot-Perp Basis (bp, funding代理)", display=display.data_window)
plot(EMA_LEN_1, "MCP EMA Length 1", display=display.data_window)
plot(EMA_LEN_2, "MCP EMA Length 2", display=display.data_window)
plot(EMA_LEN_3, "MCP EMA Length 3", display=display.data_window)
plot(EMA_LEN_4, "MCP EMA Length 4", display=display.data_window)
plot(mcpQualityCode, "MCP Quality Code", display=display.data_window)
plot(mcpFvgScore, "MCP FVG Quality Score", display=display.data_window)
plot(mcpObScore, "MCP OB Quality Score", display=display.data_window)
plot(entryValidCode, "MCP Entry Valid Code", display=display.data_window)
plot(rrRatio, "MCP RR Ratio", display=display.data_window)
plot(noTradeReasonCode, "MCP NoTrade Reason Code", display=display.data_window)
plot(executionPack, "MCP Execution Pack", display=display.data_window)
plot(triggerPack, "MCP Trigger Pack", display=display.data_window)
plot(regimePack, "MCP Regime Pack", display=display.data_window)
plot(contractPack, "MCP Contract Pack", display=display.data_window)
plot(mcpBullFvgCe, "MCP Bull FVG CE", display=display.data_window)
plot(mcpBearFvgCe, "MCP Bear FVG CE", display=display.data_window)
bool mcpNearestFvgIsBull = not na(mcpBullFvgDist) and (na(mcpBearFvgDist) or mcpBullFvgDist <= mcpBearFvgDist)
bool mcpNearestFvgIsBear = not na(mcpBearFvgDist) and (na(mcpBullFvgDist) or mcpBearFvgDist < mcpBullFvgDist)
int mcpFvgQualityCode = inBullFvgHtf ? 12 : inBullFvg ? 11 : inBearFvgHtf ? -12 : inBearFvg ? -11 : mcpNearestFvgIsBull ? (mcpBullFvgHtf ? 2 : 1) : mcpNearestFvgIsBear ? (mcpBearFvgHtf ? -2 : -1) : 0
int mcpObCode = inBullOB or inBullBreaker ? 1 : inBearOB or inBearBreaker ? -1 : 0
int mcpBosCode = chochBull ? 2 : chochBear ? -2 : bosBull ? 1 : bosBear ? -1 : 0
int mcpLvCode = inBullLV ? 1 : inBearLV ? -1 : 0
int mcpStructPack = int(nz(mcpFvgQualityCode, 0)) * 10000 + (mcpObCode + 1) * 100 + (mcpBosCode + 2) * 10 + (mcpLvCode + 1)
plot(mcpStructPack, "MCP StructPack (FvgQ*10000+(OB+1)*100+(BOS+2)*10+(LV+1))", display=display.data_window)
// 20260810 审计修复（P1-3）：原硬编码 10000+300+600 恒=10900 且注释声称"Risk%*10000+..."，实为静态配置编码（无真实仓位数据源）——命名常量+准确注释，避免 MCP 消费方误读为实时风控。
const int MCP_RISK_CONFIG_PACK = 10000 + 300 + 600
int mcpRiskPack = MCP_RISK_CONFIG_PACK
plot(mcpRiskPack, "MCP Risk Pack (静态配置: Risk10%*10000+日损3%*100+周损6%)", display=display.data_window)
float axisPoc = SHOW_AXIS_VP_LEVELS and SHOW_POC ? profileEngine.lastPocPrice : na
float axisVah = SHOW_AXIS_VP_LEVELS and SHOW_VAH_VAL ? profileEngine.lastVahPrice : na
float axisVal = SHOW_AXIS_VP_LEVELS and SHOW_VAH_VAL ? profileEngine.lastValPrice : na
float axisNpoc = SHOW_AXIS_VP_LEVELS and SHOW_NPOC ? nearestNpocForAxis : na
float axisDo = SHOW_AXIS_DO_LEVEL ? dOpenToday : na
bool alertConfirmOk = not CONFIRM_PRO_ALERTS or barstate.isconfirmed
bool alertLongA = ENABLE_PRO_ALERTS and alertConfirmOk and displayLongA and entryValidCode == 3
bool alertShortA = ENABLE_PRO_ALERTS and alertConfirmOk and displayShortA and entryValidCode == 3
bool alertLongB = ENABLE_PRO_ALERTS and alertConfirmOk and setupLongB and not setupX
bool alertShortB = ENABLE_PRO_ALERTS and alertConfirmOk and setupShortB and not setupX
bool alertLongC = ENABLE_PRO_ALERTS and alertConfirmOk and setupLongC and not setupX
bool alertShortC = ENABLE_PRO_ALERTS and alertConfirmOk and setupShortC and not setupX
bool alertSweepLowRepair = ENABLE_PRO_ALERTS and alertConfirmOk and sweptLowReclaimed and (cvdBullDivQualified or cvdAbsorbBuyQualified)
bool alertSweepHighReject = ENABLE_PRO_ALERTS and alertConfirmOk and sweptHighRejected and (cvdBearDivQualified or cvdDistributeSellQualified)
bool alertNoChase = ENABLE_PRO_ALERTS and alertConfirmOk and setupX
bool alertSmtDiv = ENABLE_PRO_ALERTS and alertConfirmOk and (smtBullDiv or smtBearDiv)
bool alertKillZone = ENABLE_PRO_ALERTS and alertConfirmOk and isKillZone and not isKillZone[1]
bool alertCvdDiv = ENABLE_PRO_ALERTS and alertConfirmOk and (cvdBullDivQualified or cvdBearDivQualified)
bool alertMagnetHigh = ENABLE_PRO_ALERTS and alertConfirmOk and magnetTargetScore >= 70 and magnetTargetScore[1] < 70
bool alertAdrExhaust = ENABLE_PRO_ALERTS and alertConfirmOk and ADR_ENABLE and adrExhausted and not adrExhausted[1]
// 免费档无技术告警配额（Basic=0 technical alerts）：16个alertcondition改为1个运行时alert()事件（不占plot count）。
// 升级付费后此事件自动可用；条件bool保留供MCP Data Window/行动格消费。
bool anyAlertNow = alertLongA or alertShortA or alertLongB or alertShortB or alertLongC or alertShortC or alertSweepLowRepair or alertSweepHighReject or alertNoChase or alertSmtDiv or alertKillZone or alertCvdDiv or alertMagnetHigh or alertAdrExhaust or (alertConfirmOk and obMitigatedBull) or (alertConfirmOk and obMitigatedBear)
var bool anyAlertPrev = false
bool alertFire = ENABLE_PRO_ALERTS and anyAlertNow and not anyAlertPrev
anyAlertPrev := anyAlertNow
string alertMsg = alertLongA ? "A多 入场" :
     alertShortA ? "A空 入场" :
     alertLongB ? "B多 等回踩确认" :
     alertShortB ? "B空 等反抽确认" :
     alertLongC ? "C多 等站回确认" :
     alertShortC ? "C空 等跌回确认" :
     alertSweepLowRepair ? "扫低收回+CVD" :
     alertSweepHighReject ? "扫高拒绝+CVD" :
     alertNoChase ? "禁追 等回调" :
     alertSmtDiv ? "SMT背离" :
     alertKillZone ? "KillZone开盘" :
     alertCvdDiv ? "CVD背离" :
     alertMagnetHigh ? "Magnet高分" :
     alertAdrExhaust ? "ADR耗尽" :
     (alertConfirmOk and obMitigatedBull) ? "看涨OB缓解" :
     (alertConfirmOk and obMitigatedBear) ? "看跌OB缓解" : "SVP事件"
// alert() 只在实时K评估（官方：Alerts only trigger in the realtime bar），无需 islast 门控——islast 反而会吞掉收盘确认信号
if alertFire
    alert(alertMsg, alert.freq_once_per_bar)
float axisPocPlot = (SHOW_RIGHT_PRICE_AXIS and SHOW_AXIS_VP_LEVELS) ? axisPoc : na
float axisVahPlot = (SHOW_RIGHT_PRICE_AXIS and SHOW_AXIS_VP_LEVELS) ? axisVah : na
float axisValPlot = (SHOW_RIGHT_PRICE_AXIS and SHOW_AXIS_VP_LEVELS) ? axisVal : na
float axisNpocPlot = (SHOW_RIGHT_PRICE_AXIS and SHOW_AXIS_VP_LEVELS and SHOW_NPOC) ? axisNpoc : na
float axisDoPlot  = (SHOW_RIGHT_PRICE_AXIS and SHOW_AXIS_DO_LEVEL) ? axisDo : na
f_axis_unique(float level, float ref1, float ref2, float ref3, float ref4) =>
    float threshold = math.max(syminfo.mintick * 4, math.abs(close) * 0.00005)
    bool dup1 = not na(level) and not na(ref1) and math.abs(level - ref1) <= threshold
    bool dup2 = not na(level) and not na(ref2) and math.abs(level - ref2) <= threshold
    bool dup3 = not na(level) and not na(ref3) and math.abs(level - ref3) <= threshold
    bool dup4 = not na(level) and not na(ref4) and math.abs(level - ref4) <= threshold
    not na(level) and not (dup1 or dup2 or dup3 or dup4)
float axisWeeklyVwapPlot = (SHOW_RIGHT_PRICE_AXIS and SHOW_AXIS_VWAP_LEVELS and SHOW_WEEKLY_VWAP and f_axis_unique(vwapWeekly, axisPocPlot, axisVahPlot, axisValPlot, axisNpocPlot)) ? vwapWeekly : na
float axisMonthlyVwapPlot = (SHOW_RIGHT_PRICE_AXIS and SHOW_AXIS_VWAP_LEVELS and SHOW_MONTHLY_VWAP and f_axis_unique(vwapMonthly, axisPocPlot, axisVahPlot, axisValPlot, axisWeeklyVwapPlot)) ? vwapMonthly : na
float axisDoUniquePlot = f_axis_unique(axisDoPlot, axisPocPlot, axisVahPlot, axisValPlot, axisWeeklyVwapPlot) and f_axis_unique(axisDoPlot, axisMonthlyVwapPlot, axisNpocPlot, na, na) ? axisDoPlot : na
plot(axisPocPlot, title="POC Price", color=#0F0F0F, show_last=1, display=display.price_scale)
plot(axisVahPlot, title="VAH Price", color=#2962FF, show_last=1, display=display.price_scale)
plot(axisValPlot, title="VAL Price", color=#2962FF, show_last=1, display=display.price_scale)
plot(axisNpocPlot, title="nPOC Price", color=#787B86, show_last=1, display=display.price_scale)
plot(axisWeeklyVwapPlot, title="W VWAP Price", color=#FF00FF, show_last=1, display=display.price_scale)
plot(axisMonthlyVwapPlot, title="M VWAP Price", color=#FF9800, show_last=1, display=display.price_scale)
plot(axisDoUniquePlot, title="DO Price", color=#673AB7, show_last=1, display=display.price_scale)
