int MAX_ARRAY_SIZE = 95000
int MAX_DRAW_BARS_BACK = 9000
int CHART_LINE_VISIBLE_DAYS = input.int(30, "图表连续线显示最近天数", minval=1, maxval=365, tooltip="只限制连续图表线：S VWAP/标准带、周/...", group=APPEARANCE_GROUP)
string tickerUpper = str.upper(syminfo.ticker)
string tickerIdUpper = str.upper(syminfo.tickerid)
string tickerRootUpper = str.upper(syminfo.root)
bool autoCrypto = syminfo.type == "crypto"
bool autoForex = syminfo.type == "forex"
bool autoStock = syminfo.type == "stock" or syminfo.type == "dr" or syminfo.type == "fund"
bool autoFutures = syminfo.type == "futures"
bool autoIndex = syminfo.type == "index" or syminfo.type == "indices"
bool autoCfd = syminfo.type == "cfd"
bool autoMetal = str.contains(tickerUpper, "XAU") or str.contains(tickerUpper, "XAG") or str.contains(tickerUpper, "GOLD") or str.contains(tickerUpper, "SILVER") or tickerRootUpper == "GC" or tickerRootUpper == "SI" or str.contains(tickerIdUpper, "COMEX:GC") or str.contains(tickerIdUpper, "COMEX:SI")
bool autoOptionLike = syminfo.type == "warrant" or syminfo.type == "right" or str.contains(tickerUpper, "CALL") or str.contains(tickerUpper, "PUT")
bool isPerp = autoCrypto and (str.endswith(syminfo.ticker, "PERP") or str.endswith(syminfo.ticker, ".P"))
int curTfSec = timeframe.in_seconds(timeframe.period)
string autoMarket = autoOptionLike ? "期权标的" : autoMetal ? "贵金属" : autoCrypto ? "加密" : autoForex ? "外汇" : autoStock ? "股票" : autoIndex ? "指数" : autoFutures ? "期货" : autoCfd ? "通用" : "通用"
string activeMarket = MARKET_PRESET == "自动" ? autoMarket : MARKET_PRESET
bool marketMetal = activeMarket == "贵金属"
bool marketForex = activeMarket == "外汇"
bool marketCrypto = activeMarket == "加密"
bool marketStock = activeMarket == "股票"
bool marketOption = activeMarket == "期权标的"
bool marketIndex = activeMarket == "指数"
bool marketFutures = activeMarket == "期货"
bool metalSpot   = marketMetal and not autoFutures
bool metalSilver = marketMetal and (str.contains(tickerUpper, "XAG") or str.contains(tickerUpper, "SILVER") or str.contains(tickerUpper, "SI1") or str.contains(tickerIdUpper, "COMEX:SI"))
int FINAL_ROWS = MARKET_ADAPTIVE_ENGINE ? (marketCrypto ? math.max(NUM_ROWS, 70) : marketForex ? math.max(NUM_ROWS, 40) : NUM_ROWS) : NUM_ROWS
int chartLineWindowMs = CHART_LINE_VISIBLE_DAYS * 24 * 60 * 60 * 1000
bool showRecentChartLine = time >= timenow - chartLineWindowMs
float effCvdWeight = MARKET_ADAPTIVE_ENGINE and marketCrypto ? math.min(CVD_CONFIRM_WEIGHT + 0.5, 2.0) : MARKET_ADAPTIVE_ENGINE and metalSpot ? 0.0 : MARKET_ADAPTIVE_ENGINE and (marketMetal or marketForex or marketStock or marketOption or marketFutures) ? math.max(CVD_CONFIRM_WEIGHT - 0.5, 0.0) : CVD_CONFIRM_WEIGHT
float effAKeyLevelAtr = MARKET_ADAPTIVE_ENGINE and marketCrypto ? math.max(A_KEY_LEVEL_ATR, 0.75) : MARKET_ADAPTIVE_ENGINE and marketMetal ? 0.60 : MARKET_ADAPTIVE_ENGINE and marketForex ? 0.50 : MARKET_ADAPTIVE_ENGINE and (marketStock or marketIndex or marketFutures) ? 0.55 : A_KEY_LEVEL_ATR
float effCvdKeyLevelAtr = MARKET_ADAPTIVE_ENGINE and marketCrypto ? math.max(CVD_KEY_LEVEL_ATR, 0.55) : MARKET_ADAPTIVE_ENGINE and marketForex ? 0.35 : MARKET_ADAPTIVE_ENGINE and (marketStock or marketOption or marketFutures) ? 0.30 : CVD_KEY_LEVEL_ATR
float effVwapExtendedAtr = MARKET_ADAPTIVE_ENGINE and marketCrypto ? 2.0 : MARKET_ADAPTIVE_ENGINE and marketMetal ? 1.5 : MARKET_ADAPTIVE_ENGINE and marketForex ? 1.2 : MARKET_ADAPTIVE_ENGINE and (marketStock or marketIndex or marketFutures) ? 1.4 : VWAP_EXTENDED_ATR
float effAtrStopMult = MARKET_ADAPTIVE_ENGINE and marketCrypto ? 1.8 : MARKET_ADAPTIVE_ENGINE and metalSilver ? 2.0 : MARKET_ADAPTIVE_ENGINE and marketMetal ? 1.5 : MARKET_ADAPTIVE_ENGINE and marketForex ? 1.2 : MARKET_ADAPTIVE_ENGINE and (marketStock or marketIndex or marketFutures) ? 1.4 : ATR_STOP_MULT
int effTrendAThreshold = MARKET_ADAPTIVE_ENGINE and marketCrypto ? 8 : MARKET_ADAPTIVE_ENGINE and marketForex ? 9 : 8
int effTrendBThreshold = MARKET_ADAPTIVE_ENGINE and marketForex ? 7 : 6
int effReversalThreshold = MARKET_ADAPTIVE_ENGINE and marketCrypto ? 7 : MARKET_ADAPTIVE_ENGINE and marketMetal ? 6 : MARKET_ADAPTIVE_ENGINE and marketForex ? 7 : 6
int effCvdWeightInt = int(math.round(effCvdWeight))
float effDmiAdxTrend = MARKET_ADAPTIVE_ENGINE ? (marketCrypto ? 25.0 : marketForex ? 18.0 : marketMetal ? 22.0 : DMI_ADX_TREND) : DMI_ADX_TREND
float effDmiAdxHot = MARKET_ADAPTIVE_ENGINE ? (marketCrypto ? 45.0 : marketForex ? 35.0 : marketMetal ? 42.0 : DMI_ADX_HOT) : DMI_ADX_HOT
float finalVpMinTickMult = MARKET_ADAPTIVE_ENGINE ? (marketCrypto ? VP_MIN_TICK_MULT : marketStock ? math.max(VP_MIN_TICK_MULT, 30) : marketForex ? math.max(VP_MIN_TICK_MULT, 40) : marketMetal or marketFutures or marketIndex ? math.max(VP_MIN_TICK_MULT, 50) : VP_MIN_TICK_MULT) : VP_MIN_TICK_MULT
int effAdrLen = MARKET_ADAPTIVE_ENGINE ? (marketCrypto ? 10 : marketForex ? 5 : (marketStock or marketIndex) ? 20 : (marketMetal or marketFutures) ? 14 : ADR_LEN) : ADR_LEN
float effAdrExhaustPct = MARKET_ADAPTIVE_ENGINE ? (marketCrypto ? 120.0 : marketMetal ? 110.0 : marketForex ? 100.0 : ADR_EXHAUST_PCT) : ADR_EXHAUST_PCT
float adrDailyRaw = request.security(syminfo.tickerid, "D", ta.sma(high - low, effAdrLen)[1], lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
float adrValue = ADR_ENABLE and not na(adrDailyRaw) and adrDailyRaw > 0 ? adrDailyRaw : na
bool adrIntraday = ADR_ENABLE and curTfSec < 86400 and not na(adrValue)
bool forceNoWeekend = (MARKET_MODE == "Forex/Stock (No Weekend)")
bool forceCryptoWeekend = (MARKET_MODE == "Crypto (7x24)")
bool isCrypto = forceCryptoWeekend or (marketCrypto and not forceNoWeekend)
f_is_weekend(string tz) =>
    int dw = dayofweek(time, tz)
    dw == dayofweek.saturday or dw == dayofweek.sunday
maxIndex(float[] a) =>
    int sz = array.size(a)
    if sz <= 0
        na
    else if sz == 1
        0
    else
        float m = array.get(a, 0)
        int idx = 0
        for i = 1 to sz - 1
            float v = array.get(a, i)
            if v > m
                m := v
                idx := i
        idx
f_get_style(str) =>
    str == "Solid" ? line.style_solid : str == "Dotted" ? line.style_dotted : line.style_dashed
poc_style_str = f_get_style(POC_STYLE_IN)
npoc_style_str = f_get_style(NPOC_STYLE_IN)
vahval_style_str = f_get_style(VAHVAL_STYLE_IN)
day_liquidity_style_str = f_get_style(DAY_LIQUIDITY_STYLE_IN)
week_liquidity_style_str = f_get_style(WEEK_LIQUIDITY_STYLE_IN)
type NakedPOC
    line ln
    float price
    int createdBar
    int approachSide
    bool swept
    int sweptBar
    bool hidden
var array<NakedPOC> npocList = array.new<NakedPOC>()
type VolumeProfileEngine
    float[] hPrices
    float[] lPrices
    float[] volumes
    float minProfilePrice
    float maxProfilePrice
    float priceStepSize
    polyline profileHistLower
    polyline profileHistUpper
    polyline valueAreaHistLower
    polyline valueAreaHistUpper
    line pocLevelLine
    line vahLevelLine
    line valLevelLine
    label pocLevelLabel
    label vahLevelLabel
    label valLevelLabel
    linefill vaFill
    float lastPocPrice
    float lastVahPrice
    float lastValPrice
f_clearVpObjects(VolumeProfileEngine this) =>
    if not na(this.profileHistLower)
        polyline.delete(this.profileHistLower)
    if not na(this.profileHistUpper)
        polyline.delete(this.profileHistUpper)
    if not na(this.valueAreaHistLower)
        polyline.delete(this.valueAreaHistLower)
    if not na(this.valueAreaHistUpper)
        polyline.delete(this.valueAreaHistUpper)
    if not na(this.pocLevelLine)
        line.delete(this.pocLevelLine)
    if not na(this.vahLevelLine)
        line.delete(this.vahLevelLine)
    if not na(this.valLevelLine)
        line.delete(this.valLevelLine)
    if not na(this.pocLevelLabel)
        label.delete(this.pocLevelLabel)
    if not na(this.vahLevelLabel)
        label.delete(this.vahLevelLabel)
    if not na(this.valLevelLabel)
        label.delete(this.valLevelLabel)
    if not na(this.vaFill)
        linefill.delete(this.vaFill)
    this.profileHistLower := na
    this.profileHistUpper := na
    this.valueAreaHistLower := na
    this.valueAreaHistUpper := na
    this.pocLevelLine := na
    this.vahLevelLine := na
    this.valLevelLine := na
    this.pocLevelLabel := na
    this.vahLevelLabel := na
    this.valLevelLabel := na
    this.vaFill := na
f_clearVpData(VolumeProfileEngine this) =>
    if not na(this.hPrices)
        array.clear(this.hPrices)
    if not na(this.lPrices)
        array.clear(this.lPrices)
    if not na(this.volumes)
        array.clear(this.volumes)
method initialize(VolumeProfileEngine this) =>
    this.hPrices := array.new_float()
    this.lPrices := array.new_float()
    this.volumes := array.new_float()
    this.minProfilePrice := na
    this.maxProfilePrice := na
    this.priceStepSize := na
    this.lastPocPrice := na
    this.lastVahPrice := na
    this.lastValPrice := na
    this
method calculatePriceBucket(VolumeProfileEngine this, float price) =>
    float raw = math.floor((price - this.minProfilePrice) / this.priceStepSize)
    math.max(0, math.min(int(raw), FINAL_ROWS - 1))
method getBucketCenterPrice(VolumeProfileEngine this, int bucketIndex) =>
    (bucketIndex + 0.5) * this.priceStepSize + this.minProfilePrice
method storeBatchBars(VolumeProfileEngine this, float[] batchHighs, float[] batchLows, float[] batchVols) =>
    if array.size(batchHighs) > 0
        int currentSize = array.size(this.hPrices)
        int roomLeft = math.max(0, MAX_ARRAY_SIZE - currentSize)
        int barsToStore = math.min(array.size(batchHighs), roomLeft)
        if barsToStore > 0
            for i = 0 to barsToStore - 1
                float h = array.get(batchHighs, i)
                float l = array.get(batchLows, i)
                float v = array.get(batchVols, i)
                if not na(h) and not na(l) and not na(v)
                    array.push(this.hPrices, h)
                    array.push(this.lPrices, l)
                    array.push(this.volumes, v)
                    this.minProfilePrice := na(this.minProfilePrice) ? l : math.min(this.minProfilePrice, l)
                    this.maxProfilePrice := na(this.maxProfilePrice) ? h : math.max(this.maxProfilePrice, h)
method storeSingleBar(VolumeProfileEngine this, float h, float l, float v) =>
    if array.size(this.hPrices) < MAX_ARRAY_SIZE
        array.push(this.hPrices, h)
        array.push(this.lPrices, l)
        array.push(this.volumes, v)
        this.minProfilePrice := na(this.minProfilePrice) ? l : math.min(this.minProfilePrice, l)
        this.maxProfilePrice := na(this.maxProfilePrice) ? h : math.max(this.maxProfilePrice, h)
method createTwoTonePolyline(VolumeProfileEngine this, int[] barPositions, int profileStartBar, float stepSize, float rowHeight,
     color lowerColor, color upperColor) =>
    lowerPts = array.new<chart.point>()
    upperPts = array.new<chart.point>()
    float halfH = rowHeight / 2.0
    float heightGap = math.max(0.0, (stepSize - rowHeight) / 2)
    for [idx, barPos] in barPositions
        if barPos > profileStartBar
            float base = idx * stepSize + this.minProfilePrice + heightGap
            float lowerBottom = base
            float lowerTop    = base + halfH
            float upperBottom = lowerTop
            float upperTop    = base + rowHeight
            array.push(lowerPts, chart.point.from_index(profileStartBar, lowerBottom))
            array.push(lowerPts, chart.point.from_index(barPos,          lowerBottom))
            array.push(lowerPts, chart.point.from_index(barPos,          lowerTop))
            array.push(lowerPts, chart.point.from_index(profileStartBar, lowerTop))
            array.push(upperPts, chart.point.from_index(profileStartBar, upperBottom))
            array.push(upperPts, chart.point.from_index(barPos,          upperBottom))
            array.push(upperPts, chart.point.from_index(barPos,          upperTop))
            array.push(upperPts, chart.point.from_index(profileStartBar, upperTop))
    polyline pLower = na
    polyline pUpper = na
    if array.size(lowerPts) > 1
        pLower := polyline.new(lowerPts, closed=true, line_color=lowerColor, fill_color=lowerColor)
    if array.size(upperPts) > 1
        pUpper := polyline.new(upperPts, closed=true, line_color=upperColor, fill_color=upperColor)
    [pLower, pUpper]
method processAndRender(VolumeProfileEngine this, int profileStartBar, int profileEndBar, bool isActiveProfile, bool renderObjects) =>
    if array.size(this.hPrices) > 0 and profileEndBar > profileStartBar
        float priceRange = math.max(this.maxProfilePrice - this.minProfilePrice, syminfo.mintick)
        float rawStep = priceRange / FINAL_ROWS
        float minStep = syminfo.mintick * finalVpMinTickMult
        int minBuckets = math.max(math.floor(FINAL_ROWS / 3), 20)
        minStep := math.min(minStep, priceRange / minBuckets)
        float boundedStep = math.max(rawStep, minStep)
        boundedStep := math.min(boundedStep, priceRange / 5.0)
        // 桶宽必须是整数tick，避免POC/VA落在不可交易价格。
        int ticksPerRow = math.max(1, int(math.ceil(boundedStep / syminfo.mintick)))
        float stepSize = ticksPerRow * syminfo.mintick
        this.priceStepSize := stepSize
        float[] volumeDistribution = array.new_float(FINAL_ROWS, 0)
        int count = array.size(this.hPrices)
        for i = 0 to count - 1
            float pHigh = array.get(this.hPrices, i)
            float pLow  = array.get(this.lPrices, i)
            float pVol  = array.get(this.volumes, i)
            int startBucket = this.calculatePriceBucket(pLow)
            int endBucket   = this.calculatePriceBucket(pHigh)
            if endBucket < startBucket
                int tmp = startBucket
                startBucket := endBucket
                endBucket := tmp
            float overlapTotal = 0.0
            for bucketIndex = startBucket to endBucket
                float bucketLow = this.minProfilePrice + bucketIndex * this.priceStepSize
                float bucketHigh = bucketLow + this.priceStepSize
                overlapTotal += math.max(0.0, math.min(pHigh, bucketHigh) - math.max(pLow, bucketLow))
            if overlapTotal > 0
                for bucketIndex = startBucket to endBucket
                    float bucketLow = this.minProfilePrice + bucketIndex * this.priceStepSize
                    float bucketHigh = bucketLow + this.priceStepSize
                    float overlap = math.max(0.0, math.min(pHigh, bucketHigh) - math.max(pLow, bucketLow))
                    float allocatedVol = pVol * overlap / overlapTotal
                    array.set(volumeDistribution, bucketIndex, array.get(volumeDistribution, bucketIndex) + allocatedVol)
            else
                int closeBucket = this.calculatePriceBucket(math.avg(pHigh, pLow))
                array.set(volumeDistribution, closeBucket, array.get(volumeDistribution, closeBucket) + pVol)
        float maxVolumeInProfile = array.max(volumeDistribution)
        if maxVolumeInProfile > 0
            int profileBarLength  = profileEndBar - profileStartBar
            int maxHistogramWidth = math.round(profileBarLength * MAX_WIDTH / 100)
            int[] nonVaPositions = array.new_int()
            int[] vaPositions    = array.new_int()
            int pocBucketIndex = maxIndex(volumeDistribution)
            float totalProfileVolume = array.sum(volumeDistribution)
            float valueAreaThresholdVol = totalProfileVolume * VALUE_AREA_THRESHOLD / 100
            float currentValueAreaVolume = array.get(volumeDistribution, pocBucketIndex)
            int valueAreaHighBucket = pocBucketIndex
            int valueAreaLowBucket  = pocBucketIndex
            int loopGuard = 0
            while currentValueAreaVolume < valueAreaThresholdVol and loopGuard < FINAL_ROWS
                loopGuard += 1
                bool canUp = valueAreaHighBucket < FINAL_ROWS - 1
                bool canDn = valueAreaLowBucket > 0
                if not canUp and not canDn
                    break
                float vUp = canUp ? array.get(volumeDistribution, valueAreaHighBucket + 1) : 0
                float vDn = canDn ? array.get(volumeDistribution, valueAreaLowBucket - 1) : 0
                bool chooseUp = vUp >= vDn and canUp
                float candidateVolume = chooseUp ? vUp : vDn
                bool candidateFitsVa = currentValueAreaVolume + candidateVolume <= valueAreaThresholdVol
                if not candidateFitsVa
                    break
                if chooseUp
                    currentValueAreaVolume += vUp
                    valueAreaHighBucket += 1
                else if canDn
                    currentValueAreaVolume += vDn
                    valueAreaLowBucket -= 1
                else
                    break
            float pocPrice = this.getBucketCenterPrice(pocBucketIndex)
            float valueAreaHighPrice = (valueAreaHighBucket + 1) * this.priceStepSize + this.minProfilePrice
            float valueAreaLowPrice  = valueAreaLowBucket * this.priceStepSize + this.minProfilePrice
            this.lastPocPrice := pocPrice
            this.lastVahPrice := valueAreaHighPrice
            this.lastValPrice := valueAreaLowPrice
            bool profileSpanDrawable = (profileEndBar - profileStartBar) <= MAX_DRAW_BARS_BACK
            bool renderProfileObjects = renderObjects and (isActiveProfile or RENDER_COMPLETED_PROFILE) and profileSpanDrawable
            if renderProfileObjects
                // histogram 数组仅渲染时构建（历史K跳过 O(FINAL_ROWS) 分配）
                for [bucketIndex, volumeAmount] in volumeDistribution
                    int barWidth = math.round(volumeAmount / maxVolumeInProfile * maxHistogramWidth)
                    int barEndPosition = profileStartBar + barWidth
                    bool inVA = bucketIndex >= valueAreaLowBucket and bucketIndex <= valueAreaHighBucket
                    array.push(vaPositions,    inVA ? barEndPosition : profileStartBar)
                    array.push(nonVaPositions, inVA ? profileStartBar : barEndPosition)
                float rowHeight = HEIGHT_PERCENTAGE_PER_ROW / 100 * this.priceStepSize
                f_clearVpObjects(this)
                if SHOW_PROFILE_HIST
                    [pl1, pu1] = this.createTwoTonePolyline(nonVaPositions, profileStartBar, this.priceStepSize, rowHeight, PROFILE_COLOR_LOWER, PROFILE_COLOR_UPPER)
                    this.profileHistLower := pl1
                    this.profileHistUpper := pu1
                    [pl2, pu2] = this.createTwoTonePolyline(vaPositions, profileStartBar, this.priceStepSize, rowHeight, VALUE_AREA_COLOR_LOWER, VALUE_AREA_COLOR_UPPER)
                    this.valueAreaHistLower := pl2
                    this.valueAreaHistUpper := pu2
                int OFFSET = 1
                int lineVisualEndX = profileEndBar
                if isActiveProfile and EXTEND_POC
                    lineVisualEndX := bar_index + OFFSET
                int labelX = profileStartBar
                color labelBgColor = color.new(VP_LABEL_BG_COLOR, VP_LABEL_BG_TRANS)
                bool renderVpLeftLabels = not isActiveProfile or SHOW_ACTIVE_VP_LABELS
                if SHOW_POC
                    this.pocLevelLine := line.new(profileStartBar, pocPrice, lineVisualEndX, pocPrice, color=POC_COLOR, width=POC_WIDTH, style=poc_style_str)
                    string txt = "POC"
                    if SHOW_PRICE_LABELS
                        txt += ": " + str.tostring(pocPrice, format.mintick)
                    if renderVpLeftLabels
                        this.pocLevelLabel := label.new(labelX, pocPrice, txt, xloc=xloc.bar_index, yloc=yloc.price,
                              color=labelBgColor, textcolor=POC_COLOR, style=label.style_label_up, textalign=text.align_left, size=VP_LABEL_SIZE)
                if SHOW_VAH_VAL
                    color vahLineCol = SHOW_VAH_VAL_LINES ? VAH_COLOR : color.new(VAH_COLOR, 100)
                    color valLineCol = SHOW_VAH_VAL_LINES ? VAL_COLOR : color.new(VAL_COLOR, 100)
                    this.vahLevelLine := line.new(profileStartBar, valueAreaHighPrice, lineVisualEndX, valueAreaHighPrice, color=vahLineCol, width=VAHVAL_WIDTH, style=vahval_style_str)
                    this.valLevelLine := line.new(profileStartBar, valueAreaLowPrice,  lineVisualEndX, valueAreaLowPrice,  color=valLineCol, width=VAHVAL_WIDTH, style=vahval_style_str)
                    string txtVah = "VAH"
                    string txtVal = "VAL"
                    if SHOW_PRICE_LABELS
                        txtVah += ": " + str.tostring(valueAreaHighPrice, format.mintick)
                        txtVal += ": " + str.tostring(valueAreaLowPrice,  format.mintick)
                    if renderVpLeftLabels
                        this.vahLevelLabel := label.new(labelX, valueAreaHighPrice, txtVah, xloc=xloc.bar_index, yloc=yloc.price,
                              color=labelBgColor, textcolor=VAH_COLOR, style=label.style_label_down, textalign=text.align_left, size=VP_LABEL_SIZE)
                        this.valLevelLabel := label.new(labelX, valueAreaLowPrice,  txtVal, xloc=xloc.bar_index, yloc=yloc.price,
                              color=labelBgColor, textcolor=VAL_COLOR, style=label.style_label_up,    textalign=text.align_left, size=VP_LABEL_SIZE)
                    if SHOW_BACKGROUND and SHOW_VAH_VAL_LINES
                        this.vaFill := linefill.new(this.vahLevelLine, this.valLevelLine, BACKGROUND_COLOR)
getAutoProfileTF() =>
    int sec = timeframe.in_seconds(timeframe.period)
    // 20260810 审计修正：1h以下→D，1h-4h→W，4h-1d→M，1d+→12M（年度分布更充分；S VWAP/CVD 在 1d+ 仍为月锚——12M 仅分布图，与 CVD/VWAP 有意分叉）
    sec < 3600  ? "D" :
     sec < 14400 ? "W" :
     sec < 86400 ? "M" : "12M"
string autoProfileByMarket = marketStock or marketMetal ? "D" : marketForex ? (timeframe.in_seconds(timeframe.period) < 3600 ? "D" : "W") : marketCrypto ? getAutoProfileTF() : getAutoProfileTF()
string targetProfileTF = AUTO_PROFILE_TF ? autoProfileByMarket : MANUAL_PROFILE_TF
getAutoPrecisionTF() =>
    int sec = timeframe.in_seconds(timeframe.period)
    sec <= 900   ? "1"  :
     sec <= 1800 ? "5"  :
     sec <= 3600 ? "10" :
     sec <= 7200 ? "15" :
     sec <= 14400? "30" : "60"
string finalPrecisionTF_raw = AUTO_PRECISION ? getAutoPrecisionTF() : MANUAL_PRECISION_TF
bool safeToUsePrecision_raw = USE_PRECISION and timeframe.in_seconds(finalPrecisionTF_raw) < timeframe.in_seconds(timeframe.period)
int profSec = timeframe.in_seconds(targetProfileTF)
int precSec = timeframe.in_seconds(finalPrecisionTF_raw)
int estBarsInProfile = precSec > 0 ? int(math.round(profSec / precSec)) : 0
int estCost = FINAL_ROWS * estBarsInProfile
bool degrade = AUTO_DEGRADE_PRECISION and safeToUsePrecision_raw and estCost > DEGRADE_THRESHOLD
// calc_bars_count 必须覆盖「完整分布图周期」+「单根图K内 intrabar」两者，否则 SVP POC/VAH/VAL 被截断算错（5m图D分布图需1440根1m）
int svpChartSec = timeframe.in_seconds(timeframe.period)
int svpCalcBars = math.max(1000, math.max(int(math.ceil(profSec / math.max(precSec, 1))), int(math.ceil(svpChartSec / math.max(precSec, 1)))))
string finalPrecisionTF = finalPrecisionTF_raw
bool safeToUsePrecision = safeToUsePrecision_raw and not degrade
var float[] ltfHighs = array.new_float()
var float[] ltfLows  = array.new_float()
var float[] ltfVols  = array.new_float()
var label precisionWarnLabel = na
if safeToUsePrecision
    // 免费档 intrabar 上限100K；按分布图周期动态计算拉取量（5m图D分布图需1440，4h图M需8640），既保完整又防全量拉爆20s时限
    [tmpH, tmpL, tmpV] = request.security_lower_tf(syminfo.tickerid, finalPrecisionTF, [high, low, volume], ignore_invalid_symbol=true, calc_bars_count=svpCalcBars)
    ltfHighs := tmpH
    ltfLows  := tmpL
    ltfVols  := tmpV
else
    array.clear(ltfHighs)
    array.clear(ltfLows)
    array.clear(ltfVols)
type VwapAccumulator
    float sumW = 0.0
    float sumWSrc = 0.0
    float sumWSrcSq = 0.0
method update(VwapAccumulator this, bool reset, float w, float src) =>
    if reset
        this.sumW := 0.0
        this.sumWSrc := 0.0
        this.sumWSrcSq := 0.0
    if na(this.sumW)
        this.sumW := 0.0
    if na(this.sumWSrc)
        this.sumWSrc := 0.0
    if na(this.sumWSrcSq)
        this.sumWSrcSq := 0.0
    float ww = na(w) ? 0.0 : w
    if ww > 0 and not na(src)
        this.sumW += ww
        this.sumWSrc += ww * src
        this.sumWSrcSq += ww * src * src
method getVwap(VwapAccumulator this) =>
    nz(this.sumW, 0.0) > 0 ? nz(this.sumWSrc, 0.0) / nz(this.sumW, 0.0) : na
method getStDev(VwapAccumulator this, float vwapVal) =>
    if nz(this.sumW, 0.0) > 0 and not na(vwapVal)
        float variance = (nz(this.sumWSrcSq, 0.0) / nz(this.sumW, 0.0)) - (vwapVal * vwapVal)
        math.sqrt(math.max(0, variance))
    else
        na
float src_now = hlc3
float w_now   = nz(volume)
bool isNewDayForVwap = ta.change(time("D")) != 0
var VwapAccumulator accDaily = VwapAccumulator.new()
accDaily.update(isNewDayForVwap, w_now, src_now)
float vwapDaily = accDaily.getVwap()
float sdDaily = accDaily.getStDev(vwapDaily)
bool isNewWeek  = ta.change(time("W"))   != 0
bool isNewMonth = ta.change(time("M"))   != 0
var VwapAccumulator accWeekly  = VwapAccumulator.new()
var VwapAccumulator accMonthly = VwapAccumulator.new()
accWeekly.update(isNewWeek,    w_now, src_now)
accMonthly.update(isNewMonth, w_now, src_now)
float vwapWeekly  = accWeekly.getVwap()
float vwapMonthly = accMonthly.getVwap()
int tf_sec = timeframe.in_seconds(timeframe.period)
string autoSvwByMarket = (marketMetal or marketForex or marketStock or marketOption) ? (tf_sec < 14400 ? "D" : "W") : (tf_sec < 3600 ? "D" : tf_sec < 14400 ? "W" : "M")
string sVwapBasis = S_VWAP_ANCHOR == "自动" ? autoSvwByMarket : S_VWAP_ANCHOR == "日" ? "D" : S_VWAP_ANCHOR == "周" ? "W" : "M"
f_cvd_auto_ltf() =>
    int sec = timeframe.in_seconds(timeframe.period)
    sec <= 60 ? (CVD_ALLOW_SECONDS ? "1S" : "1") : sec <= 900 ? "1" : sec <= 3600 ? "5" : sec <= 14400 ? "15" : sec <= 86400 ? "60" : "240"
f_auto_htf() =>
    int sec = timeframe.in_seconds(timeframe.period)
    sec <= 60 ? "15" : sec <= 300 ? "60" : sec <= 900 ? "240" : sec <= 3600 ? "D" : sec <= 14400 ? "W" : "M"
f_htf_fvg() =>
    bool bull = low[1] > high[3]
    bool bear = high[1] < low[3]
    float top = bull ? low[1] : bear ? low[3] : na
    float bot = bull ? high[3] : bear ? high[1] : na
    [bull, bear, top, bot]
f_htf_ob() =>
    float sh = ta.pivothigh(high, OB_LOOKBACK, OB_LOOKBACK)
    float sl = ta.pivotlow(low, OB_LOOKBACK, OB_LOOKBACK)
    var float lsh = na
    var float lsl = na
    if not na(sh)
        lsh := sh
    if not na(sl)
        lsl := sl
    // 只用已收高周期K判结构，避免当前HTF柱内反复改写。
    bool hBreakBull = not na(lsh[1]) and close[1] > lsh[1] and close[2] <= lsh[1]
    bool hBreakBear = not na(lsl[1]) and close[1] < lsl[1] and close[2] >= lsl[1]
    float obTop = na
    float obBot = na
    bool obBull = false
    bool obBear = false
    int off = na
    if hBreakBull or hBreakBear
        for k = 2 to 11
            if hBreakBull and close[k] < open[k]
                off := k
                break
            if hBreakBear and close[k] > open[k]
                off := k
                break
        if not na(off)
            obTop := high[off]
            obBot := low[off]
            obBull := hBreakBull
            obBear := hBreakBear
    [obBull, obBear, obTop, obBot]
f_htf_trend_confirmed_pack() =>
    float eFast = ta.ema(close, EMA_LEN_2)
    float eSlow = ta.ema(close, EMA_LEN_4)
    float v = ta.sma(hlc3, 50)
    [close[1], eFast[1], eSlow[1], v[1]]
f_cvd_delta() =>
    float upVol = close > open ? volume : close < open ? 0.0 : volume * 0.5
    float dnVol = close < open ? volume : close > open ? 0.0 : volume * 0.5
    upVol - dnVol
// 20260810 审计修复（锚定分叉）：CVD 锚定补市场维度，与 S VWAP 同源对齐——
// 非加密(金属/外汇/股票/期权)：4h以下→D，4h+→W；加密：1h以下→D，1h-4h→W，4h+→M。
// 修复前外汇/金属 4h+ 图 CVD=月 vs S VWAP=周，两行动格口径分叉。
string cvdAnchorTf = CVD_ANCHOR_AUTO ? ((marketMetal or marketForex or marketStock or marketOption) ? (tf_sec < 14400 ? "D" : "W") : (tf_sec < 3600 ? "D" : tf_sec < 14400 ? "W" : "M")) : CVD_ANCHOR_MANUAL
string cvdLowerTf = CVD_LTF_AUTO ? f_cvd_auto_ltf() : CVD_LTF_MANUAL
// 20260810 审计修复（P2）：metalSpot 无逐笔数据且 CVD 权重归零，不再拉低周期，省 intrabar 预算
bool cvdUseLowerTf = not metalSpot and timeframe.in_seconds(cvdLowerTf) < timeframe.in_seconds(timeframe.period)
float cvdBarDeltaRaw = f_cvd_delta()
// A1：calc_bars_count 动态化——需覆盖「完整锚定周期」+「背离观察窗」，否则 15m图+1m 等组合下历史 CVD 静默截断偏移（免费档 100K intrabar 预算内；上限 50000：月锚+1m=43240 全覆盖，1S 秒级极端组合仍截断属预期）
int cvdLowerSecA1 = nz(int(timeframe.in_seconds(cvdLowerTf)), 60)
int cvdAnchorSecA1 = nz(int(timeframe.in_seconds(cvdAnchorTf)), 86400)
int cvdCalcBarsA1 = cvdLowerSecA1 > 0 ? math.min(int(math.ceil(cvdAnchorSecA1 / cvdLowerSecA1)) + CVD_DIVERGENCE_LEN + 20, 50000) : 1000
float[] cvdLowerDeltas = cvdUseLowerTf ? request.security_lower_tf(syminfo.tickerid, cvdLowerTf, f_cvd_delta(), ignore_invalid_symbol=true, calc_bars_count=cvdCalcBarsA1) : array.new_float()
float cvdBarDelta = cvdUseLowerTf and array.size(cvdLowerDeltas) > 0 ? array.sum(cvdLowerDeltas) : cvdBarDeltaRaw
int cvdLtfSamples = cvdUseLowerTf ? array.size(cvdLowerDeltas) : 1
int cvdExpectedSamples = cvdUseLowerTf and timeframe.in_seconds(cvdLowerTf) > 0 ? int(math.max(1, math.floor(timeframe.in_seconds(timeframe.period) / timeframe.in_seconds(cvdLowerTf)))) : 1
int cvdRequiredSamples = CVD_ADAPTIVE_MIN_SAMPLES ? math.max(1, math.min(CVD_MIN_SAMPLES, cvdExpectedSamples)) : CVD_MIN_SAMPLES
bool cvdHasVolume = not na(volume) and volume > 0
bool cvdSampleOk = not cvdUseLowerTf or cvdLtfSamples >= cvdRequiredSamples
bool cvdLowSample = cvdUseLowerTf and cvdLtfSamples < cvdRequiredSamples
bool cvdQualityOk = cvdHasVolume and cvdSampleOk
// This is candle-direction volume estimation, not exchange-provided aggressive volume.
string cvdRefTag = SHOW_CVD_CONFIRM ? (cvdLowSample ? "(样本少)" : "") : ""
bool cvdReset = ta.change(time(cvdAnchorTf)) != 0
var float cvdValue = 0.0
cvdValue := cvdReset ? cvdBarDelta : nz(cvdValue[1]) + cvdBarDelta
// —— 现货-永续基差（funding代理）：Pine无funding API，用价差代理资金费率情绪。仅加密永续有效——
string spotTicker = marketCrypto and isPerp ? str.replace(syminfo.tickerid, ".P", "") : ""
float perpSpotBasisPct = na
if SHOW_SPOT_PERP_BASIS and spotTicker != ""
    float spotRefClose = request.security(spotTicker, timeframe.period, close, ignore_invalid_symbol=true)
    if not na(spotRefClose) and spotRefClose > 0
        perpSpotBasisPct := (close - spotRefClose) / spotRefClose * 100
// 20260810 审计修复（P2）：删除死变量 basisEmaRaw/basisEma（定义后无任何消费）
float cvdSlope = cvdValue - nz(cvdValue[CVD_SLOPE_LEN])
bool cvdRising = SHOW_CVD_CONFIRM and cvdSlope > 0
bool cvdFalling = SHOW_CVD_CONFIRM and cvdSlope < 0
bool cvdBullConfirm = SHOW_CVD_CONFIRM and cvdRising and close >= close[CVD_SLOPE_LEN]
bool cvdBearConfirm = SHOW_CVD_CONFIRM and cvdFalling and close <= close[CVD_SLOPE_LEN]
string htfTf = HTF_MODE == "自动" ? f_auto_htf() : HTF_MODE
// 20260808 审计修复（P2）：删除未收线 HTF 请求 f_htf_trend_pack + htfBull/htfBear——
// 全链路只消费 Confirmed 版（lookahead_on + [1] 已收线确认），原请求是死请求且未收线值会 repaint。
[htfCloseC, htfEmaFastC, htfEmaSlowC, htfSma50C] = request.security(syminfo.tickerid, htfTf, f_htf_trend_confirmed_pack(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true)
bool htfBullConfirmed = not na(htfCloseC) and htfCloseC >= htfSma50C and htfEmaFastC >= htfEmaSlowC
bool htfBearConfirmed = not na(htfCloseC) and htfCloseC < htfSma50C and htfEmaFastC < htfEmaSlowC
float sVwap = na
float sVwapSD = na
if sVwapBasis == "D"
    sVwap := vwapDaily
    sVwapSD := sdDaily
else if sVwapBasis == "W"
    sVwap := vwapWeekly
    sVwapSD := accWeekly.getStDev(vwapWeekly)
else
    sVwap := vwapMonthly
    sVwapSD := accMonthly.getStDev(vwapMonthly)
float sVwapUpper1 = sVwap + sVwapSD * VWAP_SD_MULT_1
float sVwapLower1 = sVwap - sVwapSD * VWAP_SD_MULT_1
float currATR = ta.atr(14)
float cvdDivSwingMag = ta.highest(high, CVD_DIVERGENCE_LEN) - ta.lowest(low, CVD_DIVERGENCE_LEN)
bool cvdDivSwingOk = cvdDivSwingMag > 1.5 * currATR
int _pl = CVD_PIVOT_LEN
float _pp = ta.pivothigh(_pl, _pl)
bool _phPair = not na(_pp)
float cvdAtPricePivotHigh = _phPair ? cvdValue[_pl] : na
float _ppp = ta.valuewhen(_phPair, _pp, 1)
float _cpp = ta.valuewhen(_phPair, cvdAtPricePivotHigh, 1)
float _pl2 = ta.pivotlow(_pl, _pl)
bool _plPair = not na(_pl2)
float cvdAtPricePivotLow = _plPair ? cvdValue[_pl] : na
float _plp = ta.valuewhen(_plPair, _pl2, 1)
float _clp = ta.valuewhen(_plPair, cvdAtPricePivotLow, 1)
bool cvdBearDiv = SHOW_CVD_CONFIRM and _phPair and not na(_ppp) and _pp > _ppp and not na(cvdAtPricePivotHigh) and not na(_cpp) and cvdAtPricePivotHigh < _cpp
bool cvdBullDiv = SHOW_CVD_CONFIRM and _plPair and not na(_plp) and _pl2 < _plp and not na(cvdAtPricePivotLow) and not na(_clp) and cvdAtPricePivotLow > _clp
int cvdBearStars = 0
int cvdBullStars = 0
bool cvdDecisionUsableBase = SHOW_CVD_CONFIRM and cvdQualityOk and effCvdWeight > 0
string cvdStateText = not SHOW_CVD_CONFIRM ? "关闭" : cvdBearDiv ? "顶背离" : cvdBullDiv ? "底背离" : cvdBullConfirm ? "顺多确认" : cvdBearConfirm ? "顺空确认" : cvdRising ? "买盘回升" : cvdFalling ? "卖盘回落" : "中性"
float absLow = ta.lowest(low, CVD_ABSORB_LEN)
float cvdAbsPriceRange = ta.highest(high, CVD_ABSORB_LEN) - absLow
float cvdAbsMove = cvdValue - nz(cvdValue[CVD_ABSORB_LEN])
float cvdAbsAvgDelta = ta.sma(math.abs(cvdBarDelta), CVD_ABSORB_LEN)
bool cvdAbsorbBuy = SHOW_CVD_CONFIRM and cvdAbsPriceRange <= currATR * CVD_ABSORB_PRICE_ATR and cvdAbsMove < -cvdAbsAvgDelta * CVD_ABSORB_DELTA_MULT and close >= absLow + cvdAbsPriceRange * 0.45
bool cvdDistributeSell = SHOW_CVD_CONFIRM and cvdAbsPriceRange <= currATR * CVD_ABSORB_PRICE_ATR and cvdAbsMove > cvdAbsAvgDelta * CVD_ABSORB_DELTA_MULT and close <= absLow + cvdAbsPriceRange * 0.55
cvdStateText := cvdDistributeSell ? "上方派发" : cvdAbsorbBuy ? "下方吸收" : cvdStateText
float vwapDistLimit = currATR * VWAP_ATR_MULT
bool showWeeklyVwapEffective = SHOW_WEEKLY_VWAP and (not SMART_HIDE_VWAP or na(vwapWeekly) or math.abs(close - vwapWeekly) <= vwapDistLimit)
bool showMonthlyVwapEffective = SHOW_MONTHLY_VWAP and (not SMART_HIDE_VWAP or na(vwapMonthly) or math.abs(close - vwapMonthly) <= vwapDistLimit)
plot(SHOW_VWAP and showRecentChartLine ? sVwap : na, "S VWAP", color=VWAP_COLOR, linewidth=2)
plot(SHOW_VWAP_BANDS and SHOW_VWAP and showRecentChartLine ? sVwapUpper1 : na, "S VWAP +Band1", color=#4CAF50, linewidth=1, display=display.all)
plot(SHOW_VWAP_BANDS and SHOW_VWAP and showRecentChartLine ? sVwapLower1 : na, "S VWAP -Band1", color=#4CAF50, linewidth=1, display=display.all)
var array<chart.point> ptsWeekly  = array.new<chart.point>()
var array<chart.point> ptsMonthly = array.new<chart.point>()
var polyline plWeekly  = na
var polyline plMonthly = na
int MAX_POLY_POINTS = 3000
if isNewWeek
    array.clear(ptsWeekly)
if not na(vwapWeekly) and showRecentChartLine
    array.push(ptsWeekly, chart.point.from_index(bar_index, vwapWeekly))
    if array.size(ptsWeekly) > MAX_POLY_POINTS
        array.shift(ptsWeekly)
if isNewMonth
    array.clear(ptsMonthly)
if not na(vwapMonthly) and showRecentChartLine
    array.push(ptsMonthly, chart.point.from_index(bar_index, vwapMonthly))
    if array.size(ptsMonthly) > MAX_POLY_POINTS
        array.shift(ptsMonthly)
if barstate.islast
    if not na(plWeekly)
        polyline.delete(plWeekly)
        plWeekly := na
    if not na(plMonthly)
        polyline.delete(plMonthly)
        plMonthly := na
    bool showW = showWeeklyVwapEffective
    bool showM = showMonthlyVwapEffective
    if showW and array.size(ptsWeekly) > 1
        plWeekly := polyline.new(ptsWeekly, curved=false, line_color=WEEKLY_VWAP_COLOR, line_width=2)
    if showM and array.size(ptsMonthly) > 1
        plMonthly := polyline.new(ptsMonthly, curved=false, line_color=MONTHLY_VWAP_COLOR, line_width=2)
do_style_str = DO_STYLE_IN == "Solid" ? line.style_solid : DO_STYLE_IN == "Dotted" ? line.style_dotted : line.style_dashed
var line doLine = na
var float dOpenToday = na
if ta.change(time("D")) != 0
    dOpenToday := open
    if not na(doLine)
        line.delete(doLine)
        doLine := na
    if SHOW_DO_LINE
        doLine := line.new(bar_index, dOpenToday, bar_index + 1, dOpenToday, color=DO_COLOR, width=DO_WIDTH, style=do_style_str)
if na(dOpenToday)
    dOpenToday := open
if SHOW_DO_LINE and na(doLine) and not na(dOpenToday)
    doLine := line.new(bar_index, dOpenToday, bar_index + 1, dOpenToday, color=DO_COLOR, width=DO_WIDTH, style=do_style_str)
if not na(doLine) and SHOW_DO_LINE
    line.set_x2(doLine, bar_index + 1)
    line.set_color(doLine, DO_COLOR)
    line.set_width(doLine, DO_WIDTH)
    line.set_style(doLine, do_style_str)
if not SHOW_DO_LINE and not na(doLine)
    line.delete(doLine)
    doLine := na
float ema1 = ta.ema(close, EMA_LEN_1)
float ema2 = ta.ema(close, EMA_LEN_2)
float ema3 = ta.ema(close, EMA_LEN_3)
float ema4 = ta.ema(close, EMA_LEN_4)
bool emaOrderOk = EMA_LEN_1 < EMA_LEN_2 and EMA_LEN_2 < EMA_LEN_3 and EMA_LEN_3 < EMA_LEN_4
bool showEma12Cloud = SHOW_EMA_FILTER and SHOW_EMA_12_CLOUD
bool showEma34Cloud = SHOW_EMA_FILTER and SHOW_EMA_34_CLOUD
pEma1 = plot(SHOW_EMA_FILTER and showRecentChartLine and SHOW_EMA_12_CLOUD ? ema1 : na, "EMA 9", color=color.new(#00FF6A, 100), linewidth=1, display=display.all - display.price_scale)
pEma2 = plot(SHOW_EMA_FILTER and showRecentChartLine and SHOW_EMA_12_CLOUD ? ema2 : na, "EMA 21", color=color.new(#009688, 100), linewidth=1, display=display.all - display.price_scale)
pEma3 = plot(SHOW_EMA_FILTER and showRecentChartLine and SHOW_EMA_34_CLOUD ? ema3 : na, "EMA 34", color=color.new(#2962FF, 100), linewidth=1, display=display.all - display.price_scale)
pEma4 = plot(SHOW_EMA_FILTER and showRecentChartLine and SHOW_EMA_34_CLOUD ? ema4 : na, "EMA 55", color=color.new(#B71C1C, 100), linewidth=1, display=display.all - display.price_scale)
fill(pEma1, pEma2, color=showEma12Cloud ? (ema1 >= ema2 ? EMA_12_CLOUD_BULL : EMA_12_CLOUD_BEAR) : na, title="EMA 快速趋势云")
fill(pEma3, pEma4, color=showEma34Cloud ? (ema3 >= ema4 ? EMA_34_CLOUD_BULL : EMA_34_CLOUD_BEAR) : na, title="EMA 慢速趋势云")
bool allowAsiaSession = isCrypto or not f_is_weekend(TZ_ASIA)
bool allowLondonSession = isCrypto or not f_is_weekend(TZ_LONDON)
bool allowNYSession = isCrypto or not f_is_weekend(TZ_NY)
bool isAsia   = allowAsiaSession   and not na(time(timeframe.period, TIME_ASIA,   TZ_ASIA))
bool isLondon = allowLondonSession and not na(time(timeframe.period, TIME_LONDON, TZ_LONDON))
bool isNY     = allowNYSession     and not na(time(timeframe.period, TIME_NY,     TZ_NY))
string effKzAsiaTime = MARKET_ADAPTIVE_ENGINE ? (marketCrypto or marketMetal ? "0900-1200" : marketForex ? "0900-1100" : "0900-1200") : KILLZONE_ASIA_TIME
string effKzLondonTime = MARKET_ADAPTIVE_ENGINE ? (marketCrypto or marketMetal ? "0700-0930" : marketForex ? "0700-0900" : "0800-0930") : KILLZONE_LONDON_TIME
string effKzNYTime = MARKET_ADAPTIVE_ENGINE ? (marketCrypto or marketMetal ? "0820-1130" : marketForex ? "0820-1000" : "0930-1030") : KILLZONE_NY_TIME
bool inKillZoneAsia = not na(time(timeframe.period, effKzAsiaTime, TZ_ASIA))
bool inKillZoneLondon = not na(time(timeframe.period, effKzLondonTime, TZ_LONDON))
bool inKillZoneNY = not na(time(timeframe.period, effKzNYTime, TZ_NY))
bool isKillZone = SHOW_KILLZONE and (inKillZoneAsia or inKillZoneLondon or inKillZoneNY)
// KillZone 决策化（2026-08-02）：活跃窗口内且有 A/B/C 计划的信号，confirmScore +1 分。关闭 SHOW_KILLZONE 即移除该加分。
// 20260809 审计删除：会话CVD三通道（亚/伦/纽 Bar→Acc→Slope）全链死代码——Slope 零消费，连同 SHOW_SESSION_CVD 输入与 CVD_SESSION_GROUP 一并移除。
string stdTicker = ticker.standard(syminfo.tickerid)
string stdTickerUpper = str.upper(stdTicker)
f_is_btc_pair(string t) => str.contains(t, "BTCUSDT") or str.contains(t, "BTC/USDT") or str.contains(t, "BTCUSD") or str.contains(t, "XBTUSDT") or str.contains(t, "XBTUSD")
f_is_xau_pair(string t) => str.contains(t, "XAUUSD") or str.contains(t, "XAU/USD") or str.contains(t, "GOLD") or str.contains(t, "COMEX:GC") or str.contains(t, "GC1!")
f_is_gc_futures(string t) => str.contains(t, "COMEX:GC") or str.contains(t, "GC1!")
f_is_eur_pair(string t) => str.contains(t, "EURUSD") or str.contains(t, "EUR/USD")
f_is_gbp_pair(string t) => str.contains(t, "GBPUSD") or str.contains(t, "GBP/USD")
f_is_es_pair(string t) => str.contains(t, "ES1!") or str.contains(t, "SP500") or str.contains(t, "SPX")
string smtTicker = ""
bool smtIsNegative = false
if SHOW_SMT
    string exchPrefix = ""
    if str.contains(syminfo.tickerid, "BINANCE")
        exchPrefix := "BINANCE"
    else if str.contains(syminfo.tickerid, "OKX")
        exchPrefix := "OKX"
    else if str.contains(syminfo.tickerid, "BYBIT")
        exchPrefix := "BYBIT"
    else if str.contains(syminfo.tickerid, "COINBASE")
        exchPrefix := "COINBASE"
    else if str.contains(syminfo.tickerid, "KRAKEN")
        exchPrefix := "KRAKEN"
    string autoEthTicker = exchPrefix != "" ? exchPrefix + ":ETHUSDT" : "BINANCE:ETHUSDT"
    if SMT_PAIR_MODE == "BTC/ETH"
        smtTicker := f_is_btc_pair(stdTickerUpper) ? autoEthTicker : stdTicker
    else if SMT_PAIR_MODE == "BTC/DXY"
        smtTicker := f_is_btc_pair(stdTickerUpper) ? "TVC:DXY" : stdTicker
        smtIsNegative := true
    else if SMT_PAIR_MODE == "XAU/XAG"
        // 期货GC用COMEX:SI1!对照（同所同流动性池），现货XAUUSD用OANDA:XAGUSD
        smtTicker := f_is_xau_pair(stdTickerUpper) ? (f_is_gc_futures(syminfo.tickerid) ? "COMEX:SI1!" : "OANDA:XAGUSD") : stdTicker
    else if SMT_PAIR_MODE == "XAU/DXY"
        smtTicker := f_is_xau_pair(stdTickerUpper) ? "TVC:DXY" : stdTicker
        smtIsNegative := true
    else if SMT_PAIR_MODE == "ES/NQ"
        smtTicker := f_is_es_pair(stdTickerUpper) ? "CME_MINI:NQ1!" : stdTicker
    else if SMT_PAIR_MODE == "EURGBP"
        smtTicker := f_is_eur_pair(stdTickerUpper) ? "OANDA:GBPUSD" : f_is_gbp_pair(stdTickerUpper) ? "OANDA:EURUSD" : stdTicker
    else if SMT_PAIR_MODE == "手动"
        smtTicker := SMT_MANUAL_TICKER
    else
        if marketCrypto and f_is_btc_pair(stdTickerUpper)
            smtTicker := autoEthTicker
        else if marketMetal and f_is_xau_pair(stdTickerUpper)
            smtTicker := f_is_gc_futures(syminfo.tickerid) ? "COMEX:SI1!" : "OANDA:XAGUSD"
        else if marketForex and f_is_eur_pair(stdTickerUpper)
            smtTicker := "OANDA:GBPUSD"
        else if marketForex and f_is_gbp_pair(stdTickerUpper)
            smtTicker := "OANDA:EURUSD"
        else if f_is_es_pair(stdTickerUpper)
            smtTicker := "CME_MINI:NQ1!"
float smtRefClose = SHOW_SMT and smtTicker != "" and smtTicker != stdTicker ? request.security(smtTicker, timeframe.period, close, ignore_invalid_symbol=true) : na

int SMT_SWING_LEN = 10
float smtMySwingHigh = ta.highest(high, SMT_SWING_LEN)
float smtMySwingLow = ta.lowest(low, SMT_SWING_LEN)
float smtRefSwingHigh = ta.highest(smtRefClose, SMT_SWING_LEN)
float smtRefSwingLow = ta.lowest(smtRefClose, SMT_SWING_LEN)
bool smtSwingValid = not na(currATR) and currATR > 0 and (smtMySwingHigh[1] - smtMySwingLow[1]) > 0.3 * currATR
bool smtMyNewHigh = high >= smtMySwingHigh[1] and smtSwingValid
bool smtMyNewLow = low <= smtMySwingLow[1] and smtSwingValid
bool smtBearPos = not smtIsNegative and smtMyNewHigh and smtRefClose < nz(smtRefSwingHigh[1], smtRefClose)
bool smtBearNeg = smtIsNegative and smtMyNewHigh and smtRefClose > nz(smtRefSwingHigh[1], smtRefClose)
bool smtBullPos = not smtIsNegative and smtMyNewLow and smtRefClose > nz(smtRefSwingLow[1], smtRefClose)
bool smtBullNeg = smtIsNegative and smtMyNewLow and smtRefClose < nz(smtRefSwingLow[1], smtRefClose)
bool smtBearDiv = SHOW_SMT and not na(smtRefClose) and (smtBearPos or smtBearNeg) and close > close[3]
bool smtBullDiv = SHOW_SMT and not na(smtRefClose) and (smtBullPos or smtBullNeg) and close < close[3]
int tf_sec_ict = timeframe.in_seconds()
bool isH1OrHigher   = tf_sec_ict >= 3600
bool anySessionAllowed = allowAsiaSession or allowLondonSession or allowNYSession
bool show_ict_boxes = tf_sec_ict < 3600 and anySessionAllowed
bool show_ict_lines = tf_sec_ict < 14400 and anySessionAllowed
bool showAsiaBg = show_ict_boxes and SHOW_ASIA and isAsia
bool showLondonBg = show_ict_boxes and SHOW_LONDON and isLondon
bool showNyBg = show_ict_boxes and SHOW_NY and isNY
bool overlapLondonNy = showLondonBg and showNyBg
bool overlapAsiaLondon = showAsiaBg and showLondonBg and not showNyBg
color ictSessionBg = overlapLondonNy ? color.new(COLOR_LONDON_NY_OVERLAP, ICT_BG_TRANSPARENCY) :
     overlapAsiaLondon ? color.new(COLOR_ASIA_LONDON_OVERLAP, ICT_BG_TRANSPARENCY) :
     showNyBg ? color.new(COLOR_NY, ICT_BG_TRANSPARENCY) :
     showLondonBg ? color.new(COLOR_LONDON, ICT_BG_TRANSPARENCY) :
     showAsiaBg ? color.new(COLOR_ASIA, ICT_BG_TRANSPARENCY) : na
bool show_macro_bg = SHOW_MACRO and tf_sec_ict <= 900
bool inMacroAm = show_macro_bg and not na(time(timeframe.period, MACRO_AM_TIME, TZ_NY))
bgcolor(inMacroAm ? MACRO_COLOR : ictSessionBg)

type ICTLevel
    line ln
    label lb
    float price
    bool isHigh
    bool swept
    int createdAt
    string name
    color col
    bool isActive
    int priority
    bool isHidden
    int sweptBar
var array<ICTLevel> levels = array.new<ICTLevel>()
type SessionState
    line lHigh
    line lLow
    label lbHigh
    label lbLow
    float sOpen = na
    float sHigh = na
    float sLow  = na
    float sClose = na
    int sHighBar = na
    int sLowBar  = na
    int startTime = na
    ICTLevel lvlHighObj
    ICTLevel lvlLowObj
    string dayName = ""
    bool ended = false
var SessionState stAsia   = SessionState.new()
var SessionState stLondon = SessionState.new()
var SessionState stNY     = SessionState.new()
var line prevDayHighLine = na
var line prevDayLowLine = na
var label prevDayHighLabel = na
var label prevDayLowLabel = na
var ICTLevel prevDayHighObj = na
var ICTLevel prevDayLowObj = na
var line prevWeekHighLine = na
var line prevWeekLowLine = na
var label prevWeekHighLabel = na
var label prevWeekLowLabel = na
var ICTLevel prevWeekHighObj = na
var ICTLevel prevWeekLowObj = na
f_delete_ict_level(ICTLevel lvl) =>
    if not na(lvl.ln)
        line.delete(lvl.ln)
    if not na(lvl.lb)
        label.delete(lvl.lb)
updateLabel(label lb, line ln, string name, float price, color col, bool isHigh, bool isSwept) =>
    int startX = line.get_x1(ln)
    int endX   = line.get_x2(ln)
    int midX   = int(math.avg(startX, endX))
    bool isH1 = timeframe.in_seconds() >= 3600
    bool isWeekPool = str.contains(name, "上周")
    bool isDayPool = str.contains(name, " 高") or str.contains(name, " 低")
    string activeSize = isWeekPool ? WEEK_LIQUIDITY_LABEL_SIZE : isDayPool ? DAY_LIQUIDITY_LABEL_SIZE : isH1 ? size.tiny : ICT_UNSWEPT_LABEL_SIZE
    string sweptSize = ICT_SWEPT_LABEL_SIZE
    string sz = isSwept ? sweptSize : activeSize
    string dispName = name
    if isH1
        if str.contains(name, "亚洲盘")
            dispName := str.replace(name, "亚洲盘", "亚")
        else if str.contains(name, "伦敦盘")
            dispName := str.replace(name, "伦敦盘", "伦")
        else if str.contains(name, "纽约盘")
            dispName := str.replace(name, "纽约盘", "纽")
    color txtCol = isSwept ? color.new(col, 40) : col
    label.set_xy(lb, midX, price)
    label.set_text(lb, dispName + ": " + str.tostring(price, format.mintick))
    label.set_size(lb, sz)
    label.set_color(lb, color.new(ICT_LABEL_BG_COLOR, ICT_LABEL_BG_TRANS))
    label.set_textcolor(lb, txtCol)
    label.set_style(lb, isHigh ? label.style_label_down : label.style_label_up)
f_cutoff_ms(int lookbackDays) =>
    int base = time - (lookbackDays * 86400 * 1000)
    if not isCrypto
        int dow = dayofweek(time, DISP_TZ)
        if dow == dayofweek.monday
            base -= 2 * 86400 * 1000
    base
f_day_name_from_time(int ts) =>
    int dow = dayofweek(ts, DISP_TZ)
    switch dow
        1 => "周日"
        2 => "周一"
        3 => "周二"
        4 => "周三"
        5 => "周四"
        6 => "周五"
        7 => "周六"
        => ""
f_remove_level_from_array(ICTLevel target) =>
    if array.size(levels) > 0 and not na(target)
        int i = array.size(levels) - 1
        while i >= 0
            ICTLevel lvl = array.get(levels, i)
            if lvl.ln == target.ln and lvl.name == target.name
                array.remove(levels, i)
                break
            i -= 1
f_delete_liquidity_pair(line hiLine, line loLine, label hiLabel, label loLabel, ICTLevel hiObj, ICTLevel loObj) =>
    f_remove_level_from_array(hiObj)
    f_remove_level_from_array(loObj)
    if not na(hiLine)
        line.delete(hiLine)
    if not na(loLine)
        line.delete(loLine)
    if not na(hiLabel)
        label.delete(hiLabel)
    if not na(loLabel)
        label.delete(loLabel)
f_make_liquidity_level(float price, bool isHigh, string name, color col, int prio, string labelSize, int lineWidth, lineStyle) =>
    line ln = line.new(bar_index, price, bar_index + 1, price, color=col, width=lineWidth, style=lineStyle)
    label lb = label.new(bar_index, price, name, color=color.new(ICT_LABEL_BG_COLOR, ICT_LABEL_BG_TRANS), textcolor=col, style=isHigh ? label.style_label_down : label.style_label_up, size=labelSize)
    ICTLevel obj = ICTLevel.new(ln, lb, price, isHigh, false, time, name, col, false, prio, false, na)
    array.push(levels, obj)
    obj
f_make_liquidity_level_from(float price, bool isHigh, string name, color col, int prio, string labelSize, int lineWidth, lineStyle, int startBar, int createdTime) =>
    int safeStartBar = na(startBar) ? bar_index : math.min(startBar, bar_index)
    int safeCreatedTime = na(createdTime) ? time : createdTime
    line ln = line.new(safeStartBar, price, bar_index + 1, price, color=col, width=lineWidth, style=lineStyle)
    label lb = label.new(bar_index, price, name, color=color.new(ICT_LABEL_BG_COLOR, ICT_LABEL_BG_TRANS), textcolor=col, style=isHigh ? label.style_label_down : label.style_label_up, size=labelSize)
    ICTLevel obj = ICTLevel.new(ln, lb, price, isHigh, false, safeCreatedTime, name, col, false, prio, false, na)
    array.push(levels, obj)
    obj
manageSession(bool isSession, bool showSession, bool allowDraw, color sessionColor, string sessionName, int prio, SessionState st) =>
    int cutoffTime = f_cutoff_ms(ICT_LOOKBACK_DAYS)
    string shortName = sessionName == "亚洲盘" ? "亚" : sessionName == "伦敦盘" ? "伦" : "纽"
    if showSession
        bool justStarted = isSession and not isSession[1]
        if justStarted
            st.ended      := false
            st.sOpen      := open
            st.sHigh      := high
            st.sLow       := low
            st.sClose     := close
            st.sHighBar   := bar_index
            st.sLowBar    := bar_index
            st.startTime := time
            int dow = dayofweek(time, DISP_TZ)
            string dayName = switch dow
                1 => "周日"
                2 => "周一"
                3 => "周二"
                4 => "周三"
                5 => "周四"
                6 => "周五"
                7 => "周六"
                => ""
            st.dayName := dayName
            if allowDraw and st.startTime > cutoffTime
                string displayName = dayName + " " + shortName
                color bgCol = color.new(ICT_LABEL_BG_COLOR, ICT_LABEL_BG_TRANS)
                color initLineColor = SHOW_OPEN_ONLY_ACTIVE ? na : color.new(sessionColor, 0)
                st.lHigh := line.new(st.sHighBar, st.sHigh, bar_index, st.sHigh, color=initLineColor, width=ICT_LINE_WIDTH, style=line.style_dashed)
                st.lbHigh := label.new(bar_index, st.sHigh, displayName + " 高(进行中)", color=bgCol, textcolor=sessionColor, style=label.style_label_down, size=ICT_UNSWEPT_LABEL_SIZE)
                if SHOW_OPEN_ONLY_ACTIVE
                    label.set_text(st.lbHigh, "")
                    label.set_style(st.lbHigh, label.style_none)
                st.lvlHighObj := ICTLevel.new(st.lHigh, st.lbHigh, st.sHigh, true, false, time, displayName + " 高(进行中)", sessionColor, true, prio, false, na)
                array.push(levels, st.lvlHighObj)
                st.lLow := line.new(st.sLowBar, st.sLow, bar_index, st.sLow, color=initLineColor, width=ICT_LINE_WIDTH, style=line.style_dashed)
                st.lbLow := label.new(bar_index, st.sLow, displayName + " 低(进行中)", color=bgCol, textcolor=sessionColor, style=label.style_label_up, size=ICT_UNSWEPT_LABEL_SIZE)
                if SHOW_OPEN_ONLY_ACTIVE
                    label.set_text(st.lbLow, "")
                    label.set_style(st.lbLow, label.style_none)
                st.lvlLowObj := ICTLevel.new(st.lLow, st.lbLow, st.sLow, false, false, time, displayName + " 低(进行中)", sessionColor, true, prio, false, na)
                array.push(levels, st.lvlLowObj)
        if isSession
            st.sClose := close
            if high > st.sHigh
                st.sHigh := high
                st.sHighBar := bar_index
                if allowDraw and not na(st.lHigh)
                    if not na(st.lvlHighObj)
                        st.lvlHighObj.price := st.sHigh
                    line.set_xy1(st.lHigh, st.sHighBar, st.sHigh)
                    line.set_xy2(st.lHigh, bar_index, st.sHigh)
                    label.set_y(st.lbHigh, st.sHigh)
            if low < st.sLow
                st.sLow := low
                st.sLowBar := bar_index
                if allowDraw and not na(st.lLow)
                    if not na(st.lvlLowObj)
                        st.lvlLowObj.price := st.sLow
                    line.set_xy1(st.lLow, st.sLowBar, st.sLow)
                    line.set_xy2(st.lLow, bar_index, st.sLow)
                    label.set_y(st.lbLow, st.sLow)
            if allowDraw and not na(st.lHigh) and not na(st.lLow)
                line.set_x2(st.lHigh, bar_index)
                line.set_x2(st.lLow,  bar_index)
                if not SHOW_OPEN_ONLY_ACTIVE
                    updateLabel(st.lbHigh, st.lHigh, st.lvlHighObj.name, st.sHigh, sessionColor, true,  false)
                    updateLabel(st.lbLow,  st.lLow,  st.lvlLowObj.name,  st.sLow,  sessionColor, false, false)
        if not isSession and isSession[1]
            st.ended := true
            string finalHi = st.dayName + " " + shortName + " 高"
            string finalLo = st.dayName + " " + shortName + " 低"
            if not na(st.lvlHighObj)
                st.lvlHighObj.isActive := false
                st.lvlHighObj.name := finalHi
                if not na(st.lHigh)
                    line.set_style(st.lHigh, line.style_solid)
                if not na(st.lbHigh) and not SHOW_OPEN_ONLY_ACTIVE
                    label.set_text(st.lbHigh, finalHi + ": " + str.tostring(st.sHigh, format.mintick))
            if not na(st.lvlLowObj)
                st.lvlLowObj.isActive := false
                st.lvlLowObj.name := finalLo
                if not na(st.lLow)
                    line.set_style(st.lLow, line.style_solid)
                if not na(st.lbLow) and not SHOW_OPEN_ONLY_ACTIVE
                    label.set_text(st.lbLow, finalLo + ": " + str.tostring(st.sLow, format.mintick))
bool allowDrawIct = SHOW_ICT_LEVELS and show_ict_lines
manageSession(isAsia,   SHOW_ASIA,   allowDrawIct, COLOR_ASIA,   "亚洲盘", 2, stAsia)
manageSession(isLondon, SHOW_LONDON, allowDrawIct, COLOR_LONDON, "伦敦盘", 1, stLondon)
manageSession(isNY,     SHOW_NY,     allowDrawIct, COLOR_NY,     "纽约盘", 3, stNY)
var float curDayHigh = na
var float curDayLow = na
var float prevDayHigh = na
var float prevDayLow = na
var int   prevDayTime = na
var int   curDayStartTime = na
var float curWeekHigh = na
var float curWeekLow = na
var float prevWeekHigh = na
var float prevWeekLow = na
var int   curWeekStartBar = na
var int   curWeekStartTime = na
bool newDayPool = ta.change(time("D")) != 0
bool newWeekPool = ta.change(time("W")) != 0
if na(curWeekStartBar)
    curWeekStartBar := bar_index
    curWeekStartTime := time
if na(curDayStartTime)
    curDayStartTime := time
if newDayPool
    prevDayHigh := curDayHigh
    prevDayLow := curDayLow
    prevDayTime := nz(curDayStartTime, time)
    curDayHigh := high
    curDayLow := low
    curDayStartTime := time
else
    if na(curDayHigh) or high > curDayHigh
        curDayHigh := high
    if na(curDayLow) or low < curDayLow
        curDayLow := low
if newWeekPool
    prevWeekHigh := curWeekHigh
    prevWeekLow := curWeekLow
    curWeekStartBar := bar_index
    curWeekStartTime := time
    curWeekHigh := high
    curWeekLow := low
else
    if na(curWeekHigh) or high > curWeekHigh
        curWeekHigh := high
    if na(curWeekLow) or low < curWeekLow
        curWeekLow := low
bool showDayPool = SHOW_DAY_LIQUIDITY and not na(prevDayHigh) and not na(prevDayLow)
bool showWeekPool = SHOW_WEEK_LIQUIDITY and not na(prevWeekHigh) and not na(prevWeekLow)
bool showPrevWeekHigh = showWeekPool and math.abs(prevWeekHigh - close) <= currATR * WEEK_LIQUIDITY_SHOW_ATR
bool showPrevWeekLow = showWeekPool and math.abs(prevWeekLow - close) <= currATR * WEEK_LIQUIDITY_SHOW_ATR
if showDayPool and newDayPool
    f_delete_liquidity_pair(prevDayHighLine, prevDayLowLine, prevDayHighLabel, prevDayLowLabel, prevDayHighObj, prevDayLowObj)
    string prevDayName = f_day_name_from_time(prevDayTime)
    prevDayHighObj := f_make_liquidity_level(prevDayHigh, true, prevDayName + " 高", COLOR_DAY_LIQUIDITY, 4, DAY_LIQUIDITY_LABEL_SIZE, DAY_LIQUIDITY_WIDTH, day_liquidity_style_str)
    prevDayHighLine := prevDayHighObj.ln
    prevDayHighLabel := prevDayHighObj.lb
    prevDayLowObj := f_make_liquidity_level(prevDayLow, false, prevDayName + " 低", COLOR_DAY_LIQUIDITY, 4, DAY_LIQUIDITY_LABEL_SIZE, DAY_LIQUIDITY_WIDTH, day_liquidity_style_str)
    prevDayLowLine := prevDayLowObj.ln
    prevDayLowLabel := prevDayLowObj.lb
if showWeekPool and (newWeekPool or (showPrevWeekHigh and na(prevWeekHighObj)) or (showPrevWeekLow and na(prevWeekLowObj)))
    if newWeekPool
        f_delete_liquidity_pair(prevWeekHighLine, prevWeekLowLine, prevWeekHighLabel, prevWeekLowLabel, prevWeekHighObj, prevWeekLowObj)
        prevWeekHighObj := na
        prevWeekLowObj := na
        prevWeekHighLine := na
        prevWeekLowLine := na
        prevWeekHighLabel := na
        prevWeekLowLabel := na
    if showPrevWeekHigh and na(prevWeekHighObj)
        prevWeekHighObj := f_make_liquidity_level_from(prevWeekHigh, true, "上周 高", COLOR_WEEK_LIQUIDITY, 5, WEEK_LIQUIDITY_LABEL_SIZE, WEEK_LIQUIDITY_WIDTH, week_liquidity_style_str, curWeekStartBar, curWeekStartTime)
        prevWeekHighLine := prevWeekHighObj.ln
        prevWeekHighLabel := prevWeekHighObj.lb
    if showPrevWeekLow and na(prevWeekLowObj)
        prevWeekLowObj := f_make_liquidity_level_from(prevWeekLow, false, "上周 低", COLOR_WEEK_LIQUIDITY, 5, WEEK_LIQUIDITY_LABEL_SIZE, WEEK_LIQUIDITY_WIDTH, week_liquidity_style_str, curWeekStartBar, curWeekStartTime)
        prevWeekLowLine := prevWeekLowObj.ln
        prevWeekLowLabel := prevWeekLowObj.lb
bool prevWeekHighSwept = false
if not na(prevWeekHighObj)
    prevWeekHighSwept := prevWeekHighObj.swept
bool prevWeekLowSwept = false
if not na(prevWeekLowObj)
    prevWeekLowSwept := prevWeekLowObj.swept
if not showPrevWeekHigh and not na(prevWeekHighObj) and not prevWeekHighSwept
    f_remove_level_from_array(prevWeekHighObj)
    line.delete(prevWeekHighLine)
    label.delete(prevWeekHighLabel)
    prevWeekHighObj := na
    prevWeekHighLine := na
    prevWeekHighLabel := na
if not showPrevWeekLow and not na(prevWeekLowObj) and not prevWeekLowSwept
    f_remove_level_from_array(prevWeekLowObj)
    line.delete(prevWeekLowLine)
    label.delete(prevWeekLowLabel)
    prevWeekLowObj := na
    prevWeekLowLine := na
    prevWeekLowLabel := na
if not showDayPool and (not na(prevDayHighObj) or not na(prevDayLowObj))
    f_delete_liquidity_pair(prevDayHighLine, prevDayLowLine, prevDayHighLabel, prevDayLowLabel, prevDayHighObj, prevDayLowObj)
    prevDayHighObj := na
    prevDayLowObj := na
    prevDayHighLine := na
    prevDayLowLine := na
    prevDayHighLabel := na
    prevDayLowLabel := na
if not showWeekPool and (not na(prevWeekHighObj) or not na(prevWeekLowObj))
    f_delete_liquidity_pair(prevWeekHighLine, prevWeekLowLine, prevWeekHighLabel, prevWeekLowLabel, prevWeekHighObj, prevWeekLowObj)
    prevWeekHighObj := na
    prevWeekLowObj := na
    prevWeekHighLine := na
    prevWeekLowLine := na
    prevWeekHighLabel := na
    prevWeekLowLabel := na
int cur_dow = dayofweek(time, DISP_TZ)
int dynamic_days = ICT_LOOKBACK_DAYS
if cur_dow == 2
    dynamic_days := 3
int max_duration = dynamic_days * 86400 * 1000
if array.size(levels) > 0
    int i = array.size(levels) - 1
    while i >= 0
        ICTLevel lvl = array.get(levels, i)
        int levelMaxDuration = str.contains(lvl.name, "上周") ? WEEK_LIQUIDITY_KEEP_DAYS * 86400 * 1000 : max_duration
        if (time - lvl.createdAt) > levelMaxDuration
            line.delete(lvl.ln)
            label.delete(lvl.lb)
            array.remove(levels, i)
        i -= 1
int sz = array.size(levels)
if sz > 0
    int j = 0
    while j < sz
        ICTLevel lvl = array.get(levels, j)
        if not lvl.isActive
            bool isSwept = false
            if not lvl.swept
                bool wickPierce  = lvl.isHigh ? high > lvl.price : low < lvl.price
                bool gapThroughLine = lvl.isHigh ? (low > lvl.price and high[1] <= lvl.price) : (high < lvl.price and low[1] >= lvl.price)
                bool touchOrGap = wickPierce or gapThroughLine
                bool closeReclaim = lvl.isHigh ? close < lvl.price : close > lvl.price
                isSwept := SWEEP_MARK_MODE == "触碰即扫" ? touchOrGap : SWEEP_MARK_MODE == "收盘即扫" ? (barstate.isconfirmed and touchOrGap) : (barstate.isconfirmed and touchOrGap and closeReclaim)
            if isSwept
                lvl.swept := true
                lvl.sweptBar := bar_index
                bool keepSweptLine = str.contains(lvl.name, "上周")
                if HIDE_SWEEPS_ON_HTF and isH1OrHigher and not keepSweptLine
                    line.delete(lvl.ln)
                    label.delete(lvl.lb)
                    lvl.isHidden := true
                else
                    line.set_color(lvl.ln, color.new(lvl.col, 40))
                    line.set_style(lvl.ln, line.style_dashed)
                    line.set_x2(lvl.ln, bar_index + 1)
                    updateLabel(lvl.lb, lvl.ln, lvl.name, lvl.price, lvl.col, lvl.isHigh, true)
            else if not lvl.swept
                line.set_color(lvl.ln, lvl.col)
                line.set_style(lvl.ln, line.style_solid)
                line.set_x2(lvl.ln, bar_index + 1)
                updateLabel(lvl.lb, lvl.ln, lvl.name, lvl.price, lvl.col, lvl.isHigh, false)
        j += 1
var label[] mergedLabels = array.new_label()
if barstate.islast and SHOW_ICT_LEVELS and show_ict_lines
    if array.size(mergedLabels) > 0
        for l in mergedLabels
            label.delete(l)
        array.clear(mergedLabels)
    if array.size(levels) > 0
        array<ICTLevel> activeLevels = array.new<ICTLevel>()
        for lvl in levels
            if not lvl.swept and not lvl.isHidden and (not lvl.isActive or not SHOW_OPEN_ONLY_ACTIVE)
                label.set_style(lvl.lb, label.style_none)
                label.set_text(lvl.lb, "")
                array.push(activeLevels, lvl)
        int len = array.size(activeLevels)
        if len > 1
            int iSort = 0
            while iSort < len - 1
                int jSort = 0
                while jSort < len - iSort - 1
                    ICTLevel a = array.get(activeLevels, jSort)
                    ICTLevel b = array.get(activeLevels, jSort + 1)
                    bool swap = false
                    float priceDiff = a.price - b.price
                    if b.price > a.price
                        swap := true
                    else if math.abs(priceDiff) < syminfo.mintick
                        if b.priority > a.priority
                            swap := true
                    if swap
                        array.set(activeLevels, jSort, b)
                        array.set(activeLevels, jSort + 1, a)
                    jSort += 1
                iSort += 1
        float mergeThreshold = math.max(syminfo.mintick * 6, math.abs(close) * 0.00012)
        int k = 0
        while k < len
            ICTLevel currentLvl = array.get(activeLevels, k)
            string combinedText = currentLvl.name + ": " + str.tostring(currentLvl.price, format.mintick)
            float sumPrice = currentLvl.price
            int cnt = 1
            color bestColor = currentLvl.col
            int bestPrio  = currentLvl.priority
            int m = k + 1
            while m < len
                ICTLevel nextLvl = array.get(activeLevels, m)
                if math.abs(currentLvl.price - nextLvl.price) < mergeThreshold
                    combinedText += "\n" + nextLvl.name + ": " + str.tostring(nextLvl.price, format.mintick)
                    sumPrice += nextLvl.price
                    cnt += 1
                    if nextLvl.priority > bestPrio
                        bestPrio := nextLvl.priority
                        bestColor := nextLvl.col
                    m += 1
                else
                    break
            float avgPrice = sumPrice / cnt
            int startX = line.get_x1(currentLvl.ln)
            int endX   = line.get_x2(currentLvl.ln)
            int midX   = int(math.avg(startX, endX))
            string style = currentLvl.isHigh ? label.style_label_down : label.style_label_up
            bool isH1 = timeframe.in_seconds() >= 3600
            string mergeSize = ICT_UNSWEPT_LABEL_SIZE
            label newL = label.new(midX, avgPrice, combinedText,
                  color=color.new(ICT_LABEL_BG_COLOR, ICT_LABEL_BG_TRANS), textcolor=bestColor, style=style, size=mergeSize)
            array.push(mergedLabels, newL)
            k := m
if barstate.islast and not SHOW_ICT_LEVELS
    if array.size(mergedLabels) > 0
        for l in mergedLabels
            label.delete(l)
        array.clear(mergedLabels)
    if array.size(levels) > 0
        int i = array.size(levels) - 1
        while i >= 0
            ICTLevel lvl = array.get(levels, i)
            f_delete_ict_level(lvl)
            array.remove(levels, i)
            i -= 1
    stAsia.lHigh := na
    stAsia.lLow := na
    stAsia.lbHigh := na
    stAsia.lbLow := na
    stAsia.lvlHighObj := na
    stAsia.lvlLowObj := na
    stLondon.lHigh := na
    stLondon.lLow := na
    stLondon.lbHigh := na
    stLondon.lbLow := na
    stLondon.lvlHighObj := na
    stLondon.lvlLowObj := na
    stNY.lHigh := na
    stNY.lLow := na
    stNY.lbHigh := na
    stNY.lbLow := na
    stNY.lvlHighObj := na
    stNY.lvlLowObj := na
var VolumeProfileEngine profileEngine = VolumeProfileEngine.new().initialize()
var array<VolumeProfileEngine> completedProfiles = array.new<VolumeProfileEngine>()
var int currentProfileStart = na
if barstate.islast and not RENDER_COMPLETED_PROFILE and array.size(completedProfiles) > 0
    for oldProfile in completedProfiles
        f_clearVpObjects(oldProfile)
        f_clearVpData(oldProfile)
    array.clear(completedProfiles)
bool isNewPeriod = ta.change(time(targetProfileTF)) != 0
if isNewPeriod and not na(profileEngine.minProfilePrice) and not na(currentProfileStart)
    int endBar = bar_index - 1
    if endBar > currentProfileStart
        profileEngine.processAndRender(currentProfileStart, endBar, false, true)
        if SHOW_NPOC and not na(profileEngine.lastPocPrice)
            bool duplicateNpoc = false
            if array.size(npocList) > 0
                int dupI = 0
                while dupI < array.size(npocList)
                    NakedPOC dupNp = array.get(npocList, dupI)
                    if not dupNp.swept and math.abs(dupNp.price - profileEngine.lastPocPrice) <= syminfo.mintick
                        duplicateNpoc := true
                        break
                    dupI += 1
            if not duplicateNpoc
                line npLine = line.new(endBar, profileEngine.lastPocPrice, endBar + 1, profileEngine.lastPocPrice, color=NPOC_COLOR, style=npoc_style_str, width=NPOC_WIDTH)
                int npApproachSide = close >= profileEngine.lastPocPrice ? 1 : -1
                array.push(npocList, NakedPOC.new(npLine, profileEngine.lastPocPrice, endBar, npApproachSide, false, na, false))
        if RENDER_COMPLETED_PROFILE
            f_clearVpData(profileEngine)
            array.push(completedProfiles, profileEngine)
            while array.size(completedProfiles) > COMPLETED_PROFILE_LIMIT
                VolumeProfileEngine oldProfile = array.shift(completedProfiles)
                f_clearVpObjects(oldProfile)
                f_clearVpData(oldProfile)
        else
            f_clearVpObjects(profileEngine)
            f_clearVpData(profileEngine)
    profileEngine := VolumeProfileEngine.new().initialize()
    currentProfileStart := bar_index
if na(currentProfileStart)
    currentProfileStart := bar_index
if barstate.islast
    if not na(precisionWarnLabel)
        label.delete(precisionWarnLabel)
        precisionWarnLabel := na
    bool spanTooLongForDrawing = not na(currentProfileStart) and (bar_index - currentProfileStart) > MAX_DRAW_BARS_BACK
    string warnText = degrade and spanTooLongForDrawing ? "SVP降级+跨度过长 仅保留数值" :
         degrade ? "SVP 已自动降级为图表周期计算" :
         spanTooLongForDrawing ? "SVP 周期跨度过长，仅保留数值/轴标" : ""
    if str.length(warnText) > 0
        precisionWarnLabel := label.new(bar_index + 1, high, warnText, xloc=xloc.bar_index, yloc=yloc.price, color=color.new(color.orange, 85), textcolor=color.orange, style=label.style_label_left, size=size.tiny)
if safeToUsePrecision and array.size(ltfHighs) > 0
    profileEngine.storeBatchBars(ltfHighs, ltfLows, ltfVols)
else
    profileEngine.storeSingleBar(high, low, nz(volume))
if array.size(npocList) > 0
    int i = array.size(npocList) - 1
    while i >= 0
        NakedPOC np = array.get(npocList, i)
        bool npExpired = bar_index - np.createdBar > NPOC_EXPIRE_BARS
        if not SHOW_NPOC or npExpired
            if not np.hidden
                line.delete(np.ln)
            array.remove(npocList, i)
        else
            if not np.swept
                bool npTouch = bar_index > np.createdBar and high >= np.price and low <= np.price
                bool npGap = bar_index > np.createdBar and ((low > np.price and high[1] < np.price) or (high < np.price and low[1] > np.price))
                bool npTouchOrGap = npTouch or npGap
                bool npConfirmedTouch = barstate.isconfirmed and npTouchOrGap
                bool npCloseReclaim = np.approachSide > 0 ? close > np.price : close < np.price
                bool npIsSwept = SWEEP_MARK_MODE == "触碰即扫" ? npTouchOrGap : SWEEP_MARK_MODE == "收盘即扫" ? npConfirmedTouch : npConfirmedTouch and npCloseReclaim
                if npIsSwept
                    np.swept := true
                    np.sweptBar := bar_index
                    if HIDE_SWEEPS_ON_HTF and isH1OrHigher
                        line.delete(np.ln)
                        np.hidden := true
                    else
                        line.set_color(np.ln, color.new(NPOC_COLOR, 40))
                        line.set_style(np.ln, npoc_style_str)
                        line.set_x2(np.ln, bar_index)
                else
                    line.set_color(np.ln, NPOC_COLOR)
                    line.set_style(np.ln, npoc_style_str)
                    line.set_width(np.ln, NPOC_WIDTH)
                    line.set_x2(np.ln, bar_index + 1)
        i -= 1
    while array.size(npocList) > NPOC_LIMIT
        NakedPOC oldNp = array.shift(npocList)
        if not oldNp.hidden
            line.delete(oldNp.ln)
if not na(profileEngine.minProfilePrice) and not na(currentProfileStart)
    // 数值每根K确定性更新；图形对象只在最后一根重绘，保证历史/回放/实时同构。
    profileEngine.processAndRender(currentProfileStart, bar_index, true, barstate.islast)
float dmiUp = ta.change(high)
float dmiDown = -ta.change(low)
float dmiPlusDM = na(dmiUp) ? na : (dmiUp > dmiDown and dmiUp > 0 ? dmiUp : 0)
float dmiMinusDM = na(dmiDown) ? na : (dmiDown > dmiUp and dmiDown > 0 ? dmiDown : 0)
float dmiTrur = ta.rma(ta.tr, effDmiDiLen)
float dmiPlus = fixnan(100 * ta.rma(dmiPlusDM, effDmiDiLen) / dmiTrur)
float dmiMinus = fixnan(100 * ta.rma(dmiMinusDM, effDmiDiLen) / dmiTrur)
float dmiSum = dmiPlus + dmiMinus
float dmiAdx = 100 * ta.rma(math.abs(dmiPlus - dmiMinus) / (dmiSum == 0 ? 1 : dmiSum), effDmiAdxSmooth)
float dmiGap = math.abs(dmiPlus - dmiMinus)
bool dmiAdxRising = dmiAdx > dmiAdx[1]
bool dmiAdxFalling = dmiAdx < dmiAdx[1]
bool dmiBalance = dmiAdx < effDmiAdxTrend or dmiGap <= DMI_DI_NEAR
bool dmiBull = dmiPlus > dmiMinus and not dmiBalance
bool dmiBear = dmiMinus > dmiPlus and not dmiBalance
bool dmiHot = dmiAdx >= effDmiAdxHot
bool dmiBullPath = dmiBull and dmiAdxRising and dmiAdx >= effDmiAdxTrend
bool dmiBearPath = dmiBear and dmiAdxRising and dmiAdx >= effDmiAdxTrend
bool dmiBullAgainst = dmiBear or (dmiMinus > dmiPlus and dmiGap > DMI_DI_NEAR)
bool dmiBearAgainst = dmiBull or (dmiPlus > dmiMinus and dmiGap > DMI_DI_NEAR)
bool dmiBullConfirm = dmiBullPath or (dmiBull and not dmiAdxFalling)
bool dmiBearConfirm = dmiBearPath or (dmiBear and not dmiAdxFalling)
bool dmiTrendWeak = dmiBalance or dmiAdxFalling
float curPoc = profileEngine.lastPocPrice
float curVah = profileEngine.lastVahPrice
float curVal = profileEngine.lastValPrice
float nearestNpocAbove = na
float nearestNpocBelow = na
float nearestNpocForAxis = na
if array.size(npocList) > 0
    int npScan = 0
    while npScan < array.size(npocList)
        NakedPOC np = array.get(npocList, npScan)
        if not np.swept and not np.hidden
            if np.price >= close and (na(nearestNpocAbove) or np.price < nearestNpocAbove)
                nearestNpocAbove := np.price
            if np.price <= close and (na(nearestNpocBelow) or np.price > nearestNpocBelow)
                nearestNpocBelow := np.price
            if na(nearestNpocForAxis) or math.abs(np.price - close) < math.abs(nearestNpocForAxis - close)
                nearestNpocForAxis := np.price
        npScan += 1
bool priceAboveS = not na(sVwap) and close >= sVwap
bool priceBelowS = not na(sVwap) and close < sVwap
bool priceAboveVah = not na(curVah) and close > curVah
bool priceBelowVal = not na(curVal) and close < curVal
bool priceInVA = not na(curVah) and not na(curVal) and close <= curVah and close >= curVal
bool nearPoc = not na(curPoc) and currATR > 0 and math.abs(close - curPoc) <= currATR * 0.20
bool nearS = not na(sVwap) and currATR > 0 and math.abs(close - sVwap) <= currATR * 0.20
bool vwapExtendedUp = not na(sVwap) and currATR > 0 and close > sVwap + currATR * effVwapExtendedAtr
bool vwapExtendedDn = not na(sVwap) and currATR > 0 and close < sVwap - currATR * effVwapExtendedAtr
bool emaFastBull = ema1 >= ema2
bool emaSlowBull = ema3 >= ema4
bool emaBull = SHOW_EMA_FILTER and emaFastBull and emaSlowBull
bool emaBear = SHOW_EMA_FILTER and not emaFastBull and not emaSlowBull
bool trendOkBull = emaBull or not SHOW_EMA_FILTER
bool trendOkBear = emaBear or not SHOW_EMA_FILTER
f_sup_res() =>
    float supP = na
    string supN = "--"
    float resP = na
    string resN = "--"
    if not na(curVal) and curVal <= close
        supP := curVal
        supN := "VAL"
    if not na(curPoc) and curPoc <= close and (na(supP) or close - curPoc < close - supP)
        supP := curPoc
        supN := "POC"
    if not na(sVwap) and sVwap <= close and (na(supP) or close - sVwap < close - supP)
        supP := sVwap
        supN := "VWAP"
    if not na(sVwapLower1) and sVwapLower1 <= close and (na(supP) or close - sVwapLower1 < close - supP)
        supP := sVwapLower1
        supN := "-B1"
    if not na(nearestNpocBelow) and (na(supP) or close - nearestNpocBelow < close - supP)
        supP := nearestNpocBelow
        supN := "nPOC"
    if not na(dOpenToday) and dOpenToday <= close and (na(supP) or close - dOpenToday < close - supP)
        supP := dOpenToday
        supN := "DO"
    if not na(prevDayHigh) and prevDayHigh <= close and (na(supP) or close - prevDayHigh < close - supP)
        supP := prevDayHigh
        supN := f_day_name_from_time(prevDayTime) + "高"
    if not na(prevDayLow) and prevDayLow <= close and (na(supP) or close - prevDayLow < close - supP)
        supP := prevDayLow
        supN := f_day_name_from_time(prevDayTime) + "低"
    if not na(prevWeekHigh) and prevWeekHigh <= close and (na(supP) or close - prevWeekHigh < close - supP)
        supP := prevWeekHigh
        supN := "上周高"
    if not na(prevWeekLow) and prevWeekLow <= close and (na(supP) or close - prevWeekLow < close - supP)
        supP := prevWeekLow
        supN := "上周低"
    if not na(curVah) and curVah >= close
        resP := curVah
        resN := "VAH"
    if not na(curPoc) and curPoc >= close and (na(resP) or curPoc - close < resP - close)
        resP := curPoc
        resN := "POC"
    if not na(sVwap) and sVwap >= close and (na(resP) or sVwap - close < resP - close)
        resP := sVwap
        resN := "VWAP"
    if not na(sVwapUpper1) and sVwapUpper1 >= close and (na(resP) or sVwapUpper1 - close < resP - close)
        resP := sVwapUpper1
        resN := "+B1"
    if not na(nearestNpocAbove) and (na(resP) or nearestNpocAbove - close < resP - close)
        resP := nearestNpocAbove
        resN := "nPOC"
    if not na(dOpenToday) and dOpenToday >= close and (na(resP) or dOpenToday - close < resP - close)
        resP := dOpenToday
        resN := "DO"
    if not na(prevDayHigh) and prevDayHigh >= close and (na(resP) or prevDayHigh - close < resP - close)
        resP := prevDayHigh
        resN := f_day_name_from_time(prevDayTime) + "高"
    if not na(prevDayLow) and prevDayLow >= close and (na(resP) or prevDayLow - close < resP - close)
        resP := prevDayLow
        resN := f_day_name_from_time(prevDayTime) + "低"
    if not na(prevWeekHigh) and prevWeekHigh >= close and (na(resP) or prevWeekHigh - close < resP - close)
        resP := prevWeekHigh
        resN := "上周高"
    if not na(prevWeekLow) and prevWeekLow >= close and (na(resP) or prevWeekLow - close < resP - close)
        resP := prevWeekLow
        resN := "上周低"
    [supP, supN, resP, resN]

[supPrice, supName, resPrice, resName] = f_sup_res()

f_sweep_scan() =>
    int hCount = 0
    int lCount = 0
    float hPrice = na
    float lPrice = na
    string hName = ""
    string lName = ""
    bool hNow = false
    bool lNow = false
    bool hRej = false
    bool lRec = false
    if array.size(levels) > 0
        int evI = 0
        while evI < array.size(levels)
            ICTLevel evLvl = array.get(levels, evI)
            bool newlySwept = not evLvl.isActive and not evLvl.isHidden and evLvl.swept and evLvl.sweptBar == bar_index
            if newlySwept
                string sweepLevelName = evLvl.name
                if evLvl.isHigh
                    hCount += 1
                    if na(hPrice) or math.abs(close - evLvl.price) < math.abs(close - hPrice)
                        hPrice := evLvl.price
                        hName := sweepLevelName
                else
                    lCount += 1
                    if na(lPrice) or math.abs(close - evLvl.price) < math.abs(close - lPrice)
                        lPrice := evLvl.price
                        lName := sweepLevelName
                hNow := hNow or evLvl.isHigh
                lNow := lNow or not evLvl.isHigh
                hRej := hRej or (evLvl.isHigh and close < evLvl.price)
                lRec := lRec or (not evLvl.isHigh and close > evLvl.price)
            evI += 1
    string evName = hCount > 0 and lCount > 0 ? "双向扫" : hCount > 0 ? "扫" + hName : lCount > 0 ? "扫" + lName : "无新扫"
    float evPrice = lCount > 0 and hCount == 0 ? lPrice : hCount > 0 and lCount == 0 ? hPrice : na
    [evName, evPrice, hName, lName, hPrice, lPrice, hCount, lCount, hNow, lNow, hRej, lRec]

[ictEventName, ictEventPrice, sweptHighName, sweptLowName, sweptHighPrice, sweptLowPrice, sweptHighCount, sweptLowCount, sweptHighNow, sweptLowNow, sweptHighRejected, sweptLowReclaimed] = f_sweep_scan()
float volMa = ta.sma(volume, 20)
float relVol = volMa > 0 ? nz(volume) / volMa : na
float barRangeForState = math.max(high - low, syminfo.mintick)
float closePos = (close - low) / barRangeForState
bool volHigh = not na(relVol) and relVol >= 1.5
bool volLow = not na(relVol) and relVol <= 0.7
bool closeNearHigh = closePos >= 0.70
bool closeNearLow = closePos <= 0.30
bool vahRejected = not na(curVah) and high > curVah and close < curVah
bool valReclaimed = not na(curVal) and low < curVal and close > curVal
bool vahAccepted = priceAboveVah and priceAboveS
bool valAccepted = priceBelowVal and priceBelowS
bool pocBalance = priceInVA and (nearPoc or nearS)
bool trendBullAligned = trendOkBull and priceAboveS and (priceAboveVah or not priceBelowVal)
bool trendBearAligned = trendOkBear and priceBelowS and (priceBelowVal or not priceAboveVah)
bool bullStructureRaw = (sweptLowReclaimed and priceAboveS) or vahAccepted or trendBullAligned
bool bearStructureRaw = (sweptHighRejected and priceBelowS) or valAccepted or trendBearAligned
bool structureConflictBase = (priceAboveS and emaBear) or (priceBelowS and emaBull) or (priceAboveVah and volLow) or (priceBelowVal and volLow)
bool structureConflictSweep = (sweptLowReclaimed and priceBelowS) or (sweptHighRejected and priceAboveS)
bool structureConflictDmi = (bullStructureRaw and dmiBullAgainst) or (bearStructureRaw and dmiBearAgainst)
bool valueMigrating = not na(curPoc) and currATR > 0 and math.abs(close - curPoc) > currATR * 0.8 and (priceAboveVah or priceBelowVal) and volHigh and not dmiTrendWeak
float acceptLow = ta.lowest(close, ACCEPT_BARS)
float acceptHigh = ta.highest(close, ACCEPT_BARS)
bool acceptAboveVah = not na(curVah) and acceptLow > curVah
bool acceptBelowVal = not na(curVal) and acceptHigh < curVal
bool acceptAboveS = not na(sVwap) and acceptLow > sVwap
bool acceptBelowS = not na(sVwap) and acceptHigh < sVwap
bool acceptanceBullOk = acceptAboveS and (acceptAboveVah or priceInVA or priceAboveVah)
bool acceptanceBearOk = acceptBelowS and (acceptBelowVal or priceInVA or priceBelowVal)
f_near_level(float level, float atrMult) =>
    not na(level) and currATR > 0 and math.abs(close - level) <= currATR * atrMult
// 20260807 性能：预计算 ATR 距离阈值，避免 13 次重复乘法
float cvdKeyDistA = currATR > 0 ? currATR * effCvdKeyLevelAtr : na
f_near_level_fast(float level) =>
    not na(level) and not na(cvdKeyDistA) and math.abs(close - level) <= cvdKeyDistA
bool nearCvdVp = f_near_level_fast(curVah) or f_near_level_fast(curVal) or f_near_level_fast(curPoc)
bool nearCvdVwap = f_near_level_fast(sVwap) or f_near_level_fast(sVwapUpper1) or f_near_level_fast(sVwapLower1)
bool nearCvdLiquidity = f_near_level_fast(prevDayHigh) or f_near_level_fast(prevDayLow) or f_near_level_fast(prevWeekHigh) or f_near_level_fast(prevWeekLow)
bool nearCvdKeyLevel = nearCvdVp or nearCvdVwap or nearCvdLiquidity or f_near_level_fast(nearestNpocForAxis) or sweptHighNow or sweptLowNow
bool cvdBearDivQualified = cvdDecisionUsableBase and cvdBearDiv and cvdDivSwingOk and cvdSlope < 0 and (not FILTER_CVD_DIVERGENCE_BY_KEY_LEVEL or nearCvdKeyLevel)
bool cvdBullDivQualified = cvdDecisionUsableBase and cvdBullDiv and cvdDivSwingOk and cvdSlope > 0 and (not FILTER_CVD_DIVERGENCE_BY_KEY_LEVEL or nearCvdKeyLevel)
bool cvdAbsorbBuyQualified = cvdDecisionUsableBase and cvdAbsorbBuy and (not REQUIRE_KEY_LEVEL_FOR_CVD_CONFIRM or nearCvdKeyLevel)
bool cvdDistributeSellQualified = cvdDecisionUsableBase and cvdDistributeSell and (not REQUIRE_KEY_LEVEL_FOR_CVD_CONFIRM or nearCvdKeyLevel)
cvdBearStars := cvdBearDivQualified ? (cvdDistributeSellQualified ? 3 : 2) : cvdBearDiv ? 1 : 0
cvdBullStars := cvdBullDivQualified ? (cvdAbsorbBuyQualified ? 3 : 2) : cvdBullDiv ? 1 : 0
bool cvdBullConfirmQualified = cvdDecisionUsableBase and cvdBullConfirm and (not REQUIRE_KEY_LEVEL_FOR_CVD_CONFIRM or nearCvdKeyLevel or acceptanceBullOk)
bool cvdBearConfirmQualified = cvdDecisionUsableBase and cvdBearConfirm and (not REQUIRE_KEY_LEVEL_FOR_CVD_CONFIRM or nearCvdKeyLevel or acceptanceBearOk)
bool cvdDecisionEnabled = cvdDecisionUsableBase and (not REQUIRE_KEY_LEVEL_FOR_CVD_CONFIRM or nearCvdKeyLevel or acceptanceBullOk or acceptanceBearOk)
bool cvdLongDecisionOk = not cvdDecisionEnabled or cvdBullConfirmQualified or cvdBullDivQualified or not cvdFalling
bool cvdShortDecisionOk = not cvdDecisionEnabled or cvdBearConfirmQualified or cvdBearDivQualified or not cvdRising
bool bullValidated = bullStructureRaw and not dmiBullAgainst and not dmiTrendWeak and cvdLongDecisionOk
bool bearValidated = bearStructureRaw and not dmiBearAgainst and not dmiTrendWeak and cvdShortDecisionOk
bool bullTestOnly = bullStructureRaw and not bullValidated
bool bearTestOnly = bearStructureRaw and not bearValidated
bool structureConflictCvd = cvdDecisionUsableBase and ((bullStructureRaw and cvdBearDivQualified) or (bearStructureRaw and cvdBullDivQualified))
bool structureConflict = structureConflictBase or structureConflictSweep or structureConflictDmi or structureConflictCvd
cvdStateText := cvdDistributeSell and not cvdDistributeSellQualified ? "派发弱" : cvdAbsorbBuy and not cvdAbsorbBuyQualified ? "吸收弱" : cvdBearDiv and not cvdBearDivQualified ? "顶背离弱" + (cvdBearStars > 0 ? str.tostring(cvdBearStars) + "★" : "") : cvdBullDiv and not cvdBullDivQualified ? "底背离弱" + (cvdBullStars > 0 ? str.tostring(cvdBullStars) + "★" : "") : cvdStateText
// 20260807 性能：A级关键位距离阈值同样预计算
float aKeyDistA = currATR > 0 ? currATR * effAKeyLevelAtr : na
f_near_level_a(float level) =>
    not na(level) and not na(aKeyDistA) and math.abs(close - level) <= aKeyDistA
bool nearAKeyVp = f_near_level_a(curVah) or f_near_level_a(curVal) or f_near_level_a(curPoc)
bool nearAKeyVwap = f_near_level_a(sVwap) or f_near_level_a(sVwapUpper1) or f_near_level_a(sVwapLower1)
bool nearAKeyLiquidity = f_near_level_a(prevDayHigh) or f_near_level_a(prevDayLow) or f_near_level_a(prevWeekHigh) or f_near_level_a(prevWeekLow)
bool nearAKeyLevel = nearAKeyVp or nearAKeyVwap or nearAKeyLiquidity or f_near_level_a(nearestNpocForAxis) or sweptHighNow or sweptLowNow
bool lowLiquiditySession = DOWNGRADE_LOW_LIQUIDITY and not isCrypto and not (isAsia or isLondon or isNY)
float barDollarVol = (na(volume) ? 0.0 : volume) * hlc3
float estDailyDollarVol = ta.sma(barDollarVol, 20) * (86400.0 / math.max(curTfSec, 1))
bool lowLiquidityAsset = LIQ_GATE_ENABLE and marketCrypto and cvdHasVolume and not na(estDailyDollarVol) and estDailyDollarVol < MIN_DAILY_DVOL_M * 1000000.0
bool sweepOrAcceptLong = sweptLowReclaimed or (acceptAboveS and (acceptAboveVah or priceAboveVah))
bool sweepOrAcceptShort = sweptHighRejected or (acceptBelowS and (acceptBelowVal or priceBelowVal))
float mssLongLevel = not na(resPrice[1]) ? resPrice[1] : not na(curVah[1]) ? curVah[1] : sVwap[1]
float mssShortLevel = not na(supPrice[1]) ? supPrice[1] : not na(curVal[1]) ? curVal[1] : sVwap[1]
int sweepLowAge = ta.barssince(sweptLowReclaimed)
int sweepHighAge = ta.barssince(sweptHighRejected)
bool mssLongOk = not na(sweepLowAge) and sweepLowAge <= ACCEPT_BARS and not na(mssLongLevel) and close > mssLongLevel
bool mssShortOk = not na(sweepHighAge) and sweepHighAge <= ACCEPT_BARS and not na(mssShortLevel) and close < mssShortLevel
bool allowAByLocation = not A_ONLY_NEAR_KEY_LEVEL or nearAKeyLevel
bool allowLongAByCommunity = allowAByLocation and (not REQUIRE_SWEEP_OR_ACCEPT_FOR_A or sweepOrAcceptLong or mssLongOk)
bool allowShortAByCommunity = allowAByLocation and (not REQUIRE_SWEEP_OR_ACCEPT_FOR_A or sweepOrAcceptShort or mssShortOk)
float adrTodayRange = not na(curDayHigh) and not na(curDayLow) ? curDayHigh - curDayLow : na
float adrUsedPct = adrIntraday and not na(adrTodayRange) ? adrTodayRange / adrValue * 100 : na
float adrHighProj = adrIntraday and not na(curDayLow) ? curDayLow + adrValue : na
float adrLowProj  = adrIntraday and not na(curDayHigh) ? curDayHigh - adrValue : na
float adrUpRoomAtr = not na(adrHighProj) and currATR > 0 ? (adrHighProj - close) / currATR : na
float adrDnRoomAtr = not na(adrLowProj) and currATR > 0 ? (close - adrLowProj) / currATR : na
bool adrExhausted = not na(adrUsedPct) and adrUsedPct >= effAdrExhaustPct
bool adrLowRoomLong  = ADR_AS_FILTER and not na(adrUpRoomAtr) and adrUpRoomAtr < ADR_ROOM_ATR
bool adrLowRoomShort = ADR_AS_FILTER and not na(adrDnRoomAtr) and adrDnRoomAtr < ADR_ROOM_ATR
bool adrNearHigh = f_near_level(adrHighProj, 0.5)
bool adrNearLow  = f_near_level(adrLowProj, 0.5)
string pullbackLevelName = not na(supPrice) ? supName : not na(sVwap) ? "VWAP" : "VAH"
float pullbackLevelPrice = not na(supPrice) ? supPrice : not na(sVwap) ? sVwap : curVah
string reboundLevelName = not na(resPrice) ? resName : not na(sVwap) ? "VWAP" : "VAL"
float reboundLevelPrice = not na(resPrice) ? resPrice : not na(sVwap) ? sVwap : curVal
string pullbackLevelText = na(pullbackLevelPrice) ? pullbackLevelName : pullbackLevelName + " " + str.tostring(pullbackLevelPrice, format.mintick)
string reboundLevelText = na(reboundLevelPrice) ? reboundLevelName : reboundLevelName + " " + str.tostring(reboundLevelPrice, format.mintick)
// 20260809 封装函数（缓解 CE10295）：watchText/invalidText 状态机——纯只读全局，输出两值
f_watch_invalid() =>
    string watchText = "等关键位"
    string invalidText = "等确认"
    if sweptLowReclaimed and priceAboveS and bullValidated
        watchText := "看" + pullbackLevelName
        invalidText := "跌回VWAP"
    else if sweptHighRejected and priceBelowS and bearValidated
        watchText := "看" + reboundLevelName
        invalidText := "收回VWAP"
    else if sweptLowReclaimed and priceAboveS and bullTestOnly
        watchText := "等确认"
        invalidText := "跌回VWAP"
    else if sweptHighRejected and priceBelowS and bearTestOnly
        watchText := "等确认"
        invalidText := "收回VWAP"
    else if vahAccepted and trendOkBull and bullValidated
        watchText := "看" + pullbackLevelName
        invalidText := "跌回VA内"
    else if valAccepted and trendOkBear and bearValidated
        watchText := "看" + reboundLevelName
        invalidText := "收回VA内"
    else if vahAccepted and trendOkBull and bullTestOnly
        watchText := "看" + pullbackLevelName
        invalidText := "跌回VA内"
    else if valAccepted and trendOkBear and bearTestOnly
        watchText := "看" + reboundLevelName
        invalidText := "收回VA内"
    else if sweptHighRejected or vahRejected
        watchText := "看" + reboundLevelName
        invalidText := na(ictEventPrice) ? "收回扫高" : "收回" + ictEventName
    else if sweptLowReclaimed or valReclaimed
        watchText := "看" + pullbackLevelName
        invalidText := na(ictEventPrice) ? "跌回扫低" : "跌回" + ictEventName
    else if vwapExtendedUp
        watchText := "看" + pullbackLevelName
        invalidText := "等回踩接受"
    else if vwapExtendedDn
        watchText := "看" + reboundLevelName
        invalidText := "等反抽承压"
    else if valueMigrating
        watchText := "看新VA边"
        invalidText := "回POC旁"
    else if pocBalance
        watchText := "看VAH/VAL"
        invalidText := "破区边"
    else if trendBullAligned and dmiBullConfirm
        watchText := "看" + pullbackLevelName
        invalidText := "破VWAP"
    else if trendBearAligned and dmiBearConfirm
        watchText := "看" + reboundLevelName
        invalidText := "收回VWAP"
    else if structureConflict
        watchText := "等确认"
        invalidText := "等VWAP/VA"
    [watchText, invalidText]
[watchText, invalidText] = f_watch_invalid()
f_fmt_price(float price) =>
    na(price) ? "--" : str.tostring(price, format.mintick)
f_score_setup() =>
    int tL = 0
    int tS = 0
    int rL = 0
    int rS = 0
    tL += priceAboveS ? 2 : 0
    tL += priceAboveVah ? 2 : priceInVA ? 1 : 0
    tL += emaBull ? 2 : 0
    tL += dmiBullConfirm ? 2 : 0
    tL += volHigh and closeNearHigh ? 1 : 0
    tL += AUTO_WEIGHT_BY_MARKET and marketCrypto and volHigh ? 1 : 0
    tL += AUTO_WEIGHT_BY_MARKET and marketStock and volHigh ? 1 : 0
    tL += SHOW_CVD_CONFIRM and cvdBullConfirmQualified ? effCvdWeightInt : 0
    tL -= SHOW_CVD_CONFIRM and cvdBearDivQualified ? effCvdWeightInt : 0
    tS += priceBelowS ? 2 : 0
    tS += priceBelowVal ? 2 : priceInVA ? 1 : 0
    tS += emaBear ? 2 : 0
    tS += dmiBearConfirm ? 2 : 0
    tS += volHigh and closeNearLow ? 1 : 0
    tS += AUTO_WEIGHT_BY_MARKET and marketCrypto and volHigh ? 1 : 0
    tS += AUTO_WEIGHT_BY_MARKET and marketStock and volHigh ? 1 : 0
    tS += SHOW_CVD_CONFIRM and cvdBearConfirmQualified ? effCvdWeightInt : 0
    tS -= SHOW_CVD_CONFIRM and cvdBullDivQualified ? effCvdWeightInt : 0
    rL += sweptLowReclaimed ? 3 : 0
    rL += valReclaimed ? 2 : 0
    rL += vwapExtendedDn ? 2 : 0
    rL += dmiHot ? 1 : 0
    rL += volHigh and not closeNearLow ? 1 : 0
    rL += AUTO_WEIGHT_BY_MARKET and (marketMetal or marketForex) and sweptLowReclaimed ? 1 : 0
    rL += mssLongOk ? 1 : 0
    rL += SHOW_CVD_CONFIRM and cvdBullDivQualified ? effCvdWeightInt : 0
    rL += SHOW_CVD_CONFIRM and cvdAbsorbBuyQualified ? effCvdWeightInt : 0
    rL += SHOW_SMT and smtBullDiv and (nearAKeyLevel or sweptLowNow) ? 1 : 0
    rL += ADR_AS_REVERSAL and adrExhausted and (adrNearLow or (not na(adrLowProj) and close <= adrLowProj)) ? 1 : 0
    rS += sweptHighRejected ? 3 : 0
    rS += vahRejected ? 2 : 0
    rS += vwapExtendedUp ? 2 : 0
    rS += dmiHot ? 1 : 0
    rS += volHigh and not closeNearHigh ? 1 : 0
    rS += AUTO_WEIGHT_BY_MARKET and (marketMetal or marketForex) and sweptHighRejected ? 1 : 0
    rS += mssShortOk ? 1 : 0
    rS += SHOW_CVD_CONFIRM and cvdBearDivQualified ? effCvdWeightInt : 0
    rS += SHOW_CVD_CONFIRM and cvdDistributeSellQualified ? effCvdWeightInt : 0
    rS += SHOW_SMT and smtBearDiv and (nearAKeyLevel or sweptHighNow) ? 1 : 0
    rS += ADR_AS_REVERSAL and adrExhausted and (adrNearHigh or (not na(adrHighProj) and close >= adrHighProj)) ? 1 : 0
    [math.min(math.max(tL, 0), 10), math.min(math.max(tS, 0), 10), math.min(math.max(rL, 0), 10), math.min(math.max(rS, 0), 10)]

[trendLongScore, trendShortScore, reversalLongScore, reversalShortScore] = f_score_setup()
string longBreakName = not na(resPrice) ? resName : not na(curVah) ? "VAH" : not na(sVwap) ? "VWAP" : "前高"
float longBreakPrice = not na(resPrice) ? resPrice : not na(curVah) ? curVah : sVwap
string shortBreakName = not na(supPrice) ? supName : not na(curVal) ? "VAL" : not na(sVwap) ? "VWAP" : "前低"
float shortBreakPrice = not na(supPrice) ? supPrice : not na(curVal) ? curVal : sVwap
float longPlanPrice = priceAboveS ? pullbackLevelPrice : longBreakPrice
float shortPlanPrice = priceBelowS ? reboundLevelPrice : shortBreakPrice
bool htfAllowLong = not USE_HTF_FILTER or not htfBearConfirmed
bool htfAllowShort = not USE_HTF_FILTER or not htfBullConfirmed
bool cvdHardGateMarket = USE_CVD_HARD_GATE and cvdDecisionEnabled
bool cvdLongAOk = cvdHardGateMarket ? cvdBullConfirmQualified : cvdLongDecisionOk
bool cvdShortAOk = cvdHardGateMarket ? cvdBearConfirmQualified : cvdShortDecisionOk
float dispBody = math.abs(close - open)
float dispRange = math.max(high - low, syminfo.mintick)
float volSma20 = ta.sma(volume, 20)
bool dispVolOk = not DISP_REQUIRE_VOL or (not na(volume) and volume > volSma20)
bool dispUpBar = close > open and dispBody > DISP_ATR_MULT * currATR and dispBody > dispRange * 0.5 and dispVolOk
bool dispDnBar = open > close and dispBody > DISP_ATR_MULT * currATR and dispBody > dispRange * 0.5 and dispVolOk
int barsSinceDispUp = ta.barssince(dispUpBar)
int barsSinceDispDn = ta.barssince(dispDnBar)
bool dispLongOk = not REQUIRE_DISPLACEMENT_FOR_A or (not na(barsSinceDispUp) and barsSinceDispUp <= DISP_LOOKBACK)
bool dispShortOk = not REQUIRE_DISPLACEMENT_FOR_A or (not na(barsSinceDispDn) and barsSinceDispDn <= DISP_LOOKBACK)
f_zone_grade(float score) => score >= 75 ? "A" : score >= 55 ? "B" : "C"
f_score_clamp(float score) => math.min(math.max(score, 0.0), 100.0)
f_set_zone_box_text(box bx, string txt, color txtCol, string txtSize) =>
    if not na(bx)
        box.set_text(bx, txt)
        box.set_text_color(bx, txtCol)
        box.set_text_size(bx, txtSize)
        box.set_text_halign(bx, text.align_right)
        box.set_text_valign(bx, text.align_bottom)
type FVG
    box   bx
    line  ce
    label lb
    float top
    float bot
    bool  isBull
    bool  htfConf
    int   bornBar
    float baseScore
    float qualityScore
    int   touchCount
    bool  wasInside
string fvgHtfRaw = FVG_HTF == "自动" ? htfTf : FVG_HTF
bool fvgHtfValid = ((SHOW_HTF_FVG and SHOW_FVG) or (SHOW_HTF_OB and SHOW_OB)) and timeframe.in_seconds(fvgHtfRaw) > curTfSec
string fvgHtfRes = fvgHtfValid ? fvgHtfRaw : timeframe.period
// HTF zones are published only after the source HTF candle closes.
[hBull, hBear, hTop, hBot] = request.security(syminfo.tickerid, fvgHtfRes, f_htf_fvg(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[obHBull, obHBear, obHTop, obHBot] = request.security(syminfo.tickerid, fvgHtfRes, f_htf_ob(), lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
var array<FVG> htfFvgList = array.new<FVG>()
bool newHtfBull = fvgHtfValid and SHOW_HTF_FVG and SHOW_FVG and barstate.isconfirmed and hBull and not na(hTop) and not na(hBot) and (not hBull[1] or hTop != hTop[1])
bool newHtfBear = fvgHtfValid and SHOW_HTF_FVG and SHOW_FVG and barstate.isconfirmed and hBear and not na(hTop) and not na(hBot) and (not hBear[1] or hBot != hBot[1])
if newHtfBull
    array.push(htfFvgList, FVG.new(na, na, na, hTop, hBot, true, false, bar_index, 0.0, 0.0, 0, false))
if newHtfBear
    array.push(htfFvgList, FVG.new(na, na, na, hTop, hBot, false, false, bar_index, 0.0, 0.0, 0, false))
if array.size(htfFvgList) > 0
    int hzi = array.size(htfFvgList) - 1
    while hzi >= 0
        FVG hz0 = array.get(htfFvgList, hzi)
        bool hzFilled = hz0.isBull ? close < hz0.bot : close > hz0.top
        if hzFilled or not fvgHtfValid
            array.remove(htfFvgList, hzi)
        hzi -= 1
    while array.size(htfFvgList) > 4
        array.shift(htfFvgList)
type OBZone
    box   bx
    label lb
    float top
    float bot
    bool  isBull
    bool  isBreaker
    bool  mitigated
    bool  htfConf
    int   breakerBar
    int   bornBar
    float baseScore
    float qualityScore
    int   touchCount
    bool  wasInside
var array<OBZone> htfObList = array.new<OBZone>()
bool newHtfObBull = fvgHtfValid and SHOW_HTF_OB and SHOW_OB and barstate.isconfirmed and obHBull and not na(obHTop) and not na(obHBot) and (not obHBull[1] or obHTop != obHTop[1])
bool newHtfObBear = fvgHtfValid and SHOW_HTF_OB and SHOW_OB and barstate.isconfirmed and obHBear and not na(obHTop) and not na(obHBot) and (not obHBear[1] or obHBot != obHBot[1])
if newHtfObBull
    array.push(htfObList, OBZone.new(na, na, obHTop, obHBot, true, false, false, true, na, bar_index, 0.0, 0.0, 0, false))
if newHtfObBear
    array.push(htfObList, OBZone.new(na, na, obHTop, obHBot, false, false, false, true, na, bar_index, 0.0, 0.0, 0, false))
if array.size(htfObList) > 0
    int hoi = array.size(htfObList) - 1
    while hoi >= 0
        OBZone hz = array.get(htfObList, hoi)
        bool hzFilled = hz.isBull ? close < hz.bot : close > hz.top
        if hzFilled or not fvgHtfValid
            array.remove(htfObList, hoi)
        hoi -= 1
    while array.size(htfObList) > 4
        array.shift(htfObList)
var array<FVG> fvgList = array.new<FVG>()
bool fvgBullGate = not FVG_HTF_ALIGN or not htfBearConfirmed
bool fvgBearGate = not FVG_HTF_ALIGN or not htfBullConfirmed
bool newBullFvg = SHOW_FVG and barstate.isconfirmed and low > high[2] and (not FVG_REQUIRE_DISP or dispUpBar[1]) and fvgBullGate
bool newBearFvg = SHOW_FVG and barstate.isconfirmed and high < low[2] and (not FVG_REQUIRE_DISP or dispDnBar[1]) and fvgBearGate
if newBullFvg
    float t = low
    float b = high[2]
    float gapAtr = math.abs(t - b) / math.max(nz(currATR, syminfo.mintick), syminfo.mintick)
    float dispAtr = math.abs(close[1] - open[1]) / math.max(nz(currATR[1], syminfo.mintick), syminfo.mintick)
    float rvol = na(volSma20[1]) or volSma20[1] <= 0 ? 1.0 : nz(volume[1], volSma20[1]) / volSma20[1]
    float baseScore = f_score_clamp(math.min(dispAtr / 2.0, 1.0) * 25 + math.min(gapAtr / 0.5, 1.0) * 20 + math.min(rvol / 2.0, 1.0) * 15 + (ema1 >= ema2 ? 10 : 0) + 15)
    box  nb = FVG_DRAW_BOXES ? box.new(bar_index - 2, t, bar_index + FVG_EXTEND, b, border_color=color.new(FVG_BULL_COL, 40), border_width=1, bgcolor=color.new(FVG_BULL_COL, FVG_FILL_TRANSP)) : na
    line nc = FVG_DRAW_BOXES and FVG_SHOW_CE ? line.new(bar_index - 2, (t + b) / 2, bar_index + FVG_EXTEND, (t + b) / 2, color=color.new(FVG_BULL_COL, 20), style=line.style_dotted, width=1) : na
    label nlb = na
    f_set_zone_box_text(nb, SHOW_ZONE_LABELS and SHOW_FVG_LABELS ? "FVG↑ " + f_zone_grade(baseScore) : "", FVG_BULL_COL, ZONE_LABEL_SIZE)
    array.push(fvgList, FVG.new(nb, nc, nlb, t, b, true, false, bar_index, baseScore, baseScore, 0, false))
if newBearFvg
    float t = low[2]
    float b = high
    float gapAtr = math.abs(t - b) / math.max(nz(currATR, syminfo.mintick), syminfo.mintick)
    float dispAtr = math.abs(close[1] - open[1]) / math.max(nz(currATR[1], syminfo.mintick), syminfo.mintick)
    float rvol = na(volSma20[1]) or volSma20[1] <= 0 ? 1.0 : nz(volume[1], volSma20[1]) / volSma20[1]
    float baseScore = f_score_clamp(math.min(dispAtr / 2.0, 1.0) * 25 + math.min(gapAtr / 0.5, 1.0) * 20 + math.min(rvol / 2.0, 1.0) * 15 + (ema1 <= ema2 ? 10 : 0) + 15)
    box  nb = FVG_DRAW_BOXES ? box.new(bar_index - 2, t, bar_index + FVG_EXTEND, b, border_color=color.new(FVG_BEAR_COL, 40), border_width=1, bgcolor=color.new(FVG_BEAR_COL, FVG_FILL_TRANSP)) : na
    line nc = FVG_DRAW_BOXES and FVG_SHOW_CE ? line.new(bar_index - 2, (t + b) / 2, bar_index + FVG_EXTEND, (t + b) / 2, color=color.new(FVG_BEAR_COL, 20), style=line.style_dotted, width=1) : na
    label nlb = na
    f_set_zone_box_text(nb, SHOW_ZONE_LABELS and SHOW_FVG_LABELS ? "FVG↓ " + f_zone_grade(baseScore) : "", FVG_BEAR_COL, ZONE_LABEL_SIZE)
    array.push(fvgList, FVG.new(nb, nc, nlb, t, b, false, false, bar_index, baseScore, baseScore, 0, false))
bool inBullFvg = false
bool inBearFvg = false
bool inBullFvgHtf = false
bool inBearFvgHtf = false
float inBullFvgScore = 0.0
float inBearFvgScore = 0.0
float bullFvgCe = na
float bearFvgCe = na
float fvgNearDist = FVG_NEAR_ATR * (na(currATR) ? 0.0 : currATR)
float nearestBullFvgDist = na
float nearestBearFvgDist = na
float mcpBullFvgCe = na
float mcpBearFvgCe = na
float mcpBullFvgDist = na
float mcpBearFvgDist = na
float mcpBullFvgScore = 0.0
float mcpBearFvgScore = 0.0
bool mcpBullFvgHtf = false
bool mcpBearFvgHtf = false
if SHOW_FVG and FVG_NEAREST_ONLY and array.size(fvgList) > 0
    int nf = array.size(fvgList) - 1
    while nf >= 0
        FVG f0 = array.get(fvgList, nf)
        bool f0Filled = f0.isBull ? low <= f0.bot : high >= f0.top
        bool f0Expired = FVG_EXPIRE_BARS > 0 and bar_index - f0.bornBar > FVG_EXPIRE_BARS
        if not f0Filled and not f0Expired
            float d0 = f0.isBull ? math.max(0.0, close - f0.top) : math.max(0.0, f0.bot - close)
            if f0.isBull
                nearestBullFvgDist := na(nearestBullFvgDist) ? d0 : math.min(nearestBullFvgDist, d0)
            else
                nearestBearFvgDist := na(nearestBearFvgDist) ? d0 : math.min(nearestBearFvgDist, d0)
        nf -= 1
if SHOW_FVG and array.size(fvgList) > 0
    int fi = array.size(fvgList) - 1
    while fi >= 0
        FVG f = array.get(fvgList, fi)
        bool filled = f.isBull ? low <= f.bot : high >= f.top
        bool expired = FVG_EXPIRE_BARS > 0 and bar_index - f.bornBar > FVG_EXPIRE_BARS
        if filled or expired
            if not na(f.bx)
                box.delete(f.bx)
            if not na(f.ce)
                line.delete(f.ce)
            if not na(f.lb)
                label.delete(f.lb)
            array.remove(fvgList, fi)
        else
            bool htfConf = false
            if fvgHtfValid and array.size(htfFvgList) > 0
                int gj = 0
                while gj < array.size(htfFvgList)
                    FVG hz = array.get(htfFvgList, gj)
                    if hz.isBull == f.isBull and f.top >= hz.bot and f.bot <= hz.top
                        htfConf := true
                        break
                    gj += 1
            f.htfConf := htfConf
            bool insideNow = close <= f.top and close >= f.bot
            if insideNow and not f.wasInside
                f.touchCount += 1
            f.wasInside := insideNow
            float zoneHeight = math.max(math.abs(f.top - f.bot), syminfo.mintick)
            float penetration = f.isBull ? (low < f.top ? math.min(math.max((f.top - low) / zoneHeight, 0.0), 1.0) : 0.0) : (high > f.bot ? math.min(math.max((high - f.bot) / zoneHeight, 0.0), 1.0) : 0.0)
            int fvgLife = FVG_EXPIRE_BARS > 0 ? FVG_EXPIRE_BARS : 200
            float agePenalty = math.min(15.0, (bar_index - f.bornBar) * 15.0 / math.max(fvgLife, 1))
            f.qualityScore := f_score_clamp(f.baseScore + (htfConf ? 15 : 0) - f.touchCount * 6 - penetration * 20 - agePenalty)
            float distToFvgMcp = f.isBull ? math.max(0.0, close - f.top) : math.max(0.0, f.bot - close)
            float ceToFvgMcp = math.avg(f.top, f.bot)
            if f.isBull
                if f.qualityScore > mcpBullFvgScore or (f.qualityScore == mcpBullFvgScore and (na(mcpBullFvgDist) or distToFvgMcp < mcpBullFvgDist))
                    mcpBullFvgScore := f.qualityScore
                    mcpBullFvgDist := distToFvgMcp
                    mcpBullFvgCe := ceToFvgMcp
                    mcpBullFvgHtf := htfConf
            else
                if f.qualityScore > mcpBearFvgScore or (f.qualityScore == mcpBearFvgScore and (na(mcpBearFvgDist) or distToFvgMcp < mcpBearFvgDist))
                    mcpBearFvgScore := f.qualityScore
                    mcpBearFvgDist := distToFvgMcp
                    mcpBearFvgCe := ceToFvgMcp
                    mcpBearFvgHtf := htfConf
            if f.isBull and insideNow
                inBullFvg := true
                if f.qualityScore > inBullFvgScore
                    inBullFvgHtf := htfConf
                    inBullFvgScore := f.qualityScore
                    bullFvgCe := math.avg(f.top, f.bot)
            if not f.isBull and insideNow
                inBearFvg := true
                if f.qualityScore > inBearFvgScore
                    inBearFvgHtf := htfConf
                    inBearFvgScore := f.qualityScore
                    bearFvgCe := math.avg(f.top, f.bot)
            if not na(f.bx)
                float distToGap = f.isBull ? math.max(0.0, close - f.top) : math.max(0.0, f.bot - close)
                bool nearPrice = fvgNearDist <= 0.0 or distToGap <= fvgNearDist
                bool nearestOk = not FVG_NEAREST_ONLY or (f.isBull ? (not na(nearestBullFvgDist) and distToGap <= nearestBullFvgDist + syminfo.mintick) : (not na(nearestBearFvgDist) and distToGap <= nearestBearFvgDist + syminfo.mintick))
                color baseCol = f.isBull ? FVG_BULL_COL : FVG_BEAR_COL
                int fvgRight = bar_index + FVG_EXTEND
                box.set_right(f.bx, fvgRight)
                box.set_bgcolor(f.bx, nearPrice and nearestOk ? color.new(baseCol, FVG_FILL_TRANSP) : na)
                box.set_border_color(f.bx, nearPrice and nearestOk ? color.new(baseCol, 40) : na)
                box.set_border_width(f.bx, 1)
                f_set_zone_box_text(f.bx, SHOW_ZONE_LABELS and SHOW_FVG_LABELS and nearPrice and nearestOk ? (f.isBull ? "FVG↑ " : "FVG↓ ") + f_zone_grade(f.qualityScore) + (f.htfConf ? " HTF" : "") : "", nearPrice and nearestOk ? baseCol : color.new(baseCol, 100), ZONE_LABEL_SIZE)
                if not na(f.ce)
                    line.set_x2(f.ce, fvgRight)
                    line.set_color(f.ce, nearPrice and nearestOk ? color.new(baseCol, 20) : na)

        fi -= 1
    while array.size(fvgList) > FVG_MAX_COUNT
        int weakestIdx = 0
        float weakestScore = array.get(fvgList, 0).qualityScore
        for qi = 1 to array.size(fvgList) - 1
            FVG qf = array.get(fvgList, qi)
            if qf.qualityScore < weakestScore
                weakestScore := qf.qualityScore
                weakestIdx := qi
        FVG oldf = array.remove(fvgList, weakestIdx)
        if not na(oldf.bx)
            box.delete(oldf.bx)
        if not na(oldf.ce)
            line.delete(oldf.ce)
        if not na(oldf.lb)
            label.delete(oldf.lb)
var array<OBZone> obList = array.new<OBZone>()
float swHigh = ta.pivothigh(high, OB_LOOKBACK, OB_LOOKBACK)
float swLow = ta.pivotlow(low, OB_LOOKBACK, OB_LOOKBACK)
var float lastSwingHigh = na
var float lastSwingLow = na
if not na(swHigh)
    lastSwingHigh := swHigh
if not na(swLow)
    lastSwingLow := swLow
bool breakBull = ENABLE_STRUCTURE_ENGINE and barstate.isconfirmed and not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bool breakBear = ENABLE_STRUCTURE_ENGINE and barstate.isconfirmed and not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
var int structureBias = 0
bool chochBull = breakBull and structureBias == -1
bool chochBear = breakBear and structureBias == 1
bool bosBull = breakBull and not chochBull
bool bosBear = breakBear and not chochBear
if breakBull
    structureBias := 1
else if breakBear
    structureBias := -1
string bosChochText = not SHOW_BOS_CHOCH_TEXT ? "" : chochBull ? "CHoCH↑" : chochBear ? "CHoCH↓" : bosBull ? "BOS↑" : bosBear ? "BOS↓" : ""
bool obBullDetected = SHOW_OB and breakBull
bool obBearDetected = SHOW_OB and breakBear
if obBullDetected
    int obOffset = na
    for k = 1 to 10
        if close[k] < open[k]
            obOffset := k
            break
    if not na(obOffset)
        float obTop = high[obOffset]
        float obBot = low[obOffset]
